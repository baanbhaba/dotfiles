#!/usr/bin/env bash

export PATH="$HOME/.local/bin:$PATH"

selected=$(cliphist list | rofi -dmenu -i -p "📋 Clipboard" -lines 7 -theme ~/.config/rofi/config.rasi)

if [[ -n "$selected" ]]; then
    echo "$selected" | cliphist decode | wl-copy
    command -v notify-send >/dev/null 2>&1 && notify-send -t 1500 "Clipboard" "Copied to clipboard!"
fi
