#!/usr/bin/env python3
"""
flac-daemon - Lightweight Background Daemon for FLAC Queue & Auto-Play Management
Monitors playback state, triggers auto-play when a track ends, and sends desktop notifications.
"""

import os
import sys
import time
import json
import glob
import fcntl
import subprocess
from typing import Optional

PID_FILE = "/tmp/flac_daemon.pid"
STATE_FILE = os.path.expanduser("~/.cache/flac_player/queue.json")
MUSIC_DIR = os.path.expanduser("~/Music/flac")

def is_already_running() -> bool:
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            return True
        except (OSError, ValueError):
            pass
    return False

def write_pid():
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

def get_track_cover(track_path: Optional[str]) -> str:
    if track_path and os.path.exists(track_path):
        cover = os.path.join(os.path.dirname(track_path), "cover.jpg")
        if os.path.exists(cover):
            return cover
    return "audio-speakers"

def notify_track_change(title: str, artist: str, album: str, track_path: Optional[str]):
    cover = get_track_cover(track_path)
    body = f"{artist} · {album}" if artist else album
    subprocess.run([
        "notify-send", f"󰎆 {title}", body,
        "-i", cover, "-t", "3500", "-a", "FLAC Player"
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def find_track_path_from_metadata(title: str, album: str) -> Optional[str]:
    norm_t = "".join(c.lower() for c in title if c.isalnum())
    norm_a = "".join(c.lower() for c in album if c.isalnum())
    for flac in glob.glob(os.path.join(MUSIC_DIR, "*/*.flac")):
        alb = os.path.basename(os.path.dirname(flac))
        fname = os.path.splitext(os.path.basename(flac))[0]
        if norm_a and norm_a in "".join(c.lower() for c in alb if c.isalnum()):
            if norm_t in "".join(c.lower() for c in fname if c.isalnum()):
                return flac
    return None

def main():
    if is_already_running():
        # Already running
        sys.exit(0)

    write_pid()

    last_title = ""
    last_status = ""
    consecutive_stopped_count = 0

    while True:
        try:
            cmd = [
                "playerctl", "-p", "com.github.neithern.g4music", "metadata",
                "--format", "{{status}}\t{{title}}\t{{artist}}\t{{album}}\t{{position}}\t{{mpris:length}}"
            ]
            res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=1.0)
            if res.returncode == 0 and res.stdout.strip():
                parts = res.stdout.strip().split("\t")
                if len(parts) >= 4:
                    status, title, artist, album = parts[0].strip(), parts[1].strip(), parts[2].strip(), parts[3].strip()
                    pos_str = parts[4].strip() if len(parts) > 4 else "0"
                    len_str = parts[5].strip() if len(parts) > 5 else "0"

                    pos = float(pos_str) / 1000000.0 if pos_str.isdigit() and len(pos_str) > 7 else float(pos_str or 0)
                    length = float(len_str) / 1000000.0 if len_str.isdigit() and len(len_str) > 7 else float(len_str or 0)

                    # 1. Track change detected
                    if title and title != last_title:
                        last_title = title
                        path = find_track_path_from_metadata(title, album)
                        notify_track_change(title, artist, album, path)

                    # 2. Track ended or stopped near end
                    # If position is within 0.8s of length, or status abruptly becomes Paused/Stopped after being playing
                    if status == "Playing":
                        last_status = "Playing"
                        consecutive_stopped_count = 0
                        if length > 5.0 and (length - pos) <= 0.6:
                            # Trigger next track right at boundary
                            time.sleep(0.6)
                            subprocess.run([os.path.expanduser("~/.local/bin/flac-queue"), "next"],
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                            time.sleep(1.0)
                    elif status in ("Stopped", "Paused"):
                        if last_status == "Playing":
                            consecutive_stopped_count += 1
                            if consecutive_stopped_count >= 2:
                                # Track stopped playing, pop next track from queue if queue has tracks
                                if os.path.exists(STATE_FILE):
                                    try:
                                        with open(STATE_FILE, "r") as f:
                                            s = json.load(f)
                                            if s.get("queue"):
                                                subprocess.run([os.path.expanduser("~/.local/bin/flac-queue"), "next"],
                                                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                                time.sleep(1.0)
                                    except Exception:
                                        pass
                                last_status = status
            else:
                consecutive_stopped_count = 0
        except Exception:
            pass

        time.sleep(0.5)

if __name__ == "__main__":
    main()
