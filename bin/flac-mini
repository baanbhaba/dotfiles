#!/usr/bin/env python3
"""
flac-mini - Sleek Floating Micro-Player Widget
Compact, responsive terminal mini-player with live progress bar and hotkey controls.
"""

import os
import sys
import time
import curses
import subprocess
from typing import Optional, Dict

THEME_FILE = os.path.expanduser("~/.config/hypr/.theme_current")
QUEUE_BIN = os.path.expanduser("~/.local/bin/flac-queue")
FAV_BIN = os.path.expanduser("~/.local/bin/flac-fav")

THEME_PALETTES = {
    "darkbrutalism": {"accent": curses.COLOR_YELLOW, "secondary": curses.COLOR_CYAN, "name": "DARK BRUTALISM"},
    "neobrutalism":  {"accent": curses.COLOR_MAGENTA, "secondary": curses.COLOR_CYAN, "name": "NEOBRUTALISM"},
    "charcoal":      {"accent": curses.COLOR_YELLOW, "secondary": curses.COLOR_WHITE, "name": "CHARCOAL"},
    "jaipur":        {"accent": curses.COLOR_RED, "secondary": curses.COLOR_YELLOW, "name": "JAIPUR"},
    "colorblock":    {"accent": curses.COLOR_GREEN, "secondary": curses.COLOR_MAGENTA, "name": "COLOR BLOCK"},
    "sketchbook":    {"accent": curses.COLOR_WHITE, "secondary": curses.COLOR_CYAN, "name": "SKETCHBOOK"},
    "retroboy":      {"accent": curses.COLOR_GREEN, "secondary": curses.COLOR_WHITE, "name": "RETROBOY DMG"}
}

def get_current_theme_name() -> str:
    if os.path.exists(THEME_FILE):
        try:
            with open(THEME_FILE, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "darkbrutalism"

def query_playerctl() -> Optional[Dict]:
    cmd = [
        "playerctl",
        "-p", "com.github.neithern.g4music",
        "metadata",
        "--format",
        '{{status}}\t{{title}}\t{{artist}}\t{{album}}\t{{position}}\t{{mpris:length}}\t{{volume}}'
    ]
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=0.8)
        if res.returncode == 0 and res.stdout.strip():
            parts = res.stdout.strip().split("\t")
            if len(parts) >= 4:
                status, title, artist, album = parts[0].strip(), parts[1].strip(), parts[2].strip(), parts[3].strip()
                pos_str = parts[4].strip() if len(parts) > 4 else "0"
                len_str = parts[5].strip() if len(parts) > 5 else "0"
                vol_str = parts[6].strip() if len(parts) > 6 else "1.0"

                pos = float(pos_str) / 1000000.0 if pos_str.isdigit() and len(pos_str) > 7 else float(pos_str or 0)
                length = float(len_str) / 1000000.0 if len_str.isdigit() and len(len_str) > 7 else float(len_str or 0)
                vol = float(vol_str) if vol_str else 1.0

                return {
                    "status": status,
                    "title": title,
                    "artist": artist,
                    "album": album,
                    "position": pos,
                    "length": length,
                    "volume": vol
                }
    except Exception:
        pass
    return None

def format_time(seconds: float) -> str:
    m = int(seconds // 60)
    s = int(seconds % 60)
    return f"{m:02d}:{s:02d}"

def curses_main(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(50)
    curses.start_color()
    curses.use_default_colors()

    theme_name = get_current_theme_name()
    pal = THEME_PALETTES.get(theme_name, THEME_PALETTES["darkbrutalism"])

    curses.init_pair(1, pal["accent"], -1)
    curses.init_pair(2, pal["secondary"], -1)
    curses.init_pair(3, curses.COLOR_WHITE, -1)

    cached_info = None
    last_poll = 0.0

    while True:
        now = time.time()
        if now - last_poll > 0.25 or cached_info is None:
            cached_info = query_playerctl()
            last_poll = now

        key = stdscr.getch()
        if key in (ord('q'), ord('Q'), 27):
            break
        elif key == ord(' '):
            subprocess.run(["playerctl", "-p", "com.github.neithern.g4music", "play-pause"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif key in (ord('n'), ord('N')):
            subprocess.run([QUEUE_BIN, "next"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif key in (ord('p'), ord('P')):
            subprocess.run([QUEUE_BIN, "prev"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif key in (curses.KEY_LEFT, ord('h')):
            subprocess.run(["playerctl", "-p", "com.github.neithern.g4music", "position", "5-"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif key in (curses.KEY_RIGHT, ord('l')):
            subprocess.run(["playerctl", "-p", "com.github.neithern.g4music", "position", "5+"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif key in (curses.KEY_UP, ord('k'), ord('+')):
            subprocess.run(["playerctl", "-p", "com.github.neithern.g4music", "volume", "0.05+"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif key in (curses.KEY_DOWN, ord('j'), ord('-')):
            subprocess.run(["playerctl", "-p", "com.github.neithern.g4music", "volume", "0.05-"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif key in (ord('f'), ord('F')):
            subprocess.run([FAV_BIN, "toggle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        stdscr.erase()
        h, w = stdscr.getmaxyx()

        title = cached_info["title"] if cached_info and cached_info.get("title") else "No Track Playing"
        artist = cached_info["artist"] if cached_info and cached_info.get("artist") else "Unknown Artist"
        album = cached_info["album"] if cached_info and cached_info.get("album") else ""
        status = cached_info["status"] if cached_info else "Stopped"
        pos = cached_info["position"] if cached_info else 0.0
        length = cached_info["length"] if cached_info and cached_info["length"] > 0 else 180.0

        status_icon = "▶" if status.lower() == "playing" else "⏸"
        line1 = f" {status_icon} {title}"
        if len(line1) > w - 4:
            line1 = line1[:w - 7] + "..."
        stdscr.addstr(1, 2, line1, curses.color_pair(1) | curses.A_BOLD)

        line2 = f" 🎤 {artist}  ·  💿 {album}" if album else f" 🎤 {artist}"
        if len(line2) > w - 4:
            line2 = line2[:w - 7] + "..."
        stdscr.addstr(2, 2, line2, curses.color_pair(2))

        # Progress bar
        ratio = min(1.0, max(0.0, pos / length)) if length > 0 else 0.0
        bar_len = max(10, w - 22)
        filled = int(bar_len * ratio)
        empty = bar_len - filled
        bar = "━" * filled + "●" + "─" * max(0, empty - 1)
        time_line = f" {format_time(pos)} {bar} {format_time(length)}"
        stdscr.addstr(4, 2, time_line[:w - 4], curses.color_pair(3))

        # Controls hint
        controls = " [Space] Play  [←/→] Seek  [↑/↓] Vol  [f] Fav  [q] Hide "
        stdscr.addstr(h - 1, max(2, (w - len(controls)) // 2), controls[:w - 4], curses.color_pair(1) | curses.A_REVERSE)

        stdscr.refresh()

def main():
    try:
        curses.wrapper(curses_main)
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()
