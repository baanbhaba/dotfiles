#!/usr/bin/env bash

# ==============================================================================
# Script:      Git Master Backup (Universal CLI + TUI)
# Description: Multi-drive Git repository synchronization & auto-backup engine.
# Author:      baanbhaba
# ==============================================================================

set -uo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# COLOR CODES & STYLING
# ─────────────────────────────────────────────────────────────────────────────
GREEN='\033[38;2;80;250;123m'
YELLOW='\033[38;2;241;250;140m'
RED='\033[38;2;255;85;85m'
BLUE='\033[38;2;98;114;164m'
CYAN='\033[38;2;0;229;255m'
MAGENTA='\033[38;2;255;121;198m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

CONFIG_DIR="$HOME/.config/git-master-backup"
CONFIG_FILE="$CONFIG_DIR/config.json"

# ─────────────────────────────────────────────────────────────────────────────
# PYTHON CONFIG HELPER
# ─────────────────────────────────────────────────────────────────────────────
py_exec() {
    python3 -c "$1" 2>/dev/null
}

init_config() {
    mkdir -p "$CONFIG_DIR"
    python3 << 'EOF'
import os, json, glob
from pathlib import Path

config_dir = Path.home() / ".config" / "git-master-backup"
config_file = config_dir / "config.json"
user = os.environ.get("USER", os.getlogin() if hasattr(os, "getlogin") else "user")
home = str(Path.home())

default_cfg = {
    "scan_directories": [home],
    "exclude_patterns": [
        "*/.cache/*",
        "*/.local/share/*",
        "*/.gemini/*",
        "*/.cargo/*",
        "*/.rustup/*",
        "*/.npm/*",
        "*/.mozilla/*",
        "*/node_modules/*",
        "*/.electron/*",
        "*/.Trash*/*"
    ],
    "protocol": "both",
    "dry_run": False,
    "auto_detect_drives": True,
    "commit_prefix": "Auto-backup"
}

# Auto-detect mounted media drives
for pattern in [f"/run/media/{user}/*", f"/media/{user}/*", "/mnt/*"]:
    for d in glob.glob(pattern):
        if os.path.isdir(d) and os.access(d, os.R_OK) and d not in default_cfg["scan_directories"] and d != "/":
            default_cfg["scan_directories"].append(str(Path(d).resolve()))

if config_file.exists():
    try:
        with open(config_file, "r") as f:
            saved = json.load(f)
            default_cfg.update(saved)
    except Exception:
        pass

with open(config_file, "w") as f:
    json.dump(default_cfg, f, indent=4)
EOF
}

[ ! -f "$CONFIG_FILE" ] && init_config

# Helper functions to read config values
get_config_dirs() {
    python3 -c '
import json, sys
from pathlib import Path
try:
    with open(Path.home() / ".config/git-master-backup/config.json") as f:
        cfg = json.load(f)
        for d in cfg.get("scan_directories", []):
            print(d)
except Exception:
    pass
'
}

get_config_excludes() {
    python3 -c '
import json, sys
from pathlib import Path
try:
    with open(Path.home() / ".config/git-master-backup/config.json") as f:
        cfg = json.load(f)
        for e in cfg.get("exclude_patterns", []):
            print(e)
except Exception:
    pass
'
}

get_config_val() {
    local key="$1"
    local default="$2"
    python3 -c "
import json
from pathlib import Path
try:
    with open(Path.home() / '.config/git-master-backup/config.json') as f:
        cfg = json.load(f)
        print(cfg.get('$key', '$default'))
except Exception:
    print('$default')
"
}

save_config_val() {
    local key="$1"
    local val="$2"
    python3 -c "
import json
from pathlib import Path
p = Path.home() / '.config/git-master-backup/config.json'
try:
    with open(p, 'r') as f:
        cfg = json.load(f)
except Exception:
    cfg = {}
cfg['$key'] = '$val'
with open(p, 'w') as f:
    json.dump(cfg, f, indent=4)
"
}

# ─────────────────────────────────────────────────────────────────────────────
# ARGUMENT PARSING
# ─────────────────────────────────────────────────────────────────────────────
NON_INTERACTIVE=0
DRY_RUN=0
PROTOCOL_OVERRIDE=""
CLI_DIRS=()

show_help() {
    echo -e "${CYAN}${BOLD}Git Master Backup (Universal Rice Edition)${NC}"
    echo "Usage: git-master-backup [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -g, --gui                Launch the PyQt5 GUI Dashboard"
    echo "  -y, --yes, --non-interactive"
    echo "                           Run backup immediately without interactive menu"
    echo "  -n, --dry-run            Scan and check changes without committing or pushing"
    echo "  -p, --protocol [MODE]    Filter remote protocol: 'ssh', 'https', or 'both'"
    echo "  -d, --dirs 'PATH,...'    Specify custom comma-separated list of directories to scan"
    echo "  -m, --manage             Open interactive folder & drive manager"
    echo "  -h, --help               Display this help message"
    echo ""
    echo "Configuration is stored at: ~/.config/git-master-backup/config.json"
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -g|--gui)
            if command -v git-master-backup-gui &>/dev/null; then
                exec git-master-backup-gui
            elif [ -f "$HOME/.local/bin/git-master-backup-gui" ]; then
                exec "$HOME/.local/bin/git-master-backup-gui"
            else
                echo -e "${RED}Error: git-master-backup-gui not found in PATH or ~/.local/bin.${NC}"
                exit 1
            fi
            ;;
        -y|--yes|--non-interactive)
            NON_INTERACTIVE=1
            shift
            ;;
        -n|--dry-run)
            DRY_RUN=1
            shift
            ;;
        -p|--protocol)
            PROTOCOL_OVERRIDE="$2"
            shift 2
            ;;
        -d|--dirs)
            IFS=',' read -ra CLI_DIRS <<< "$2"
            shift 2
            ;;
        -m|--manage)
            MANAGE_ONLY=1
            shift
            ;;
        -h|--help)
            show_help
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            show_help
            ;;
    esac
done

# ─────────────────────────────────────────────────────────────────────────────
# INTERACTIVE FOLDER & DRIVE MANAGER
# ─────────────────────────────────────────────────────────────────────────────
manage_sources() {
    while true; do
        clear
        echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║         📁 MANAGE WATCHED DIRECTORIES & DRIVES           ║${NC}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════╝${NC}\n"

        mapfile -t current_dirs < <(get_config_dirs)
        echo -e "${BOLD}Currently Watched Locations:${NC}"
        if [ ${#current_dirs[@]} -eq 0 ]; then
            echo -e "   ${DIM}(None configured)${NC}"
        else
            for i in "${!current_dirs[@]}"; do
                d="${current_dirs[$i]}"
                if [ "$d" = "$HOME" ]; then
                    label="🏠 User Home ($d)"
                elif [[ "$d" =~ ^/run/media|^/media|^/mnt ]]; then
                    label="💾 External Drive ($d)"
                else
                    label="📁 $d"
                fi
                echo -e "   ${CYAN}[$((i+1))]${NC} $label"
            done
        fi

        echo ""
        echo -e "${BOLD}Detected External Storage Devices:${NC}"
        user="${USER:-$(id -un)}"
        detected_drives=()
        for pat in "/run/media/$user/*" "/media/$user/*" "/mnt/*"; do
            for p in $pat; do
                if [ -d "$p" ] && [ -r "$p" ] && [ "$p" != "/mnt/*" ] && [ "$p" != "/run/media/$user/*" ] && [ "$p" != "/media/$user/*" ]; then
                    resolved=$(realpath "$p" 2>/dev/null || echo "$p")
                    detected_drives+=("$resolved")
                fi
            done
        done

        if [ ${#detected_drives[@]} -eq 0 ]; then
            echo -e "   ${DIM}(No unlisted external drives detected)${NC}"
        else
            for i in "${!detected_drives[@]}"; do
                dd="${detected_drives[$i]}"
                already=" "
                for cd in "${current_dirs[@]}"; do
                    [ "$cd" = "$dd" ] && already="${GREEN}✓ Added${NC}"
                done
                echo -e "   ${YELLOW}*${NC} $dd  $already"
            done
        fi

        echo ""
        echo -e "${BOLD}Actions:${NC}"
        echo "  [a] Add custom folder path"
        echo "  [d] Auto-add all detected external drives"
        echo "  [r] Remove a watched location"
        echo "  [b] Back to main menu"
        echo ""
        read -r -p "Choose action [a/d/r/b]: " act

        case "$act" in
            a|A)
                echo ""
                read -r -e -p "Enter full path to folder: " new_dir
                new_dir="${new_dir/#\~/$HOME}"
                if [ -d "$new_dir" ]; then
                    python3 -c "
import json
from pathlib import Path
p = Path.home() / '.config/git-master-backup/config.json'
with open(p, 'r') as f: cfg = json.load(f)
dirs = cfg.get('scan_directories', [])
if '$new_dir' not in dirs: dirs.append('$new_dir')
cfg['scan_directories'] = dirs
with open(p, 'w') as f: json.dump(cfg, f, indent=4)
"
                    echo -e "${GREEN}✓ Added: $new_dir${NC}"
                else
                    echo -e "${RED}Directory does not exist: $new_dir${NC}"
                fi
                sleep 1
                ;;
            d|D)
                for dd in "${detected_drives[@]}"; do
                    python3 -c "
import json
from pathlib import Path
p = Path.home() / '.config/git-master-backup/config.json'
with open(p, 'r') as f: cfg = json.load(f)
dirs = cfg.get('scan_directories', [])
if '$dd' not in dirs: dirs.append('$dd')
cfg['scan_directories'] = dirs
with open(p, 'w') as f: json.dump(cfg, f, indent=4)
"
                done
                echo -e "${GREEN}✓ Synced external drives to watchlist.${NC}"
                sleep 1
                ;;
            r|R)
                read -r -p "Enter number to remove: " num
                idx=$((num-1))
                if [ "$idx" -ge 0 ] && [ "$idx" -lt "${#current_dirs[@]}" ]; then
                    rm_dir="${current_dirs[$idx]}"
                    python3 -c "
import json
from pathlib import Path
p = Path.home() / '.config/git-master-backup/config.json'
with open(p, 'r') as f: cfg = json.load(f)
dirs = cfg.get('scan_directories', [])
if '$rm_dir' in dirs: dirs.remove('$rm_dir')
cfg['scan_directories'] = dirs
with open(p, 'w') as f: json.dump(cfg, f, indent=4)
"
                    echo -e "${YELLOW}Removed: $rm_dir${NC}"
                else
                    echo -e "${RED}Invalid index.${NC}"
                fi
                sleep 1
                ;;
            b|B|"")
                break
                ;;
        esac
    done
}

# ─────────────────────────────────────────────────────────────────────────────
# INTERACTIVE DASHBOARD MENU
# ─────────────────────────────────────────────────────────────────────────────
if [ $NON_INTERACTIVE -eq 0 ] && [ -z "${MANAGE_ONLY:-}" ] && [ $DRY_RUN -eq 0 ] && [ ${#CLI_DIRS[@]} -eq 0 ]; then
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║                   🚀 GIT MASTER BACKUP                   ║${NC}"
    echo -e "${CYAN}║     Universal Multi-Drive Repository Synchronization     ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════╝${NC}\n"

    # Display status
    mapfile -t current_dirs < <(get_config_dirs)
    saved_proto=$(get_config_val "protocol" "both")

    echo -e "${BOLD}Current Configuration:${NC}"
    echo -e "  ${CYAN}🌐 Protocol :${NC} ${saved_proto^^}"
    echo -e "  ${CYAN}📁 Watched  :${NC} ${#current_dirs[@]} locations configured"
    for d in "${current_dirs[@]}"; do
        echo -e "      ${DIM}• $d${NC}"
    done
    echo ""

    echo -e "${BOLD}Select Action:${NC}"
    echo "  [1] 🚀 Start Backup Now"
    echo "  [2] 🔍 Run Dry-Run (Preview only)"
    echo "  [3] 📁 Manage Watched Folders & Drives"
    echo "  [4] 🌐 Set Protocol Filter (Both / SSH / HTTPS)"
    echo "  [5] 🖥️ Launch GUI Dashboard"
    echo "  [6] ❌ Exit"
    echo ""
    read -r -p "Enter selection [1-6] (Default 1): " choice

    case "${choice:-1}" in
        1)
            # Run normal backup
            ;;
        2)
            DRY_RUN=1
            ;;
        3)
            manage_sources
            ;;
        4)
            echo ""
            echo "1) SSH only (git@*)"
            echo "2) HTTPS only (https://*)"
            echo "3) Both SSH + HTTPS"
            read -r -p "Protocol choice [1-3]: " pchoice
            case "$pchoice" in
                1) save_config_val "protocol" "ssh" ;;
                2) save_config_val "protocol" "https" ;;
                *) save_config_val "protocol" "both" ;;
            esac
            echo -e "${GREEN}Protocol preference updated.${NC}"
            ;;
        5)
            if command -v git-master-backup-gui &>/dev/null; then
                exec git-master-backup-gui
            elif [ -f "$HOME/.local/bin/git-master-backup-gui" ]; then
                exec "$HOME/.local/bin/git-master-backup-gui"
            fi
            ;;
        6)
            exit 0
            ;;
    esac
elif [ -n "${MANAGE_ONLY:-}" ]; then
    manage_sources
    exit 0
fi

# ─────────────────────────────────────────────────────────────────────────────
# EXECUTION ENGINE
# ─────────────────────────────────────────────────────────────────────────────
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# Determine scan directories
if [ ${#CLI_DIRS[@]} -gt 0 ]; then
    SCAN_DIRS=("${CLI_DIRS[@]}")
else
    mapfile -t SCAN_DIRS < <(get_config_dirs)
fi

if [ ${#SCAN_DIRS[@]} -eq 0 ]; then
    SCAN_DIRS=("$HOME")
fi

# Protocol setup
PROTO="${PROTOCOL_OVERRIDE:-$(get_config_val "protocol" "both")}"
case "$PROTO" in
    ssh|SSH)
        ALLOW_SSH=1
        ALLOW_HTTPS=0
        MODE_NAME="SSH Only"
        ;;
    https|HTTPS)
        ALLOW_SSH=0
        ALLOW_HTTPS=1
        MODE_NAME="HTTPS Only"
        ;;
    *)
        ALLOW_SSH=1
        ALLOW_HTTPS=1
        MODE_NAME="SSH + HTTPS"
        ;;
esac

echo ""
echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║               🚀 EXECUTING MASTER BACKUP                 ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════╝${NC}"
echo -e "${CYAN}📅 Timestamp :${NC} $TIMESTAMP"
echo -e "${CYAN}🌐 Protocol  :${NC} $MODE_NAME"
[ $DRY_RUN -eq 1 ] && echo -e "${YELLOW}🔍 Mode      : DRY-RUN (Preview without pushing)${NC}"
echo -e "${CYAN}📁 Scanning  :${NC} ${SCAN_DIRS[*]}"
echo ""

mapfile -t EXCLUDE_PATTERNS < <(get_config_excludes)
FIND_EXCLUDES=()
for excl in "${EXCLUDE_PATTERNS[@]}"; do
    FIND_EXCLUDES+=(-not -path "$excl")
done

PUSHED_REPOS=()
UP_TO_DATE_REPOS=()
SKIPPED_REPOS=()
FAILED_REPOS=()

while IFS= read -r gitdir; do
    [ -z "$gitdir" ] && continue
    repo="$(dirname "$gitdir")"
    repo_name="$(basename "$repo")"

    echo -e "${BLUE}--------------------------------------------------${NC}"
    echo -e "${BOLD}📁 Repo:${NC} $repo"

    if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
        echo -e "${RED}❌ Invalid git directory, skipping.${NC}\n"
        FAILED_REPOS+=("$repo (Invalid git directory)")
        continue
    fi

    remote_url=$(git -C "$repo" remote get-url origin 2>/dev/null || true)
    if [[ -z "$remote_url" ]]; then
        echo -e "${YELLOW}⚠️  No remote origin configured, skipping.${NC}\n"
        SKIPPED_REPOS+=("$repo (No remote origin)")
        continue
    fi

    # Filter remote protocol
    if [[ "$remote_url" == git@* ]]; then
        if [[ $ALLOW_SSH -eq 0 ]]; then
            echo -e "${YELLOW}🔒 SSH repo skipped by user mode.${NC}\n"
            SKIPPED_REPOS+=("$repo (SSH mode disabled)")
            continue
        fi
    elif [[ "$remote_url" == https://* ]]; then
        if [[ $ALLOW_HTTPS -eq 0 ]]; then
            echo -e "${YELLOW}🔒 HTTPS repo skipped by user mode.${NC}\n"
            SKIPPED_REPOS+=("$repo (HTTPS mode disabled)")
            continue
        fi
    else
        echo -e "${YELLOW}⚠️  Unknown remote format ($remote_url), skipping.${NC}\n"
        SKIPPED_REPOS+=("$repo (Unknown remote: $remote_url)")
        continue
    fi

    current_branch=$(git -C "$repo" branch --show-current 2>/dev/null || true)
    if [[ -z "$current_branch" ]]; then
        current_branch=$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "HEAD")
    fi

    echo -e "${CYAN}🌿 Branch:${NC} $current_branch | ${CYAN}🌐 Remote:${NC} $remote_url"

    changes=$(git -C "$repo" status --porcelain 2>/dev/null || true)
    had_changes=0

    if [[ -n "$changes" ]]; then
        had_changes=1
        count=$(echo "$changes" | wc -l)
        echo -e "${YELLOW}📝 Detected $count change(s).${NC}"
        echo "$changes" | head -n 4
        if [[ $count -gt 4 ]]; then
            echo -e "${YELLOW}   ... and $((count - 4)) more files${NC}"
        fi

        if [ $DRY_RUN -eq 0 ]; then
            git -C "$repo" add -A
            git -C "$repo" commit -m "Auto-backup: $TIMESTAMP" >/dev/null 2>&1 || true
            echo -e "${GREEN}✓ Staged & committed changes.${NC}"
        else
            echo -e "${YELLOW}🔍 [Dry-Run] Skipped commit.${NC}"
        fi
    fi

    ahead=$(git -C "$repo" rev-list --count "@{u}..HEAD" 2>/dev/null || echo "1")

    if [[ "$ahead" -gt 0 ]] || [[ $had_changes -eq 1 ]]; then
        if [ $DRY_RUN -eq 1 ]; then
            echo -e "${YELLOW}🔍 [Dry-Run] Would push branch '$current_branch' to origin.${NC}\n"
            PUSHED_REPOS+=("$repo [$current_branch -> $remote_url (dry-run)]")
        else
            echo -e "${YELLOW}📤 Pushing branch '$current_branch'...${NC}"
            if git -C "$repo" push origin "$current_branch" 2>&1; then
                echo -e "${GREEN}✅ Pushed successfully!${NC}\n"
                PUSHED_REPOS+=("$repo [$current_branch -> $remote_url]")
            else
                echo -e "${YELLOW}   Retrying with upstream setup...${NC}"
                if git -C "$repo" push --set-upstream origin "$current_branch" 2>&1; then
                    echo -e "${GREEN}✅ Upstream set & push successful!${NC}\n"
                    PUSHED_REPOS+=("$repo [$current_branch -> $remote_url]")
                else
                    echo -e "${RED}❌ Push failed!${NC}\n"
                    FAILED_REPOS+=("$repo [$remote_url]")
                fi
            fi
        fi
    else
        echo -e "${GREEN}💤 Clean & up to date with remote.${NC}\n"
        UP_TO_DATE_REPOS+=("$repo")
    fi

done < <(find "${SCAN_DIRS[@]}" "${FIND_EXCLUDES[@]}" -type d -name ".git" 2>/dev/null)

# ─────────────────────────────────────────────────────────────────────────────
# SUMMARY REPORT
# ─────────────────────────────────────────────────────────────────────────────
echo ""
echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║                   📊 BACKUP SUMMARY REPORT               ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════╝${NC}\n"

if [[ ${#PUSHED_REPOS[@]} -gt 0 ]]; then
    echo -e "${GREEN}${BOLD}🚀 REPOSITORIES PUSHED (${#PUSHED_REPOS[@]}):${NC}"
    for r in "${PUSHED_REPOS[@]}"; do
        echo -e "   ${GREEN}✔${NC} $r"
    done
    echo ""
fi

if [[ ${#UP_TO_DATE_REPOS[@]} -gt 0 ]]; then
    echo -e "${CYAN}${BOLD}💤 REPOSITORIES ALREADY UP TO DATE (${#UP_TO_DATE_REPOS[@]}):${NC}"
    for r in "${UP_TO_DATE_REPOS[@]}"; do
        echo -e "   ${CYAN}•${NC} $r"
    done
    echo ""
fi

if [[ ${#SKIPPED_REPOS[@]} -gt 0 ]]; then
    echo -e "${YELLOW}${BOLD}⚠️  REPOSITORIES SKIPPED (${#SKIPPED_REPOS[@]}):${NC}"
    for r in "${SKIPPED_REPOS[@]}"; do
        echo -e "   ${YELLOW}-${NC} $r"
    done
    echo ""
fi

if [[ ${#FAILED_REPOS[@]} -gt 0 ]]; then
    echo -e "${RED}${BOLD}❌ REPOSITORIES FAILED (${#FAILED_REPOS[@]}):${NC}"
    for r in "${FAILED_REPOS[@]}"; do
        echo -e "   ${RED}✖${NC} $r"
    done
    echo ""
fi

echo -e "${BOLD}Totals:${NC} ${GREEN}${#PUSHED_REPOS[@]} pushed${NC} | ${CYAN}${#UP_TO_DATE_REPOS[@]} up to date${NC} | ${YELLOW}${#SKIPPED_REPOS[@]} skipped${NC} | ${RED}${#FAILED_REPOS[@]} failed${NC}\n"
