#!/usr/bin/env python3
import sys
import os
import json
import math
import subprocess
from pathlib import Path
from PyQt5.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QPushButton, QListWidget, QListWidgetItem, QFrame,
    QTabWidget, QSlider
)
from PyQt5.QtGui import (
    QColor, QFont, QIcon, QPainter, QBrush, QPen, QCursor,
    QPixmap, QImage, QConicalGradient, QRadialGradient
)
from PyQt5.QtCore import Qt, QSize, QTimer, QPointF, pyqtSignal

HISTORY_FILE = Path.home() / ".local" / "share" / "hyprpicker_gui_history.json"
MAX_HISTORY = 50

def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip('#')
    if len(hex_str) == 6:
        return tuple(int(hex_str[i:i+2], 16) for i in (0, 2, 4))
    return (0, 0, 0)

def hex_to_hsl(hex_str):
    r, g, b = [x / 255.0 for x in hex_to_rgb(hex_str)]
    max_c = max(r, g, b)
    min_c = min(r, g, b)
    l = (max_c + min_c) / 2.0
    if max_c == min_c:
        h = s = 0.0
    else:
        d = max_c - min_c
        s = d / (2.0 - max_c - min_c) if l > 0.5 else d / (max_c + min_c)
        if max_c == r:
            h = (g - b) / d + (6.0 if g < b else 0.0)
        elif max_c == g:
            h = (b - r) / d + 2.0
        else:
            h = (r - g) / d + 4.0
        h /= 6.0
    return round(h * 360), round(s * 100), round(l * 100)

class FastColorWheel(QWidget):
    colorChanged = pyqtSignal(QColor)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedSize(220, 220)
        self.hue = 0.0        # 0.0 - 360.0
        self.sat = 1.0        # 0.0 - 1.0
        self.val = 1.0        # 0.0 - 1.0
        self.base_pixmap = None
        self._generate_base_wheel()

    def _generate_base_wheel(self):
        # Generate base hue+saturation wheel using GPU/Qt gradient primitives (instant)
        size = self.width()
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.transparent)

        painter = QPainter(pixmap)
        painter.setRenderHint(QPainter.Antialiasing)

        center = size / 2.0
        radius = center - 6.0

        # Conical gradient for 360-degree hues
        conical = QConicalGradient(center, center, 0)
        for i in range(361):
            conical.setColorAt(i / 360.0, QColor.fromHsvF(i / 360.0, 1.0, 1.0))

        painter.setPen(Qt.NoPen)
        painter.setBrush(QBrush(conical))
        painter.drawEllipse(QPointF(center, center), radius, radius)

        # Radial gradient from center (white / saturation 0) to outer edge (transparent / saturation 1)
        radial = QRadialGradient(center, center, radius)
        radial.setColorAt(0.0, QColor(255, 255, 255, 255))
        radial.setColorAt(1.0, QColor(255, 255, 255, 0))

        painter.setBrush(QBrush(radial))
        painter.drawEllipse(QPointF(center, center), radius, radius)
        painter.end()

        self.base_pixmap = pixmap

    def set_val(self, v):
        if self.val != v:
            self.val = v
            self.update()

    def set_color(self, color: QColor):
        h, s, v, _ = color.getHsvF()
        if h < 0:
            h = 0.0
        self.hue = h * 360.0
        self.sat = s
        self.val = v
        self.update()

    def get_color(self):
        return QColor.fromHsvF(self.hue / 360.0, self.sat, self.val)

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)

        center = self.width() / 2.0
        radius = center - 6.0

        # 1. Draw base wheel
        if self.base_pixmap:
            painter.drawPixmap(0, 0, self.base_pixmap)

        # 2. Apply brightness overlay with pure alpha black (instant GPU compositing)
        if self.val < 1.0:
            dark_alpha = int((1.0 - self.val) * 255)
            painter.setPen(Qt.NoPen)
            painter.setBrush(QColor(0, 0, 0, dark_alpha))
            painter.drawEllipse(QPointF(center, center), radius, radius)

        # 3. Outer border ring
        painter.setPen(QPen(QColor(255, 255, 255, 40), 2))
        painter.setBrush(Qt.NoBrush)
        painter.drawEllipse(QPointF(center, center), radius, radius)

        # 4. Handle indicator
        rad = math.radians(self.hue)
        hx = center + radius * self.sat * math.cos(rad)
        hy = center + radius * self.sat * math.sin(rad)

        painter.setPen(QPen(QColor(0, 0, 0, 180), 2.5))
        painter.setBrush(QBrush(self.get_color()))
        painter.drawEllipse(QPointF(hx, hy), 7.5, 7.5)

        painter.setPen(QPen(QColor(255, 255, 255, 230), 1.5))
        painter.setBrush(Qt.NoBrush)
        painter.drawEllipse(QPointF(hx, hy), 9, 9)

    def mousePressEvent(self, event):
        self._update_from_pos(event.pos())

    def mouseMoveEvent(self, event):
        if event.buttons() & Qt.LeftButton:
            self._update_from_pos(event.pos())

    def _update_from_pos(self, pos):
        center = self.width() / 2.0
        radius = center - 6.0
        dx = pos.x() - center
        dy = pos.y() - center
        dist = math.hypot(dx, dy)

        angle = math.degrees(math.atan2(dy, dx))
        if angle < 0:
            angle += 360

        self.hue = angle
        self.sat = max(0.0, min(1.0, dist / radius))
        self.update()
        self.colorChanged.emit(self.get_color())

class ColorBadge(QWidget):
    def __init__(self, color_hex="#89b4fa", parent=None):
        super().__init__(parent)
        self.color_hex = color_hex
        self.setFixedSize(64, 64)

    def set_color(self, hex_val):
        self.color_hex = hex_val
        self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        painter.setPen(QPen(QColor(255, 255, 255, 45), 2))
        painter.setBrush(QBrush(QColor(self.color_hex)))
        painter.drawRoundedRect(2, 2, self.width() - 4, self.height() - 4, 12, 12)

class FormatRow(QFrame):
    def __init__(self, label_text, on_copy, parent=None):
        super().__init__(parent)
        self.on_copy = on_copy
        self.format_label = label_text
        self.current_val = ""

        self.setStyleSheet("""
            QFrame {
                background: #181926;
                border: 1px solid #282a36;
                border-radius: 8px;
                padding: 2px;
            }
            QFrame:hover {
                border: 1px solid #45475a;
                background: #1e1e2e;
            }
        """)

        layout = QHBoxLayout(self)
        layout.setContentsMargins(8, 4, 6, 4)
        layout.setSpacing(8)

        self.tag_lbl = QLabel(label_text)
        self.tag_lbl.setFont(QFont("Inter, Sans-serif", 9, QFont.Bold))
        self.tag_lbl.setStyleSheet("color: #89b4fa; background: transparent; border: none; min-width: 40px;")

        self.val_lbl = QLabel("—")
        self.val_lbl.setFont(QFont("JetBrains Mono, Monospace", 10))
        self.val_lbl.setStyleSheet("color: #cdd6f4; background: transparent; border: none;")

        self.copy_btn = QPushButton("Copy")
        self.copy_btn.setCursor(QCursor(Qt.PointingHandCursor))
        self.copy_btn.setFont(QFont("Inter, Sans-serif", 8, QFont.Bold))
        self.copy_btn.setStyleSheet("""
            QPushButton {
                background: #313244;
                color: #cdd6f4;
                border-radius: 4px;
                padding: 3px 8px;
                border: none;
            }
            QPushButton:hover {
                background: #89b4fa;
                color: #11111b;
            }
            QPushButton:pressed {
                background: #b4befe;
            }
        """)
        self.copy_btn.clicked.connect(self._handle_copy)

        layout.addWidget(self.tag_lbl)
        layout.addWidget(self.val_lbl, 1)
        layout.addWidget(self.copy_btn)

    def set_value(self, val):
        self.current_val = val
        self.val_lbl.setText(val)

    def _handle_copy(self):
        if self.current_val:
            self.on_copy(self.current_val, self.copy_btn)

