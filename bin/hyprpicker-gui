    def __init__(self):
        super().__init__()
        self.setWindowTitle("Colour Picker")
        self.setFixedSize(480, 710)
        self.history = self.load_history()
        self.current_color = self.history[0] if self.history else "#89b4fa"

        self.init_ui()
        self.update_display(self.current_color, update_wheel=True)

    def init_ui(self):
        self.setStyleSheet("""
            QMainWindow {
                background-color: #11111b;
            }
            QLabel {
                color: #cdd6f4;
            }
            QTabWidget::pane {
                border: 1px solid #313244;
                border-radius: 10px;
                background-color: #181825;
                top: -1px;
            }
            QTabBar::tab {
                background: #181926;
                color: #a6adc8;
                padding: 7px 18px;
                margin-right: 4px;
                border-top-left-radius: 8px;
                border-top-right-radius: 8px;
                font-weight: bold;
                font-size: 11px;
            }
            QTabBar::tab:selected {
                background: #181825;
                color: #89b4fa;
                border-bottom: 2px solid #89b4fa;
            }
            QListWidget {
                background-color: transparent;
                border: none;
                color: #cdd6f4;
                outline: 0;
            }
            QListWidget::item {
                border-radius: 6px;
                padding: 6px 8px;
                margin-bottom: 2px;
                background: #1e1e2e;
            }
            QListWidget::item:hover {
                background-color: #313244;
            }
            QListWidget::item:selected {
                background-color: #45475a;
                color: #89b4fa;
            }
