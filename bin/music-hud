        "highlight": curses.COLOR_YELLOW,
        "name": "COLOR BLOCK"
    },
    "sketchbook": {
        "accent": curses.COLOR_WHITE,
        "secondary": curses.COLOR_CYAN,
        "highlight": curses.COLOR_RED,
        "name": "SKETCHBOOK"
    },
    "retroboy": {
        "accent": curses.COLOR_GREEN,
        "secondary": curses.COLOR_WHITE,
