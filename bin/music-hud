#!/usr/bin/env python3
"""
music-hud - Themed Hi-Res Music HUD with Real-time CAVA Visualizer & Synced Lyrics
Interactive, theme-adaptive terminal HUD for Waybar, Hyprland & Kitty

Features:
  - Multi-row Dynamic CAVA Spectrum Visualizer (4 vertical rows)
  - Hardware Audio Resolution & Bit-Depth (24-bit / 96kHz)
  - Synced Karaoke Lyrics with Live Nudge Calibration ([ / ])
  - Seeking Controls (← / → / h / l)
  - Volume Controls (↑ / ↓ / k / j / + / -)
  - Shuffle & Repeat Toggles (s / r)
  - Favorite Hearting (f)
  - A-B Section Looping (a / b / c)
  - Integrated Kitty Terminal Cover Art Support
"""

import os
import sys
import time
import re
import glob
import json
import curses
import shutil
import threading
import subprocess
from typing import List, Tuple, Optional, Dict

MUSIC_DIR = os.path.expanduser("~/Music/flac")
THEME_FILE = os.path.expanduser("~/.config/hypr/.theme_current")
CACHE_DIR = os.path.expanduser("~/.cache/syncedlyrics")
CAVA_CONF = "/tmp/music_hud_cava.conf"
FAVORITES_FILE = os.path.expanduser("~/Music/favorites.m3u")
QUEUE_BIN = os.path.expanduser("~/.local/bin/flac-queue")
FAV_BIN = os.path.expanduser("~/.local/bin/flac-fav")

# Ensure ~/.local/bin is always in PATH
local_bin = os.path.expanduser("~/.local/bin")
if local_bin not in os.environ.get("PATH", "").split(":"):
    os.environ["PATH"] = f"{local_bin}:{os.environ.get('PATH', '')}"

os.makedirs(CACHE_DIR, exist_ok=True)

# ─────────────────────────────────────────────────────────────────────────────
# THEME COLOR DEFINITIONS
# ─────────────────────────────────────────────────────────────────────────────
