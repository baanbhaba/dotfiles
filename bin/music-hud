        "name": "NEOBRUTALISM"
    },
    "charcoal": {
        "accent": curses.COLOR_YELLOW,
        "secondary": curses.COLOR_WHITE,
        "highlight": curses.COLOR_RED,
        "name": "CHARCOAL"
    },
    "jaipur": {
        "accent": curses.COLOR_RED,
        "secondary": curses.COLOR_YELLOW,
        "highlight": curses.COLOR_MAGENTA,
        "name": "JAIPUR"
    },
    "colorblock": {
