        sec_card = QFrame()
        sec_card.setObjectName("Card")
        sec_cl = QVBoxLayout(sec_card)
        sec_cl.setContentsMargins(20, 16, 20, 16)
        sec_cl.setSpacing(12)

        pin_title = QLabel("Change Master Passcode")
        pin_title.setFont(QFont(FONT_UI, 12, QFont.Medium))
        pin_title.setStyleSheet("background: transparent;")
        sec_cl.addWidget(pin_title)

        pin_row = QHBoxLayout()
        self.old_pin = QLineEdit(); self.old_pin.setEchoMode(QLineEdit.Password)
        self.old_pin.setPlaceholderText("Current passcode")
