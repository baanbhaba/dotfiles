VAULT_PATH = Path.home() / ".local" / "share" / "note_vault.json"
CONFIG_PATH = Path.home() / ".config" / "note" / "config.json"
FONT_UI = "Inter"
FONT_MONO = "JetBrains Mono"

# ─────────────────────────────────────────────────────────────────────────────
# CONFIG & CRYPTO
# ─────────────────────────────────────────────────────────────────────────────
def load_config():
    if CONFIG_PATH.exists():
        try:
            return json.load(open(CONFIG_PATH))
        except: pass
    return {"theme": "Void", "zen": False}

def save_config(cfg):
    try:
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        json.dump(cfg, open(CONFIG_PATH, "w"), indent=2)
    except Exception as e: print("cfg err:", e)

def derive_key(pin, salt):
    return hashlib.pbkdf2_hmac('sha256', pin.encode(), salt, 100000)

def encrypt_string(plain, pin):
    salt = os.urandom(16)
    key = derive_key(pin, salt)
    plain_bytes = plain.encode('utf-8')
    enc = bytearray()
    for i, b in enumerate(plain_bytes):
        k = hashlib.sha256(key + i.to_bytes(4, 'big')).digest()[0]
        enc.append(b ^ k)
    return {"salt": base64.b64encode(salt).decode(), "data": base64.b64encode(bytes(enc)).decode()}

def decrypt_string(payload, pin):
    salt = base64.b64decode(payload["salt"])
    key = derive_key(pin, salt)
    cipher = base64.b64decode(payload["data"])
    dec = bytearray()
    for i, b in enumerate(cipher):
        k = hashlib.sha256(key + i.to_bytes(4, 'big')).digest()[0]
        dec.append(b ^ k)
    return dec.decode('utf-8')

