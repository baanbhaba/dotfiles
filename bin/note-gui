# ─────────────────────────────────────────────────────────────────────────────
# DYNAMIC STYLESHEET GENERATOR
# ─────────────────────────────────────────────────────────────────────────────
def generate_stylesheet(name: str) -> str:
    m = THEME_META.get(name, THEME_META["Void (Dark)"])
    return f"""
        QMainWindow {{ background-color: {m['bg']}; }}
        QWidget {{ background-color: {m['bg']}; color: {m['fg']}; font-family: 'JetBrainsMono Nerd Font', 'JetBrains Mono', 'Segoe UI', 'Inter', 'SF Pro Text', 'Roboto', 'Ubuntu', sans-serif, monospace; }}
        QWidget#Sidebar {{ background-color: {m['sidebar']}; border-right: 1px solid {m['border']}; }}
        QWidget#EditorArea {{ background-color: {m['bg']}; }}
        
        QLineEdit, QTextEdit {{
            background-color: {m['card']};
            color: {m['fg']};
            border: 1px solid {m['border']};
            border-radius: 8px;
            padding: 10px 14px;
            selection-background-color: {m['acc']};
            selection-color: {m['bg']};
        }}
        QLineEdit:focus, QTextEdit:focus {{
            border: 1px solid {m['acc']};
            background-color: {m['card_hover']};
        }}
        QTextEdit {{
            font-size: 14px;
            line-height: 1.6;
        }}
        
        QPushButton {{
            background-color: {m['card']};
            color: {m['acc']};
            border: 1px solid {m['btn_border']};
            border-radius: 8px;
            padding: 7px 14px;
            font-weight: bold;
        }}
        QPushButton:hover {{
            background-color: {m['acc']};
            color: {m['bg']};
            border-color: {m['acc']};
        }}
        QPushButton:pressed {{
            background-color: {m['sub']};
            color: {m['fg']};
        }}
        
        QListWidget {{
            background-color: {m['sidebar']};
            border: 1px solid {m['border']};
            border-radius: 8px;
            padding: 4px;
        }}
        QListWidget::item {{
            background-color: {m['card']};
            color: {m['fg']};
            margin-bottom: 6px;
            padding: 10px 12px;
            border-radius: 6px;
            border: 1px solid {m['border']};
        }}
        QListWidget::item:hover {{
            border: 1px solid {m['acc']};
            background-color: {m['card_hover']};
            color: {m['acc']};
        }}
        QListWidget::item:selected {{
            background-color: {m['acc']};
            color: {m['bg']};
            font-weight: bold;
        }}
        
        QCalendarWidget QWidget#qt_calendar_navigationbar {{ background-color: {m['card']}; }}
        QCalendarWidget QToolButton {{ color: {m['acc']}; background: transparent; border: none; font-weight: bold; }}
        QCalendarWidget QTableView {{
            background-color: {m['sidebar']};
            color: {m['fg']};
            selection-background-color: {m['acc']};
            selection-color: {m['bg']};
            font-weight: bold;
            gridline-color: {m['border']};
        }}
        QCalendarWidget QHeaderView::section {{
            background-color: {m['card']};
            color: {m['acc']};
            font-weight: bold;
        }}
        
        QSplitter::handle {{ background-color: {m['border']}; width: 3px; }}
        QSplitter::handle:hover {{ background-color: {m['acc']}; }}
        QScrollArea {{ border: none; background: transparent; }}
    """

# ─────────────────────────────────────────────────────────────────────────────
# KOKONUT / BKLIT UI THEME CARD COMPONENT WITH MINI VISUAL MOCKUP
# ─────────────────────────────────────────────────────────────────────────────
class MotionThemeCard(QFrame):
    def __init__(self, theme_name, meta, on_click_callback):
        super().__init__()
        self.theme_name = theme_name
        self.meta = meta
        self.on_click = on_click_callback
        self.setCursor(QCursor(Qt.PointingHandCursor))
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
        self.setObjectName("ThemePreviewCard")

        layout = QVBoxLayout(self)
        layout.setContentsMargins(14, 14, 14, 14)
        layout.setSpacing(10)

        # 1. Top Header Row: Name + Category Pill + Active Badge
        top_row = QHBoxLayout()
        self.title_lbl = QLabel(theme_name)
        self.title_lbl.setFont(QFont("JetBrainsMono Nerd Font", 10, QFont.Bold))
        self.title_lbl.setStyleSheet(f"color: {meta['fg']}; border: none; background: transparent;")
        top_row.addWidget(self.title_lbl)
        top_row.addStretch()

        self.badge_lbl = QLabel(meta["category"])
        self.badge_lbl.setFont(QFont("JetBrainsMono Nerd Font", 8, QFont.Bold))
        self.badge_lbl.setStyleSheet(f"""
            color: {meta['acc']};
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid {meta['btn_border']};
            border-radius: 6px;
            padding: 2px 6px;
        """)
        top_row.addWidget(self.badge_lbl)
        layout.addLayout(top_row)

        # 2. Visual Mini-Mockup (Canvas + Sidebar + Swatch Dots)
        mockup = QFrame()
        mockup.setFixedHeight(64)
        mockup.setStyleSheet(f"""
            QFrame {{
                background-color: {meta['bg']};
                border: 1px solid {meta['border']};
                border-radius: 8px;
            }}
        """)
        mock_layout = QHBoxLayout(mockup)
        mock_layout.setContentsMargins(6, 6, 6, 6)
        mock_layout.setSpacing(6)

        # Mini Sidebar
        mini_sb = QFrame()
        mini_sb.setFixedWidth(42)
        mini_sb.setStyleSheet(f"background-color: {meta['sidebar']}; border: 1px solid {meta['border']}; border-radius: 4px;")
        mock_layout.addWidget(mini_sb)

        # Mini Editor Area with 2 mock content lines + swatches
        mini_ed = QWidget()
        mini_ed_l = QVBoxLayout(mini_ed)
        mini_ed_l.setContentsMargins(4, 2, 4, 2)
        mini_ed_l.setSpacing(4)

        line1 = QFrame()
        line1.setFixedHeight(4)
        line1.setStyleSheet(f"background-color: {meta['acc']}; border-radius: 2px;")
        mini_ed_l.addWidget(line1)

        line2 = QFrame()
        line2.setFixedHeight(3)
        line2.setStyleSheet(f"background-color: {meta['card']}; border-radius: 1px;")
        mini_ed_l.addWidget(line2)

        # 4 Swatch Circles Row
        swatch_row = QHBoxLayout()
        swatch_row.setSpacing(4)
        for hex_col in meta.get("swatches", []):
            dot = QFrame()
            dot.setFixedSize(10, 10)
            dot.setStyleSheet(f"background-color: {hex_col}; border: 1px solid rgba(255,255,255,0.2); border-radius: 5px;")
            swatch_row.addWidget(dot)
        swatch_row.addStretch()
        mini_ed_l.addLayout(swatch_row)

        mock_layout.addWidget(mini_ed, 1)
        layout.addWidget(mockup)

        # 3. Descriptive Copy
        self.desc_lbl = QLabel(meta["desc"])
        self.desc_lbl.setWordWrap(True)
        self.desc_lbl.setFont(QFont("JetBrainsMono Nerd Font", 8))
        self.desc_lbl.setStyleSheet(f"color: {meta['sub']}; border: none; background: transparent; line-height: 1.3;")
        layout.addWidget(self.desc_lbl)

        self.apply_declarative_style(active=False)

    def mousePressEvent(self, event):
        self.on_click(self.theme_name)
        super().mousePressEvent(event)

    def apply_declarative_style(self, active=False):
        m = self.meta
        border_col = m["acc"] if active else m["border"]
        border_w = "2px" if active else "1px"
        bg_normal = m["card_hover"] if active else m["card"]
        
        if active:
            self.badge_lbl.setText("✓ ACTIVE")
            self.badge_lbl.setStyleSheet(f"color: {m['bg']}; background-color: {m['acc']}; border-radius: 6px; padding: 2px 6px; font-weight: 900;")
        else:
            self.badge_lbl.setText(m["category"])
            self.badge_lbl.setStyleSheet(f"color: {m['acc']}; background-color: rgba(255, 255, 255, 0.05); border: 1px solid {m['btn_border']}; border-radius: 6px; padding: 2px 6px;")

        self.setStyleSheet(f"""
            QFrame#ThemePreviewCard {{
                background-color: {bg_normal};
                border: {border_w} solid {border_col};
                border-radius: 12px;
            }}
            QFrame#ThemePreviewCard:hover {{
                background-color: {m['card_hover']};
                border: 2px solid {m['acc']};
            }}
        """)
# ─────────────────────────────────────────────────────────────────────────────
# MAIN APPLICATION CONTROLLER
# ─────────────────────────────────────────────────────────────────────────────
class NoteApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Note")
        self.setWindowIcon(QIcon(str(Path.home() / ".local" / "share" / "icons" / "note.png")))
        self.setMinimumSize(960, 660)
        self.resize(1140, 750)
        self.entries = []
        self.active_id = None
        self.is_zen = False
        self.active_date_str = date.today().isoformat()
        self._entry_index = {}   # id → entry dict

        self.config = load_config()
        self.current_theme = self.config.get("theme", "Void (Dark)")
        if self.current_theme not in THEME_META:
            self.current_theme = "Void (Dark)"

        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)

        # Debounced autosave — writes to disk 800ms after last keystroke
        self._save_timer = QTimer(self)
        self._save_timer.setSingleShot(True)
        self._save_timer.setInterval(800)
        self._save_timer.timeout.connect(self.save_vault)

        self.init_lock_screen()      # index 0
        self.init_main_workspace()   # index 1
        self.init_settings_page()    # index 2

        self.apply_theme(self.current_theme)
        self.load_entries()
        
        # If lock pin is configured, start on lock screen (index 0); otherwise go straight to workspace (index 1)
        if self.config.get("pin"):
            self.stack.setCurrentIndex(0)
            self.pin_input.setFocus()
        else:
            self.stack.setCurrentIndex(1)

    def apply_theme(self, theme_name):
        if theme_name in THEME_META:
            self.current_theme = theme_name
            self.config["theme"] = theme_name
            save_config(self.config)
            
            self.setStyleSheet(generate_stylesheet(theme_name))
            self.sync_lock_screen_theme(theme_name)

            if hasattr(self, 'theme_cards'):
                for name, card in self.theme_cards.items():
                    card.apply_declarative_style(active=(name == theme_name))

    def save_vault(self):
        try:
            DATA_PATH.parent.mkdir(parents=True, exist_ok=True)
            raw = encrypt_data(json.dumps(self.entries))
            DATA_PATH.write_bytes(raw)
        except Exception as e:
            print("Save error:", e)

    # 1. MINIMALIST HYPRLOCK-STYLE AUTH SCREEN
    def init_lock_screen(self):
        self.lock_widget = QWidget()
        layout = QVBoxLayout(self.lock_widget)
        layout.setAlignment(Qt.AlignCenter)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(24)

        # Digital Clock
        self.time_lbl = QLabel("")
        self.time_lbl.setFont(QFont("JetBrainsMono Nerd Font", 74, QFont.Bold))
        self.time_lbl.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.time_lbl)

        # Date Label
        self.date_lbl = QLabel("")
        self.date_lbl.setFont(QFont("JetBrainsMono Nerd Font", 13))
        self.date_lbl.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.date_lbl)

        # Live Clock Timer
        self.clock_timer = QTimer(self)
        self.clock_timer.timeout.connect(self.update_lock_clock)
        self.clock_timer.start(1000)
        self.update_lock_clock()

        # Input Pill
        self.pin_input = QLineEdit()
        self.pin_input.setEchoMode(QLineEdit.Password)
        self.pin_input.setPlaceholderText("Enter Passcode")
        self.pin_input.setAlignment(Qt.AlignCenter)
        self.pin_input.setFixedSize(320, 56)
        self.pin_input.setFont(QFont("JetBrainsMono Nerd Font", 16, QFont.Bold))
        
        self.lock_shadow = QGraphicsDropShadowEffect(self)
        self.lock_shadow.setBlurRadius(40)
        self.lock_shadow.setOffset(0, 0)
        self.pin_input.setGraphicsEffect(self.lock_shadow)
        
        self.pin_input.returnPressed.connect(self.handle_auth)
        layout.addWidget(self.pin_input, alignment=Qt.AlignCenter)

        self.auth_msg = QLabel("Press Enter to Unlock Vault")
        self.auth_msg.setFont(QFont("JetBrainsMono Nerd Font", 9))
        self.auth_msg.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.auth_msg, alignment=Qt.AlignCenter)

        self.stack.addWidget(self.lock_widget)

    def update_lock_clock(self):
        now = datetime.now()
        self.time_lbl.setText(now.strftime("%I:%M"))
        self.date_lbl.setText(now.strftime("%A, %B %d").upper())

    def sync_lock_screen_theme(self, theme_name):
        if not hasattr(self, 'lock_widget'):
            return
        meta = THEME_META.get(theme_name, THEME_META["Void (Dark)"])
        self.lock_widget.setStyleSheet(f"background-color: {meta['bg']};")
        self.time_lbl.setStyleSheet(f"color: {meta['fg']}; border: none; background: transparent; letter-spacing: -2px;")
        self.date_lbl.setStyleSheet(f"color: {meta['sub']}; border: none; background: transparent; margin-top: -18px;")
        
        r, g, b, a = meta["glow"]
        self.lock_shadow.setColor(QColor(r, g, b, a))
        
        self.pin_input.setStyleSheet(f"""
            QLineEdit {{
                background-color: {meta['input_bg']};
                color: {meta['input_fg']};
                border: 2px solid {meta['border']};
                border-radius: {meta['pill_radius']};
                padding: 8px 16px;
                letter-spacing: 8px;
            }}
            QLineEdit:focus {{
                border: 2px solid {meta['acc']};
            }}
        """)
        self.auth_msg.setStyleSheet(f"color: {meta['sub']}; border: none; background: transparent;")

    def trigger_shake_animation(self, widget):
        anim = QPropertyAnimation(widget, b"pos")
        anim.setDuration(300)
        orig_pos = widget.pos()
        anim.setKeyValueAt(0.0, orig_pos)
        anim.setKeyValueAt(0.1, orig_pos + QPoint(-12, 0))
        anim.setKeyValueAt(0.3, orig_pos + QPoint(12, 0))
        anim.setKeyValueAt(0.5, orig_pos + QPoint(-8, 0))
        anim.setKeyValueAt(0.7, orig_pos + QPoint(8, 0))
        anim.setKeyValueAt(0.9, orig_pos + QPoint(-4, 0))
        anim.setKeyValueAt(1.0, orig_pos)
        anim.setEasingCurve(QEasingCurve.OutQuad)
        anim.start()
        self._shake_anim = anim

    def handle_auth(self):
        entered_pin = self.pin_input.text().strip()
        configured_pin = self.config.get("pin", "")
        if configured_pin and entered_pin == configured_pin:
            self.pin_input.clear()
            self.auth_msg.setText("Press Enter to Unlock Vault")
            self.stack.setCurrentIndex(1)
        else:
            self.auth_msg.setText("Incorrect passcode.")
            self.trigger_shake_animation(self.pin_input)

    def lock_vault(self):
        if self.config.get("pin"):
            self.pin_input.clear()
            self.auth_msg.setText("Press Enter to Unlock Vault")
            self.sync_lock_screen_theme(self.current_theme)
            self.stack.setCurrentIndex(0)
            self.pin_input.setFocus()

    # 2. MAIN JOURNAL WORKSPACE
    def init_main_workspace(self):
        self.main_widget = QWidget()
        main_layout = QHBoxLayout(self.main_widget)
        main_layout.setContentsMargins(12, 12, 12, 12)
        main_layout.setSpacing(12)

        self.splitter = QSplitter(Qt.Horizontal)
        self.splitter.setChildrenCollapsible(False)

        # Left Sidebar
        self.sidebar = QWidget()
        self.sidebar.setObjectName("Sidebar")
        self.sidebar.setMinimumWidth(320)
        sidebar_layout = QVBoxLayout(self.sidebar)
        sidebar_layout.setContentsMargins(12, 12, 12, 12)
        sidebar_layout.setSpacing(10)

        # Header with Settings & Lock
        sb_header = QHBoxLayout()
        sb_title = QLabel("󰠮 NOTE")
        sb_title.setFont(QFont("JetBrainsMono Nerd Font", 12, QFont.Bold))
        sb_header.addWidget(sb_title)
        sb_header.addStretch()

        settings_btn = QPushButton("󰒓 Settings")
        settings_btn.setCursor(QCursor(Qt.PointingHandCursor))
        settings_btn.clicked.connect(self.go_to_settings)
        sb_header.addWidget(settings_btn)

        self.lock_sb_btn = QPushButton("󰌾")
        self.lock_sb_btn.setCursor(QCursor(Qt.PointingHandCursor))
        self.lock_sb_btn.clicked.connect(self.lock_vault)
        self.lock_sb_btn.setVisible(bool(self.config.get("pin")))
        sb_header.addWidget(self.lock_sb_btn)
        sidebar_layout.addLayout(sb_header)

        # Search Bar
        self.search_input = QLineEdit()
        self.search_input.setPlaceholderText("󰍉 Search thoughts or #tags...")
        self.search_input.setFont(QFont("JetBrainsMono Nerd Font", 10))
        self.search_input.textChanged.connect(self.on_search_filter)
        sidebar_layout.addWidget(self.search_input)

        # Native Calendar Widget
        self.calendar = QCalendarWidget()
        self.calendar.setGridVisible(True)
        self.calendar.setVerticalHeaderFormat(QCalendarWidget.NoVerticalHeader)
        self.calendar.clicked.connect(self.on_date_selected)
        sidebar_layout.addWidget(self.calendar)

        # List Header Controls
        list_ctrl = QHBoxLayout()
        self.list_lbl = QLabel("󰈙 Journal Feed")
        self.list_lbl.setFont(QFont("JetBrainsMono Nerd Font", 10, QFont.Bold))
        list_ctrl.addWidget(self.list_lbl)
        list_ctrl.addStretch()

        new_btn = QPushButton("󰐕 New Entry")
        new_btn.setCursor(QCursor(Qt.PointingHandCursor))
        new_btn.clicked.connect(self.create_entry)
        list_ctrl.addWidget(new_btn)
        sidebar_layout.addLayout(list_ctrl)

        # Entry List
        self.entry_list = QListWidget()
        self.entry_list.itemClicked.connect(self.on_entry_selected)
        sidebar_layout.addWidget(self.entry_list, 1)

        self.splitter.addWidget(self.sidebar)

        # Right Editor Area
        self.editor_area = QWidget()
        self.editor_area.setObjectName("EditorArea")
        self.editor_area.setMinimumWidth(450)
        editor_layout = QVBoxLayout(self.editor_area)
        editor_layout.setContentsMargins(8, 0, 0, 0)
        editor_layout.setSpacing(10)

        # Editor Metadata Top Bar
        ed_bar = QHBoxLayout()
        self.meta_lbl = QLabel("")
        self.meta_lbl.setFont(QFont("JetBrainsMono Nerd Font", 10))
        ed_bar.addWidget(self.meta_lbl)
        ed_bar.addStretch()

        self.word_lbl = QLabel("0 words · 0 min read")
        self.word_lbl.setFont(QFont("JetBrainsMono Nerd Font", 9))
        ed_bar.addWidget(self.word_lbl)


        self.pin_btn = QPushButton("󰤰 Pin")
        self.pin_btn.setCursor(QCursor(Qt.PointingHandCursor))
        self.pin_btn.clicked.connect(self.toggle_pin_active_entry)
        ed_bar.addWidget(self.pin_btn)

        self.zen_btn = QPushButton("󰈈 Zen Focus")
        self.zen_btn.setCursor(QCursor(Qt.PointingHandCursor))
        self.zen_btn.clicked.connect(self.toggle_zen)
        ed_bar.addWidget(self.zen_btn)

        del_btn = QPushButton("󰆴")
        del_btn.setCursor(QCursor(Qt.PointingHandCursor))
        del_btn.clicked.connect(self.delete_entry)
        ed_bar.addWidget(del_btn)
        editor_layout.addLayout(ed_bar)

        # Title Field
        self.title_edit = QLineEdit()
        self.title_edit.setPlaceholderText("Entry Title...")
        self.title_edit.setFont(QFont("JetBrainsMono Nerd Font", 15, QFont.Bold))
        self.title_edit.textChanged.connect(self.on_content_modified)
        editor_layout.addWidget(self.title_edit)

        # Tags Row
        self.tags_edit = QLineEdit()
        self.tags_edit.setPlaceholderText("󰓹 Tags: e.g. code, deep-work, ideas")
        self.tags_edit.setFont(QFont("JetBrainsMono Nerd Font", 10))
        self.tags_edit.textChanged.connect(self.on_content_modified)
        editor_layout.addWidget(self.tags_edit)

        # Textarea
        self.content_edit = QTextEdit()
        self.content_edit.setPlaceholderText("Write what's on your mind...")
        self.content_edit.setFont(QFont("JetBrainsMono Nerd Font", 11))
        self.content_edit.textChanged.connect(self.on_content_modified)
        editor_layout.addWidget(self.content_edit, 1)

        self.splitter.addWidget(self.editor_area)
        self.splitter.setSizes([340, 760])

        main_layout.addWidget(self.splitter)
        self.stack.addWidget(self.main_widget)

    # 3. SETTINGS & THEMES GALLERY
    def init_settings_page(self):
        self.settings_widget = QWidget()
        settings_layout = QVBoxLayout(self.settings_widget)
        settings_layout.setContentsMargins(32, 28, 32, 28)
        settings_layout.setSpacing(18)

        # 1. Top Navigation & Stats Bar
        header = QHBoxLayout()
        back_btn = QPushButton("󰁍 Back to Workspace")
        back_btn.setCursor(QCursor(Qt.PointingHandCursor))
        back_btn.clicked.connect(self.go_to_workspace)
        header.addWidget(back_btn)

        header.addSpacing(16)
        title = QLabel("󰒓 Settings & Preferences")
        title.setFont(QFont("JetBrainsMono Nerd Font", 13, QFont.Bold))
        header.addWidget(title)

        header.addStretch()
        self.settings_stats_lbl = QLabel("")
        self.settings_stats_lbl.setFont(QFont("JetBrainsMono Nerd Font", 9))
        self.settings_stats_lbl.setStyleSheet("color: #888888; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; padding: 4px 10px;")
        header.addWidget(self.settings_stats_lbl)
        settings_layout.addLayout(header)

        # 2. Security & Lock Settings Card
        sec_card = QFrame()
        sec_card.setStyleSheet("QFrame { background-color: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 10px; }")
        sec_layout = QVBoxLayout(sec_card)
        sec_layout.setContentsMargins(18, 14, 18, 14)
        sec_layout.setSpacing(10)

        sec_header = QHBoxLayout()
        sec_icon = QLabel("󰌆")
        sec_icon.setFont(QFont("JetBrainsMono Nerd Font", 14, QFont.Bold))
        sec_header.addWidget(sec_icon)
        sec_title = QLabel("Vault Passcode Lock (Optional)")
        sec_title.setFont(QFont("JetBrainsMono Nerd Font", 10, QFont.Bold))
        sec_header.addWidget(sec_title)
        sec_header.addStretch()

        self.sec_status_lbl = QLabel("Active" if self.config.get("pin") else "Disabled")
        self.sec_status_lbl.setFont(QFont("JetBrainsMono Nerd Font", 8, QFont.Bold))
        self.sec_status_lbl.setStyleSheet("color: #2dd4aa;" if self.config.get("pin") else "color: #777777;")
        sec_header.addWidget(self.sec_status_lbl)
        sec_layout.addLayout(sec_header)

        # Pin input row
        pin_row = QHBoxLayout()
        pin_row.setSpacing(8)

        self.set_pin_input = QLineEdit()
        self.set_pin_input.setEchoMode(QLineEdit.Password)
        self.set_pin_input.setPlaceholderText("Set/Change Passcode (min 4 chars)" if not self.config.get("pin") else "New Passcode")
        self.set_pin_input.setFont(QFont("JetBrainsMono Nerd Font", 10))
        pin_row.addWidget(self.set_pin_input, 1)

        self.save_pin_btn = QPushButton("Set Lock")
        self.save_pin_btn.setFont(QFont("JetBrainsMono Nerd Font", 9, QFont.Bold))
        self.save_pin_btn.setCursor(QCursor(Qt.PointingHandCursor))
        self.save_pin_btn.clicked.connect(self.handle_save_pin)
        pin_row.addWidget(self.save_pin_btn)

        self.remove_pin_btn = QPushButton("Remove Lock")
        self.remove_pin_btn.setFont(QFont("JetBrainsMono Nerd Font", 9, QFont.Bold))
        self.remove_pin_btn.setCursor(QCursor(Qt.PointingHandCursor))
        self.remove_pin_btn.clicked.connect(self.handle_remove_pin)
        self.remove_pin_btn.setVisible(bool(self.config.get("pin")))
        pin_row.addWidget(self.remove_pin_btn)

        sec_layout.addLayout(pin_row)
        settings_layout.addWidget(sec_card)

        # 3. Themes Filter Bar (Header + Category Filter Pills)
        theme_bar = QHBoxLayout()
        th_title = QLabel("🎨 Themes Gallery")
        th_title.setFont(QFont("JetBrainsMono Nerd Font", 11, QFont.Bold))
        theme_bar.addWidget(th_title)
        theme_bar.addStretch()

        self.theme_filter_all = QPushButton("All")
        self.theme_filter_dark = QPushButton("Dark")
        self.theme_filter_light = QPushButton("Light")
        
        for btn, cat in [(self.theme_filter_all, "all"), (self.theme_filter_dark, "dark"), (self.theme_filter_light, "light")]:
            btn.setCursor(QCursor(Qt.PointingHandCursor))
            btn.setFont(QFont("JetBrainsMono Nerd Font", 8, QFont.Bold))
            btn.clicked.connect(lambda checked, c=cat: self.filter_theme_gallery(c))
            theme_bar.addWidget(btn)

        settings_layout.addLayout(theme_bar)

        # 4. Scrollable Themes Grid
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll_content = QWidget()
        self.theme_grid = QGridLayout(scroll_content)
        self.theme_grid.setSpacing(12)
        self.theme_grid.setContentsMargins(2, 2, 2, 2)

        self.theme_cards = {}
        for idx, (t_name, meta) in enumerate(THEME_META.items()):
            card = MotionThemeCard(t_name, meta, self.apply_theme)
            self.theme_cards[t_name] = card
            row = idx // 3
            col = idx % 3
            self.theme_grid.addWidget(card, row, col)

        scroll.setWidget(scroll_content)
        settings_layout.addWidget(scroll, 1)

        self.stack.addWidget(self.settings_widget)

    def filter_theme_gallery(self, category: str):
        # Clear and repopulate grid with filtered cards
        for t_name, card in self.theme_cards.items():
            card.setVisible(False)
            self.theme_grid.removeWidget(card)

        visible_cards = []
        for t_name, card in self.theme_cards.items():
            is_light = "(Light)" in t_name
            if category == "all":
                visible_cards.append((t_name, card))
            elif category == "dark" and not is_light:
                visible_cards.append((t_name, card))
            elif category == "light" and is_light:
                visible_cards.append((t_name, card))

        for idx, (t_name, card) in enumerate(visible_cards):
            card.setVisible(True)
            row = idx // 3
            col = idx % 3
            self.theme_grid.addWidget(card, row, col)

    def handle_save_pin(self):
        new_pin = self.set_pin_input.text().strip()
        if len(new_pin) < 4:
            self.set_pin_input.setPlaceholderText("Minimum 4 characters required!")
            self.trigger_shake_animation(self.set_pin_input)
            return
        self.config["pin"] = new_pin
        save_config(self.config)
        self.set_pin_input.clear()
        self.sec_status_lbl.setText("Active")
        self.sec_status_lbl.setStyleSheet("color: #2dd4aa;")
        self.remove_pin_btn.setVisible(True)
        self.lock_sb_btn.setVisible(True)

    def handle_remove_pin(self):
        self.config.pop("pin", None)
        save_config(self.config)
        self.set_pin_input.clear()
        self.sec_status_lbl.setText("Disabled")
        self.sec_status_lbl.setStyleSheet("color: #777777;")
        self.remove_pin_btn.setVisible(False)
        self.lock_sb_btn.setVisible(False)

    def go_to_settings(self):
        total_words = sum(len(e.get("content", "").split()) for e in self.entries)
        pinned_count = sum(1 for e in self.entries if e.get("pinned", False))
        self.settings_stats_lbl.setText(f"󰈙 {len(self.entries)} notes  ·  󰤱 {pinned_count} pinned  ·  󱌒 {total_words} words")
        self.stack.setCurrentIndex(2)

    def go_to_workspace(self):
        self.stack.setCurrentIndex(1)

    def load_entries(self):
        """Load encrypted binary entries from disk on startup."""
        if DATA_PATH.exists():
            try:
                raw = DATA_PATH.read_bytes()
                decrypted = decrypt_data(raw)
                self.entries = json.loads(decrypted)
            except Exception as e:
                print("Load error:", e)
                self.entries = []
        if not self.entries:
            self.entries = [{
                "id": str(datetime.now().timestamp()),
                "date": date.today().isoformat(),
                "time": datetime.now().strftime("%I:%M %p"),
                "title": "Welcome to Note",
                "content": "# Welcome to Note\n\nWrite anything. It saves automatically.\n\n- Browse themes in Settings\n- Search by title or #tag\n- Zen Focus for distraction-free writing",
                "tags": "welcome"
            }]
            self.save_vault()
        self._rebuild_entry_index()
        self.refresh_entries_list()
        today = date.today().isoformat()
        today_entry = next((e for e in self.entries if e["date"] == today), None)
        if today_entry:
            self.load_entry(today_entry["id"])
        elif self.entries:
            self.load_entry(self.entries[0]["id"])
        self.update_calendar_highlights()

    def _rebuild_entry_index(self):
        """O(1) lookup dict: entry_id -> entry dict."""
        self._entry_index = {e["id"]: e for e in self.entries}


    def update_calendar_highlights(self):
        meta = THEME_META.get(self.current_theme, THEME_META["Void (Dark)"])
        format_highlight = QTextCharFormat()
        format_highlight.setBackground(QColor(meta["acc"]))
        format_highlight.setForeground(QColor(meta["bg"]))
        format_highlight.setFontWeight(QFont.Bold)

        dates_with_entries = {e["date"] for e in self.entries}
        for d_str in dates_with_entries:
            try:
                qd = QDate.fromString(d_str, Qt.ISODate)
                self.calendar.setDateTextFormat(qd, format_highlight)
            except Exception:
                pass

    def on_date_selected(self, qdate):
        d_str = qdate.toString(Qt.ISODate)
        self.active_date_str = d_str
        self.refresh_entries_list(filter_date=d_str)
        matched = [e for e in self.entries if e["date"] == d_str]
        if matched:
            self.load_entry(matched[0]["id"])

    def toggle_pin_active_entry(self):
        if not self.active_id:
            return
        entry = self._entry_index.get(self.active_id)
        if entry:
            entry["pinned"] = not entry.get("pinned", False)
            self.save_vault()
            self.update_pin_button_state(entry.get("pinned", False))
            self.refresh_entries_list(filter_date=self.active_date_str)
            # Reselect the active entry in the reordered list
            for i in range(self.entry_list.count()):
                it = self.entry_list.item(i)
                if it.data(Qt.UserRole) == self.active_id:
                    self.entry_list.setCurrentItem(it)
                    break

    def update_pin_button_state(self, is_pinned: bool):
        meta = THEME_META.get(self.current_theme, THEME_META["Void (Dark)"])
        if is_pinned:
            self.pin_btn.setText("󰤱 Pinned")
            self.pin_btn.setStyleSheet(f"color: {meta['bg']}; background-color: {meta['acc']}; border: 1px solid {meta['acc']};")
        else:
            self.pin_btn.setText("󰤰 Pin")
            self.pin_btn.setStyleSheet("")

    def on_search_filter(self, text):
        query = text.strip().lower()
        if not query:
            self.refresh_entries_list(filter_date=self.active_date_str)
            return

        self.entry_list.clear()
        target_list = sorted(self.entries, key=lambda e: (not e.get("pinned", False), e.get("date", "")), reverse=False)
        for e in target_list:
            title = e.get("title", "").lower()
            content = e.get("content", "").lower()
            tags = e.get("tags", "").lower()
            if query in title or query in content or query in tags:
                preview_title = e.get('title') or 'Untitled Thought'
                pin_badge = "󰤱 " if e.get("pinned", False) else "󱞪 "
                item = QListWidgetItem(f"{pin_badge}{preview_title}\n󰃭 {e.get('date')} · 󱑂 {e.get('time')}")
                item.setData(Qt.UserRole, e["id"])
                self.entry_list.addItem(item)

    def on_entry_selected(self, item):
        entry_id = item.data(Qt.UserRole)
        if entry_id:
            self.load_entry(entry_id)

    def refresh_entries_list(self, filter_date=None):
        self.entry_list.clear()
        # Pinned entries come first, then sorted by insertion order/date
        target_list = [e for e in self.entries if not filter_date or e["date"] == filter_date]
        target_list.sort(key=lambda e: (not e.get("pinned", False)))
        for e in target_list:
            preview_title = e.get('title') or 'Untitled Thought'
            pin_badge = "󰤱 " if e.get("pinned", False) else "󱞪 "
            item = QListWidgetItem(f"{pin_badge}{preview_title}\n󰃭 {e.get('date')} · 󱑂 {e.get('time')}")
            item.setData(Qt.UserRole, e["id"])
            self.entry_list.addItem(item)

    def create_entry(self):
        d_str = self.calendar.selectedDate().toString(Qt.ISODate)
        new_e = {
            "id": str(datetime.now().timestamp()),
            "date": d_str,
            "time": datetime.now().strftime("%I:%M %p"),
            "title": "",
            "content": "",
            "tags": "",
            "mood": "focused",
            "pinned": False
        }
        self.entries.insert(0, new_e)
        self._entry_index[new_e["id"]] = new_e   # update index immediately
        self.save_vault()
        self.refresh_entries_list(filter_date=d_str)
        self.load_entry(new_e["id"])
        self.update_calendar_highlights()
        self.title_edit.setFocus()

    def delete_entry(self):
        if not self.active_id:
            return
        self._entry_index.pop(self.active_id, None)
        self.entries = [e for e in self.entries if e["id"] != self.active_id]
        self.save_vault()
        self.refresh_entries_list()
        self.update_calendar_highlights()
        if self.entries:
            self.load_entry(self.entries[0]["id"])
        else:
            self.title_edit.clear()
            self.tags_edit.clear()
            self.content_edit.clear()
            self.active_id = None
            self.update_pin_button_state(False)

    def load_entry(self, entry_id):
        self.active_id = entry_id
        entry = self._entry_index.get(entry_id)
        if entry:
            self.title_edit.blockSignals(True)
            self.tags_edit.blockSignals(True)
            self.content_edit.blockSignals(True)

            self.title_edit.setText(entry.get("title", ""))
            self.tags_edit.setText(entry.get("tags", ""))
            self.content_edit.setText(entry.get("content", ""))
            self.meta_lbl.setText(f"󰃭 {entry.get('date')} · 󱑂 {entry.get('time')}")
            self.update_word_count(entry.get("content", ""))
            self.update_pin_button_state(entry.get("pinned", False))

            self.title_edit.blockSignals(False)
            self.tags_edit.blockSignals(False)
            self.content_edit.blockSignals(False)

            # Sync active selection in the sidebar list
            for i in range(self.entry_list.count()):
                it = self.entry_list.item(i)
                if it.data(Qt.UserRole) == entry_id:
                    self.entry_list.setCurrentItem(it)
                    break

    def on_content_modified(self):
        if not self.active_id:
            return
        entry = self._entry_index.get(self.active_id)
        if entry:
            entry["title"]   = self.title_edit.text()
            entry["tags"]    = self.tags_edit.text()
            entry["content"] = self.content_edit.toPlainText()
            self.update_word_count(entry["content"])
            
            # Live update sidebar entry item label if active
            current_item = self.entry_list.currentItem()
            if current_item and current_item.data(Qt.UserRole) == self.active_id:
                preview_title = entry.get('title') or 'Untitled Thought'
                pin_badge = "󰤱 " if entry.get("pinned", False) else "󱞪 "
                current_item.setText(f"{pin_badge}{preview_title}\n󰃭 {entry.get('date')} · 󱑂 {entry.get('time')}")
            
            # Debounce: reset timer on keystroke
            self._save_timer.start()

    def update_word_count(self, text):
        words = len(text.strip().split()) if text.strip() else 0
        read_time = max(1, round(words / 200)) if words > 0 else 0
        self.word_lbl.setText(f"{words} words · {read_time} min read")

    def closeEvent(self, event):
        """Ensure all edits are immediately flushed to disk before closing."""
        if self._save_timer.isActive():
            self._save_timer.stop()
            self.save_vault()
        event.accept()

    def toggle_zen(self):
        self.is_zen = not self.is_zen
        self.sidebar.setVisible(not self.is_zen)
        self.zen_btn.setText("󰈊 Full View" if self.is_zen else "󰈈 Zen Focus")


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Note")
    app.setDesktopFileName("note.desktop")
    icon_path = Path.home() / ".local" / "share" / "icons" / "note.png"
    if icon_path.exists():
        app.setWindowIcon(QIcon(str(icon_path)))
    window = NoteApp()
    window.show()
    sys.exit(app.exec_())

if __name__ == "__main__":
    main()
