CONFIG_PATH = Path.home() / ".config" / "note" / "config.json"

# ─────────────────────────────────────────────────────────────────────────────
# MACHINE-KEY CRYPTO — no password, no prompt
# Key is derived from machine-id + a fixed app secret.
# File is opaque binary; only this app on this machine can read it.
# ─────────────────────────────────────────────────────────────────────────────
_APP_SECRET = b"note-gui::baanbhaba::v1::xK9#mP2@"

def _machine_key() -> bytes:
    """Derive a stable 32-byte key from machine-id + app secret. Instant, no PBKDF2."""
    machine_id = b"unknown"
    for mid_path in ["/etc/machine-id", "/var/lib/dbus/machine-id"]:
        try:
            machine_id = Path(mid_path).read_text().strip().encode()
            break
        except Exception:
            pass
    return hashlib.sha256(_APP_SECRET + machine_id).digest()

def _keystream(key: bytes, length: int) -> bytes:
    """32-byte block keystream — fast, no per-byte SHA256."""
    blocks = (length + 31) // 32
    ks = bytearray()
    for i in range(blocks):
        ks.extend(hashlib.sha256(key + i.to_bytes(4, "big")).digest())
    return bytes(ks[:length])

def encrypt_data(plain: str) -> bytes:
    key  = _machine_key()
    salt = os.urandom(16)
    ks   = _keystream(hashlib.sha256(key + salt).digest(), len(plain.encode()))
    enc  = bytes(a ^ b for a, b in zip(plain.encode(), ks))
    return salt + enc           # raw bytes: 16-byte salt + ciphertext

def decrypt_data(raw: bytes) -> str:
    key  = _machine_key()
    salt = raw[:16]
    enc  = raw[16:]
    ks   = _keystream(hashlib.sha256(key + salt).digest(), len(enc))
    return bytes(a ^ b for a, b in zip(enc, ks)).decode()


# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
def load_config() -> dict:
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {"theme": "Void (Dark)"}

def save_config(cfg: dict):
    try:
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with open(CONFIG_PATH, "w") as f:
            json.dump(cfg, f, indent=2)
    except Exception as e:
        print("Config save error:", e)

