# ─────────────────────────────────────────────────────────────────────────────
# CROSS-PLATFORM STORAGE PATHS (Windows, Linux, macOS, Android/Termux)
# ─────────────────────────────────────────────────────────────────────────────
def get_app_data_dir() -> Path:
    system = platform.system()
    if system == "Windows":
        app_data = os.environ.get("APPDATA")
        base = Path(app_data) if app_data else Path.home() / "AppData" / "Roaming"
        target = base / "Note"
    elif system == "Darwin":
        target = Path.home() / "Library" / "Application Support" / "Note"
    else:  # Linux & Android (Termux)
        target = Path.home() / ".local" / "share" / "note"
    target.mkdir(parents=True, exist_ok=True)
    return target

def get_app_config_dir() -> Path:
    system = platform.system()
    if system == "Windows":
        app_data = os.environ.get("LOCALAPPDATA") or os.environ.get("APPDATA")
        base = Path(app_data) if app_data else Path.home() / "AppData" / "Local"
        target = base / "Note"
    elif system == "Darwin":
        target = Path.home() / "Library" / "Preferences" / "Note"
    else:  # Linux & Android (Termux)
        target = Path.home() / ".config" / "note"
    target.mkdir(parents=True, exist_ok=True)
    return target

DATA_PATH   = get_app_data_dir() / ".note_data"
CONFIG_PATH = get_app_config_dir() / "config.json"

# ─────────────────────────────────────────────────────────────────────────────
# CROSS-PLATFORM MACHINE CRYPTO — no password, zero friction
# Derives stable 32-byte key from hardware GUID / machine-id on Windows, Linux, Mac, Android
# ─────────────────────────────────────────────────────────────────────────────
_APP_SALT = b"note-app::journal-vault::v1::auth-entropy-99x"

def _machine_key() -> bytes:
    """Derive a stable 32-byte key from hardware UUID/Machine-ID. Cross-platform."""
    machine_id = b""
    system = platform.system()
    
    if system == "Windows":
        try:
            import winreg
            with winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\Microsoft\Cryptography") as key:
                machine_id = winreg.QueryValueEx(key, "MachineGuid")[0].encode()
        except Exception:
            pass
    elif system == "Darwin":
        try:
            import subprocess
            out = subprocess.check_output(["ioreg", "-rd1", "-c", "IOPlatformExpertDevice"]).decode()
            for line in out.splitlines():
                if "IOPlatformUUID" in line:
                    machine_id = line.split('"')[-2].encode()
                    break
        except Exception:
            pass
    else:  # Linux & Android
        for mid_path in ["/etc/machine-id", "/var/lib/dbus/machine-id"]:
            try:
                content = Path(mid_path).read_text().strip()
                if content:
                    machine_id = content.encode()
                    break
            except Exception:
                pass
                
    if not machine_id:
        # Universal fallback using node identity + username
        import getpass, socket, uuid
        machine_id = f"{getpass.getuser()}@{socket.gethostname()}::{uuid.getnode()}".encode()
        
    return hashlib.sha256(_APP_SALT + machine_id).digest()

def _keystream(key: bytes, length: int) -> bytes:
    """32-byte block keystream — fast, no per-byte SHA256."""
    blocks = (length + 31) // 32
    ks = bytearray()
    for i in range(blocks):
        ks.extend(hashlib.sha256(key + i.to_bytes(4, "big")).digest())
    return bytes(ks[:length])

def encrypt_data(plain: str) -> bytes:
    key  = _machine_key()
    salt = os.urandom(16)
    ks   = _keystream(hashlib.sha256(key + salt).digest(), len(plain.encode()))
    enc  = bytes(a ^ b for a, b in zip(plain.encode(), ks))
    return salt + enc           # raw bytes: 16-byte salt + ciphertext

def decrypt_data(raw: bytes) -> str:
    key  = _machine_key()
    salt = raw[:16]
    enc  = raw[16:]
    ks   = _keystream(hashlib.sha256(key + salt).digest(), len(enc))
    return bytes(a ^ b for a, b in zip(enc, ks)).decode()


# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
def load_config() -> dict:
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {"theme": "Void (Dark)"}

def save_config(cfg: dict):
    try:
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with open(CONFIG_PATH, "w") as f:
            json.dump(cfg, f, indent=2)
    except Exception as e:
        print("Config save error:", e)

