        /* ScrollArea */
        QScrollArea {{ border: none; background: transparent; }}
        QScrollArea > QWidget > QWidget {{ background: transparent; }}

        /* Frame utility */
        QFrame#Divider {{ background: {t['border']}; max-height: 1px; }}
        QFrame#Card {{
            background: {t['card']};
            border: 1px solid {t['border']};
            border-radius: {r};
        }}
    """

# ─────────────────────────────────────────────────────────────────────────────
# THEME CARD — Visual preview card with gradient preview strip + metadata
# ─────────────────────────────────────────────────────────────────────────────
class ThemeCard(QFrame):
    def __init__(self, name, theme, on_click):
        super().__init__()
        self.name = name
        self.theme = theme
        self.on_click = on_click
        self.is_active = False
        self.setCursor(QCursor(Qt.PointingHandCursor))
        self.setFixedHeight(160)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self._build_ui()
        self._apply_style(active=False)

    def _build_ui(self):
        t = self.theme
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        # ── Top Colour Preview Strip (gradient of the palette)
        self.strip = ColorStrip(t["preview_bars"])
        self.strip.setFixedHeight(52)
        outer.addWidget(self.strip)

        # ── Bottom Metadata Row
        meta = QWidget()
        meta.setObjectName("ThemeMeta")
        meta_l = QVBoxLayout(meta)
        meta_l.setContentsMargins(14, 10, 14, 12)
        meta_l.setSpacing(4)

        # Name + Active badge row
        top_row = QHBoxLayout()
        self.name_lbl = QLabel(self.name)
        self.name_lbl.setFont(QFont(FONT_UI, 12, QFont.DemiBold))
        self.name_lbl.setStyleSheet(f"color: {t['fg']}; border: none; background: transparent;")
        top_row.addWidget(self.name_lbl)
        top_row.addStretch()

        self.badge = QLabel()
        self.badge.setFont(QFont(FONT_UI, 9, QFont.Medium))
        self.badge.setFixedHeight(20)
        top_row.addWidget(self.badge)
        meta_l.addLayout(top_row)

        # Tag (category) and desc
        self.tag_lbl = QLabel(t["tag"])
        self.tag_lbl.setFont(QFont(FONT_UI, 9))
        self.tag_lbl.setStyleSheet(f"color: {t['fg_muted']}; border: none; background: transparent;")
        meta_l.addWidget(self.tag_lbl)

        self.desc_lbl = QLabel(t["desc"])
        self.desc_lbl.setFont(QFont(FONT_UI, 9))
        self.desc_lbl.setStyleSheet(f"color: {t['fg_muted']}; border: none; background: transparent;")
        self.desc_lbl.setWordWrap(True)
        meta_l.addWidget(self.desc_lbl)

        outer.addWidget(meta)

    def _apply_style(self, active=False):
        self.is_active = active
        t = self.theme
        if active:
            border_col = t["border_strong"]
            border_w   = "2px"
            bg_meta    = t["card_hover"]
            self.badge.setText("✓  Active")
            self.badge.setStyleSheet(
                f"color: {t['acc_fg']}; background: {t['acc']};"
                f" border-radius: 6px; padding: 1px 8px; font-weight: 700;"
            )
        else:
            border_col = t["border"]
            border_w   = "1px"
            bg_meta    = t["card"]
            self.badge.setText("")
            self.badge.setStyleSheet("border: none; background: transparent;")

        self.setStyleSheet(f"""
            ThemeCard {{
                background: {bg_meta};
                border: {border_w} solid {border_col};
                border-radius: 12px;
            }}
            ThemeCard:hover {{
                border: 2px solid {t['border_strong']};
                background: {t['card_hover']};
            }}
            QWidget#ThemeMeta {{
                background: {bg_meta};
                border-radius: 0 0 12px 12px;
            }}
        """)
        # make strip corners round too
        self.strip.setStyleSheet(
            "border-radius: 10px 10px 0 0;" if not active else
            "border-radius: 8px 8px 0 0;"
        )

    def mousePressEvent(self, e):
        self.on_click(self.name)
        super().mousePressEvent(e)

    def set_active(self, active: bool):
        self._apply_style(active)


# Color strip widget that paints a horizontal gradient across palette swatches
class ColorStrip(QWidget):
    def __init__(self, colors):
        super().__init__()
        self.colors = colors

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        w = self.width()
        h = self.height()
        n = len(self.colors)
        if n == 0: return
        swatch_w = w / n
        for i, hex_c in enumerate(self.colors):
            c = QColor(hex_c)
            painter.fillRect(int(i * swatch_w), 0, int(swatch_w) + 1, h, c)


# ─────────────────────────────────────────────────────────────────────────────
# MAIN APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
class NoteApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Note — Zero-Knowledge Journal")
        self.setMinimumSize(960, 660)
        self.resize(1160, 760)

        self.pin = ""
        self.entries = []
        self.active_id = None
        self.is_zen = False
        self.active_date_str = date.today().isoformat()

        self.config = load_config()
        self.current_theme = self.config.get("theme", "Void")
        if self.current_theme not in THEMES:
            self.current_theme = "Void"

        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)

        self._init_lock_screen()
        self._init_workspace()
        self._init_settings()

        self.apply_theme(self.current_theme)
        self.stack.setCurrentIndex(0)

    # ── THEME APPLICATION ──────────────────────────────────────────────────
    def apply_theme(self, name):
        if name not in THEMES: return
        self.current_theme = name
        self.config["theme"] = name
        save_config(self.config)
        self.setStyleSheet(generate_stylesheet(name))
        self._sync_lock_theme(name)
        if hasattr(self, "theme_cards"):
            for n, c in self.theme_cards.items():
                c.set_active(n == name)

    def _sync_lock_theme(self, name):
        t = THEMES.get(name, THEMES["Void"])
        self.lock_widget.setStyleSheet(f"background: {t['bg']};")
        self.time_lbl.setStyleSheet(
            f"color: {t['fg']}; border: none; background: transparent; letter-spacing: -3px;"
        )
        self.date_sub.setStyleSheet(
            f"color: {t['fg_muted']}; border: none; background: transparent;"
        )
        r, g, b, a = t["glow"]
        self.lock_glow.setColor(QColor(r, g, b, a))
        self.lock_glow.setBlurRadius(48)
        self.pin_input.setStyleSheet(f"""
            QLineEdit {{
                background: {t['input_bg']};
                color: {t['fg']};
                border: 1px solid {t['border']};
                border-radius: {t['radius']};
                padding: 10px 18px;
                letter-spacing: 10px;
                font-size: 16px;
                font-family: '{FONT_MONO}', monospace;
            }}
            QLineEdit:focus {{
                border: 1px solid {t['border_strong']};
            }}
        """)
        self.auth_hint.setStyleSheet(
            f"color: {t['fg_muted']}; border: none; background: transparent; font-size: 11px;"
        )

    # ── LOCK SCREEN ────────────────────────────────────────────────────────
    def _init_lock_screen(self):
        self.lock_widget = QWidget()
        lv = QVBoxLayout(self.lock_widget)
        lv.setAlignment(Qt.AlignCenter)
        lv.setSpacing(0)
        lv.setContentsMargins(0, 0, 0, 0)

        # Spacer
        lv.addStretch(2)

        # Time
        self.time_lbl = QLabel()
        self.time_lbl.setAlignment(Qt.AlignCenter)
        self.time_lbl.setFont(QFont(FONT_UI, 82, QFont.Bold))
        lv.addWidget(self.time_lbl)

        # Date
        self.date_sub = QLabel()
        self.date_sub.setAlignment(Qt.AlignCenter)
        self.date_sub.setFont(QFont(FONT_UI, 13, QFont.Normal))
        lv.addWidget(self.date_sub)

        lv.addSpacing(48)

        # Passcode Pill
        self.pin_input = QLineEdit()
        self.pin_input.setEchoMode(QLineEdit.Password)
        self.pin_input.setPlaceholderText("Enter passcode")
        self.pin_input.setAlignment(Qt.AlignCenter)
        self.pin_input.setFixedSize(300, 52)

        self.lock_glow = QGraphicsDropShadowEffect()
        self.lock_glow.setOffset(0, 0)
        self.pin_input.setGraphicsEffect(self.lock_glow)
        self.pin_input.returnPressed.connect(self._handle_auth)

        pill_wrap = QHBoxLayout()
        pill_wrap.addStretch()
        pill_wrap.addWidget(self.pin_input)
        pill_wrap.addStretch()
        lv.addLayout(pill_wrap)

        lv.addSpacing(14)

        self.auth_hint = QLabel("AES-256 zero-knowledge vault  ·  press Enter")
        self.auth_hint.setAlignment(Qt.AlignCenter)
        self.auth_hint.setFont(QFont(FONT_UI, 10))
        lv.addWidget(self.auth_hint)

        lv.addStretch(3)

        self._clock_timer = QTimer(self)
        self._clock_timer.timeout.connect(self._tick_clock)
        self._clock_timer.start(1000)
        self._tick_clock()

        self.stack.addWidget(self.lock_widget)

    def _tick_clock(self):
        now = datetime.now()
        self.time_lbl.setText(now.strftime("%H:%M"))
        self.date_sub.setText(now.strftime("%A, %d %B").upper())

    def _shake(self, w):
        anim = QPropertyAnimation(w, b"pos")
        anim.setDuration(340)
        p = w.pos()
        for pct, dx in [(0.0,0),(0.1,-14),(0.3,14),(0.5,-9),(0.7,9),(0.9,-4),(1.0,0)]:
            anim.setKeyValueAt(pct, p + QPoint(dx, 0))
        anim.setEasingCurve(QEasingCurve.OutElastic)
        anim.start()
        self._shake_ref = anim

    def _fade_to(self, idx):
        eff = QGraphicsOpacityEffect(self.stack)
        self.stack.setGraphicsEffect(eff)
        a = QPropertyAnimation(eff, b"opacity")
        a.setDuration(200)
        a.setStartValue(0.0)
        a.setEndValue(1.0)
        a.setEasingCurve(QEasingCurve.OutCubic)
        self.stack.setCurrentIndex(idx)
        a.start()
        self._fade_ref = a

    def _handle_auth(self):
        pin = self.pin_input.text().strip()
        if len(pin) < 4:
            self.auth_hint.setText("Passcode must be ≥ 4 characters.")
            self._shake(self.pin_input)
            return
        if not VAULT_PATH.exists():
            self.pin = pin
            welcome = {
                "id": str(datetime.now().timestamp()),
                "date": date.today().isoformat(),
                "time": datetime.now().strftime("%I:%M %p"),
                "title": "Welcome to Note",
                "content": "# Welcome to Note\n\nYour thoughts live here — encrypted, minimal, yours.\n\n- Browse themes in Settings\n- Search entries by title or #tag\n- Toggle Zen Focus for distraction-free writing",
                "tags": "welcome"
            }
            self.entries = [welcome]
            self._save_vault()
            self._load_workspace()
        else:
            try:
                payload = json.load(open(VAULT_PATH))
                self.entries = json.loads(decrypt_string(payload, pin))
                self.pin = pin
                self._load_workspace()
            except:
                self.auth_hint.setText("Incorrect passcode — try again.")
                self._shake(self.pin_input)

