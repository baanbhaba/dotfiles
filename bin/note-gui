VAULT_PATH = Path.home() / ".local" / "share" / "note_vault.json"

def derive_key(pin: str, salt: bytes) -> bytes:
    return hashlib.pbkdf2_hmac('sha256', pin.encode(), salt, 100000)

def encrypt_string(plain: str, pin: str) -> dict:
    salt = os.urandom(16)
    key = derive_key(pin, salt)
    plain_bytes = plain.encode('utf-8')
    encrypted = bytearray()
    for i, b in enumerate(plain_bytes):
        k = hashlib.sha256(key + i.to_bytes(4, 'big')).digest()[0]
        encrypted.append(b ^ k)
    return {
        "salt": base64.b64encode(salt).decode('ascii'),
        "data": base64.b64encode(bytes(encrypted)).decode('ascii')
    }

def decrypt_string(payload: dict, pin: str) -> str:
    salt = base64.b64decode(payload["salt"])
    key = derive_key(pin, salt)
    cipher_bytes = base64.b64decode(payload["data"])
    decrypted = bytearray()
    for i, b in enumerate(cipher_bytes):
        k = hashlib.sha256(key + i.to_bytes(4, 'big')).digest()[0]
        decrypted.append(b ^ k)
    return decrypted.decode('utf-8')

class AestheticCalendarWidget(QFrame):
    def __init__(self, on_date_selected_callback):
        super().__init__()
        self.on_date_selected = on_date_selected_callback
        self.current_year = date.today().year
        self.current_month = date.today().month
        self.selected_date_str = date.today().isoformat()
        self.entry_dates = set()

        self.setMinimumSize(320, 260)
        self.setSizePolicy(QSizePolicy.Preferred, QSizePolicy.Fixed)

        self.setStyleSheet("""
            QFrame#AestheticCalendar {
                background-color: #0d0d0d;
                border: 1px solid #222222;
                border-radius: 12px;
            }
        """)
        self.setObjectName("AestheticCalendar")

        layout = QVBoxLayout(self)
        layout.setContentsMargins(14, 14, 14, 14)
        layout.setSpacing(8)

        # Header with Month/Year & Nav
        header = QHBoxLayout()
        header.setContentsMargins(0, 0, 0, 4)
        self.month_lbl = QLabel("")
        self.month_lbl.setFont(QFont("JetBrainsMono Nerd Font", 11, QFont.Bold))
        self.month_lbl.setStyleSheet("color: #ffb000; border: none; background: transparent;")
        header.addWidget(self.month_lbl)
        header.addStretch()

        prev_btn = QPushButton("󰁍")
        prev_btn.setFixedSize(28, 28)
        prev_btn.setCursor(QCursor(Qt.PointingHandCursor))
        prev_btn.setStyleSheet("""
            QPushButton {
                background-color: #141414;
                color: #ffb000;
                border: 1px solid #262626;
                border-radius: 6px;
                padding: 0px;
                font-size: 13px;
                font-weight: bold;
            }
            QPushButton:hover {
                background-color: #ffb000;
                color: #080808;
                border-color: #ffb000;
            }
        """)
        prev_btn.clicked.connect(self.prev_month)
        header.addWidget(prev_btn)

        next_btn = QPushButton("󰁔")
        next_btn.setFixedSize(28, 28)
        next_btn.setCursor(QCursor(Qt.PointingHandCursor))
        next_btn.setStyleSheet("""
            QPushButton {
                background-color: #141414;
                color: #ffb000;
                border: 1px solid #262626;
                border-radius: 6px;
                padding: 0px;
                font-size: 13px;
                font-weight: bold;
            }
            QPushButton:hover {
                background-color: #ffb000;
                color: #080808;
                border-color: #ffb000;
            }
        """)
        next_btn.clicked.connect(self.next_month)
        header.addWidget(next_btn)

        layout.addLayout(header)

        # Days of Week Row
        days_header = QHBoxLayout()
        days_header.setSpacing(2)
        days_header.setContentsMargins(0, 0, 0, 4)
        for day_name in ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"]:
            lbl = QLabel(day_name)
            lbl.setFont(QFont("JetBrainsMono Nerd Font", 8, QFont.Bold))
            lbl.setStyleSheet("color: #666666; border: none; background: transparent;")
            lbl.setAlignment(Qt.AlignCenter)
            days_header.addWidget(lbl)
        layout.addLayout(days_header)

        # 6x7 Days Grid Widget Container
        self.grid_container = QWidget()
        self.grid_container.setStyleSheet("background: transparent; border: none;")
        self.grid = QGridLayout(self.grid_container)
        self.grid.setSpacing(4)
        self.grid.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(self.grid_container)

        self.render_grid()

    def set_entry_dates(self, dates_set):
        self.entry_dates = dates_set
        self.render_grid()

    def prev_month(self):
        if self.current_month == 1:
            self.current_month = 12
            self.current_year -= 1
        else:
            self.current_month -= 1
        self.render_grid()

    def next_month(self):
        if self.current_month == 12:
            self.current_month = 1
            self.current_year += 1
        else:
            self.current_month += 1
        self.render_grid()

    def render_grid(self):
        while self.grid.count():
            item = self.grid.takeAt(0)
            widget = item.widget()
            if widget:
                widget.deleteLater()

        month_name = calendar.month_name[self.current_month]
        self.month_lbl.setText(f"󰃭 {month_name[:3].upper()} {self.current_year}")

        cal = calendar.Calendar(firstweekday=6)
        month_days = cal.monthdayscalendar(self.current_year, self.current_month)

        today_str = date.today().isoformat()

        for row_idx, week in enumerate(month_days):
            for col_idx, day_num in enumerate(week):
                if day_num == 0:
                    empty = QLabel("")
                    empty.setFixedSize(34, 28)
                    empty.setStyleSheet("border: none; background: transparent;")
                    self.grid.addWidget(empty, row_idx, col_idx)
                else:
                    d_str = f"{self.current_year:04d}-{self.current_month:02d}-{day_num:02d}"
                    is_selected = d_str == self.selected_date_str
                    is_today = d_str == today_str
                    has_entry = d_str in self.entry_dates

                    btn = QPushButton(str(day_num))
                    btn.setFixedSize(34, 28)
                    btn.setCursor(QCursor(Qt.PointingHandCursor))
                    btn.setFont(QFont("JetBrainsMono Nerd Font", 9))

                    if is_selected:
                        btn.setStyleSheet("""
                            QPushButton {
                                background-color: #ffb000;
                                color: #080808;
                                font-weight: bold;
                                border: none;
                                border-radius: 6px;
                            }
                        """)
                    elif is_today:
                        btn.setStyleSheet("""
                            QPushButton {
                                background-color: #1a1a1a;
                                color: #ffb000;
                                font-weight: bold;
                                border: 1px solid #ffb000;
                                border-radius: 6px;
                            }
                            QPushButton:hover {
                                background-color: #ffb000;
                                color: #080808;
                            }
                        """)
                    elif has_entry:
                        btn.setStyleSheet("""
                            QPushButton {
                                background-color: #141414;
                                color: #ffd166;
                                font-weight: bold;
                                border: 1px solid #8c9b32;
                                border-radius: 6px;
                            }
                            QPushButton:hover {
                                background-color: #ffb000;
                                color: #080808;
                            }
                        """)
                    else:
                        btn.setStyleSheet("""
                            QPushButton {
                                background-color: transparent;
                                color: #888888;
                                border: none;
                                border-radius: 6px;
                            }
                            QPushButton:hover {
                                background-color: #181818;
                                color: #ffffff;
                            }
                        """)

                    btn.clicked.connect(lambda _, ds=d_str: self.select_date(ds))
                    self.grid.addWidget(btn, row_idx, col_idx)

    def select_date(self, date_str):
        self.selected_date_str = date_str
        self.render_grid()
        self.on_date_selected(date_str)

