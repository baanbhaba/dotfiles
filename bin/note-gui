# ─────────────────────────────────────────────────────────────────────────────
# DYNAMIC STYLESHEET GENERATOR
# ─────────────────────────────────────────────────────────────────────────────
def generate_stylesheet(name: str) -> str:
    m = THEME_META.get(name, THEME_META["Void (Dark)"])
    return f"""
        QMainWindow {{ background-color: {m['bg']}; }}
        QWidget {{ background-color: {m['bg']}; color: {m['fg']}; font-family: 'JetBrainsMono Nerd Font', 'Inter', monospace; }}
        QWidget#Sidebar {{ background-color: {m['sidebar']}; border-right: 1px solid {m['border']}; }}
        QWidget#EditorArea {{ background-color: {m['bg']}; }}
        
        QLineEdit, QTextEdit {{
            background-color: {m['card']};
            color: {m['fg']};
            border: 1px solid {m['border']};
            border-radius: 8px;
            padding: 10px 14px;
            selection-background-color: {m['acc']};
            selection-color: {m['bg']};
        }}
        QLineEdit:focus, QTextEdit:focus {{
            border: 1px solid {m['acc']};
            background-color: {m['card_hover']};
        }}
        QTextEdit {{
            font-size: 14px;
            line-height: 1.6;
        }}
        
        QPushButton {{
            background-color: {m['card']};
            color: {m['acc']};
            border: 1px solid {m['btn_border']};
            border-radius: 8px;
            padding: 7px 14px;
            font-weight: bold;
        }}
        QPushButton:hover {{
            background-color: {m['acc']};
            color: {m['bg']};
            border-color: {m['acc']};
        }}
        QPushButton:pressed {{
            background-color: {m['sub']};
            color: {m['fg']};
        }}
        
        QListWidget {{
            background-color: {m['sidebar']};
            border: 1px solid {m['border']};
            border-radius: 8px;
            padding: 4px;
        }}
        QListWidget::item {{
            background-color: {m['card']};
            color: {m['fg']};
            margin-bottom: 6px;
            padding: 10px 12px;
            border-radius: 6px;
            border: 1px solid {m['border']};
        }}
        QListWidget::item:hover {{
            border: 1px solid {m['acc']};
            background-color: {m['card_hover']};
            color: {m['acc']};
        }}
        QListWidget::item:selected {{
            background-color: {m['acc']};
            color: {m['bg']};
            font-weight: bold;
        }}
        
        QCalendarWidget QWidget#qt_calendar_navigationbar {{ background-color: {m['card']}; }}
        QCalendarWidget QToolButton {{ color: {m['acc']}; background: transparent; border: none; font-weight: bold; }}
        QCalendarWidget QTableView {{
            background-color: {m['sidebar']};
            color: {m['fg']};
            selection-background-color: {m['acc']};
            selection-color: {m['bg']};
            font-weight: bold;
            gridline-color: {m['border']};
        }}
        QCalendarWidget QHeaderView::section {{
            background-color: {m['card']};
            color: {m['acc']};
            font-weight: bold;
        }}
        
        QSplitter::handle {{ background-color: {m['border']}; width: 3px; }}
        QSplitter::handle:hover {{ background-color: {m['acc']}; }}
        QScrollArea {{ border: none; background: transparent; }}
    """

# ─────────────────────────────────────────────────────────────────────────────
# KOKONUT / BKLIT UI THEME CARD COMPONENT WITH MINI VISUAL MOCKUP
# ─────────────────────────────────────────────────────────────────────────────
class MotionThemeCard(QFrame):
    def __init__(self, theme_name, meta, on_click_callback):
        super().__init__()
        self.theme_name = theme_name
        self.meta = meta
        self.on_click = on_click_callback
        self.setCursor(QCursor(Qt.PointingHandCursor))
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
        self.setObjectName("ThemePreviewCard")

        layout = QVBoxLayout(self)
        layout.setContentsMargins(14, 14, 14, 14)
        layout.setSpacing(10)

        # 1. Top Header Row: Name + Category Pill + Active Badge
        top_row = QHBoxLayout()
        self.title_lbl = QLabel(theme_name)
        self.title_lbl.setFont(QFont("JetBrainsMono Nerd Font", 10, QFont.Bold))
        self.title_lbl.setStyleSheet(f"color: {meta['fg']}; border: none; background: transparent;")
        top_row.addWidget(self.title_lbl)
        top_row.addStretch()

        self.badge_lbl = QLabel(meta["category"])
        self.badge_lbl.setFont(QFont("JetBrainsMono Nerd Font", 8, QFont.Bold))
        self.badge_lbl.setStyleSheet(f"""
            color: {meta['acc']};
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid {meta['btn_border']};
            border-radius: 6px;
            padding: 2px 6px;
        """)
        top_row.addWidget(self.badge_lbl)
        layout.addLayout(top_row)

        # 2. Visual Mini-Mockup (Canvas + Sidebar + Swatch Dots)
        mockup = QFrame()
        mockup.setFixedHeight(64)
        mockup.setStyleSheet(f"""
            QFrame {{
                background-color: {meta['bg']};
                border: 1px solid {meta['border']};
                border-radius: 8px;
            }}
        """)
        mock_layout = QHBoxLayout(mockup)
        mock_layout.setContentsMargins(6, 6, 6, 6)
        mock_layout.setSpacing(6)

        # Mini Sidebar
        mini_sb = QFrame()
        mini_sb.setFixedWidth(42)
        mini_sb.setStyleSheet(f"background-color: {meta['sidebar']}; border: 1px solid {meta['border']}; border-radius: 4px;")
        mock_layout.addWidget(mini_sb)

        # Mini Editor Area with 2 mock content lines + swatches
        mini_ed = QWidget()
        mini_ed_l = QVBoxLayout(mini_ed)
        mini_ed_l.setContentsMargins(4, 2, 4, 2)
        mini_ed_l.setSpacing(4)

        line1 = QFrame()
        line1.setFixedHeight(4)
        line1.setStyleSheet(f"background-color: {meta['acc']}; border-radius: 2px;")
        mini_ed_l.addWidget(line1)

        line2 = QFrame()
        line2.setFixedHeight(3)
        line2.setStyleSheet(f"background-color: {meta['card']}; border-radius: 1px;")
        mini_ed_l.addWidget(line2)

        # 4 Swatch Circles Row
        swatch_row = QHBoxLayout()
        swatch_row.setSpacing(4)
        for hex_col in meta.get("swatches", []):
            dot = QFrame()
            dot.setFixedSize(10, 10)
            dot.setStyleSheet(f"background-color: {hex_col}; border: 1px solid rgba(255,255,255,0.2); border-radius: 5px;")
            swatch_row.addWidget(dot)
        swatch_row.addStretch()
        mini_ed_l.addLayout(swatch_row)

        mock_layout.addWidget(mini_ed, 1)
        layout.addWidget(mockup)

        # 3. Descriptive Copy
        self.desc_lbl = QLabel(meta["desc"])
        self.desc_lbl.setWordWrap(True)
        self.desc_lbl.setFont(QFont("JetBrainsMono Nerd Font", 8))
        self.desc_lbl.setStyleSheet(f"color: {meta['sub']}; border: none; background: transparent; line-height: 1.3;")
        layout.addWidget(self.desc_lbl)

        self.apply_declarative_style(active=False)

    def mousePressEvent(self, event):
        self.on_click(self.theme_name)
        super().mousePressEvent(event)

    def apply_declarative_style(self, active=False):
        m = self.meta
        border_col = m["acc"] if active else m["border"]
        border_w = "2px" if active else "1px"
        bg_normal = m["card_hover"] if active else m["card"]
        
        if active:
            self.badge_lbl.setText("✓ ACTIVE")
            self.badge_lbl.setStyleSheet(f"color: {m['bg']}; background-color: {m['acc']}; border-radius: 6px; padding: 2px 6px; font-weight: 900;")
        else:
            self.badge_lbl.setText(m["category"])
            self.badge_lbl.setStyleSheet(f"color: {m['acc']}; background-color: rgba(255, 255, 255, 0.05); border: 1px solid {m['btn_border']}; border-radius: 6px; padding: 2px 6px;")

        self.setStyleSheet(f"""
            QFrame#ThemePreviewCard {{
                background-color: {bg_normal};
                border: {border_w} solid {border_col};
                border-radius: 12px;
            }}
            QFrame#ThemePreviewCard:hover {{
                background-color: {m['card_hover']};
                border: 2px solid {m['acc']};
            }}
        """)
# ─────────────────────────────────────────────────────────────────────────────
# ROBUST VIM MODAL EDITING ENGINE
# ─────────────────────────────────────────────────────────────────────────────
class VimTextEdit(QTextEdit):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.vim_enabled = False
        self.mode = "NORMAL"  # "NORMAL", "INSERT", "VISUAL", "VISUAL_LINE"
        self._cmd_buffer = ""
        self._find_char_pending = None  # ('f' or 't' or 'r', is_forward)
        self._yank_buffer = ""
        self._yank_is_line = False
        self._visual_anchor = 0
        self.on_mode_change = None  # callback(mode_str)

    def set_vim_enabled(self, enabled: bool):
        self.vim_enabled = enabled
        if not enabled:
            self.mode = "INSERT"
            self.setReadOnly(False)
            self.setCursorWidth(1)
        else:
            self.set_mode("NORMAL")

    def set_mode(self, mode: str):
        self.mode = mode
        cursor = self.textCursor()
        if mode == "NORMAL":
            self.setReadOnly(False)
            self.setCursorWidth(8)
            if cursor.hasSelection():
                cursor.clearSelection()
                self.setTextCursor(cursor)
        elif mode in ("VISUAL", "VISUAL_LINE"):
            self.setReadOnly(False)
            self.setCursorWidth(2)
        else:  # INSERT
            self.setReadOnly(False)
            self.setCursorWidth(1)
            if cursor.hasSelection():
                cursor.clearSelection()
                self.setTextCursor(cursor)
        
        self._cmd_buffer = ""
        self._find_char_pending = None
        if self.on_mode_change:
            self.on_mode_change(self.mode if self.vim_enabled else "")

    def keyPressEvent(self, event):
        if not self.vim_enabled:
            super().keyPressEvent(event)
            return

        key = event.key()
        text = event.text()
        modifiers = event.modifiers()
        cursor = self.textCursor()

        # ── Global Escape handling ──────────────────────────────────────────
        if key == Qt.Key_Escape or (modifiers == Qt.ControlModifier and (key == Qt.Key_BracketLeft or text == "[")):
            self.set_mode("NORMAL")
            event.accept()
            return

        # ── INSERT MODE ─────────────────────────────────────────────────────
        if self.mode == "INSERT":
            # Normal typing in insert mode
            super().keyPressEvent(event)
            return

        # ── PENDING CHAR SEARCH (f, t, r) ───────────────────────────────────
        if self._find_char_pending is not None and text:
            action, forward = self._find_char_pending
            self._find_char_pending = None
            if action == "r":
                cursor.deleteChar()
                cursor.insertText(text)
                cursor.movePosition(QTextCursor.Left)
                self.setTextCursor(cursor)
                event.accept()
                return
            elif action in ("f", "t"):
                line_text = cursor.block().text()
                col = cursor.positionInBlock()
                if forward:
                    target_col = line_text.find(text, col + 1)
                    if target_col != -1:
                        if action == "t":
                            target_col = max(col, target_col - 1)
                        cursor.setPosition(cursor.block().position() + target_col)
                        self.setTextCursor(cursor)
                else:
                    target_col = line_text.rfind(text, 0, col)
                    if target_col != -1:
                        if action == "t":
                            target_col = min(col, target_col + 1)
                        cursor.setPosition(cursor.block().position() + target_col)
                        self.setTextCursor(cursor)
                event.accept()
                return

        # ── REDO (Ctrl + R) in Normal Mode ──────────────────────────────────
        if modifiers == Qt.ControlModifier and key == Qt.Key_R:
            self.redo()
            event.accept()
            return

        # ── SCROLLING (Ctrl + D / Ctrl + U / Ctrl + E / Ctrl + Y) ────────────
        if modifiers == Qt.ControlModifier:
            if key == Qt.Key_D:
                cursor.movePosition(QTextCursor.Down, QTextCursor.MoveAnchor, 10)
                self.setTextCursor(cursor)
                event.accept()
                return
            elif key == Qt.Key_U:
                cursor.movePosition(QTextCursor.Up, QTextCursor.MoveAnchor, 10)
                self.setTextCursor(cursor)
                event.accept()
                return

        # ── VISUAL MODES (v, V) ─────────────────────────────────────────────
        if self.mode in ("VISUAL", "VISUAL_LINE"):
            if text == "v" and self.mode == "VISUAL":
                self.set_mode("NORMAL")
                event.accept()
                return
            elif text == "V" and self.mode == "VISUAL_LINE":
                self.set_mode("NORMAL")
                event.accept()
                return
            elif text in ("y", "d", "c", "x"):
                if cursor.hasSelection():
                    self._yank_buffer = cursor.selectedText().replace('\u2029', '\n')
                    self._yank_is_line = (self.mode == "VISUAL_LINE")
                    if text in ("d", "x", "c"):
                        cursor.removeSelectedText()
                    if text == "c":
                        self.set_mode("INSERT")
                    else:
                        self.set_mode("NORMAL")
                event.accept()
                return

            # Visual Motions
            if text in ("h", "j", "k", "l", "w", "b", "e", "0", "$", "G"):
                keep = QTextCursor.KeepAnchor
                if text == "h" or key == Qt.Key_Left:
                    cursor.movePosition(QTextCursor.Left, keep)
                elif text == "l" or key == Qt.Key_Right:
                    cursor.movePosition(QTextCursor.Right, keep)
                elif text == "j" or key == Qt.Key_Down:
                    cursor.movePosition(QTextCursor.Down, keep)
                elif text == "k" or key == Qt.Key_Up:
                    cursor.movePosition(QTextCursor.Up, keep)
                elif text == "w":
                    cursor.movePosition(QTextCursor.NextWord, keep)
                elif text == "b":
                    cursor.movePosition(QTextCursor.PreviousWord, keep)
                elif text == "e":
                    cursor.movePosition(QTextCursor.EndOfWord, keep)
                elif text == "0":
                    cursor.movePosition(QTextCursor.StartOfLine, keep)
                elif text == "$":
                    cursor.movePosition(QTextCursor.EndOfLine, keep)
                elif text == "G":
                    cursor.movePosition(QTextCursor.End, keep)
                self.setTextCursor(cursor)
                event.accept()
                return

        # ── NORMAL MODE DISPATCH ────────────────────────────────────────────
        # Mode Transitions
        if text == "i":
            self.set_mode("INSERT")
            event.accept()
            return
        elif text == "I":
            cursor.movePosition(QTextCursor.StartOfLine)
            self.setTextCursor(cursor)
            self.set_mode("INSERT")
            event.accept()
            return
        elif text == "a":
            if not cursor.atBlockEnd():
                cursor.movePosition(QTextCursor.Right)
            self.setTextCursor(cursor)
            self.set_mode("INSERT")
            event.accept()
            return
        elif text == "A":
            cursor.movePosition(QTextCursor.EndOfLine)
            self.setTextCursor(cursor)
            self.set_mode("INSERT")
            event.accept()
            return
        elif text == "o":
            cursor.movePosition(QTextCursor.EndOfLine)
            cursor.insertText("\n")
            self.setTextCursor(cursor)
            self.set_mode("INSERT")
            event.accept()
            return
        elif text == "O":
            cursor.movePosition(QTextCursor.StartOfLine)
            cursor.insertText("\n")
            cursor.movePosition(QTextCursor.Up)
            cursor.movePosition(QTextCursor.StartOfLine)
            self.setTextCursor(cursor)
            self.set_mode("INSERT")
            event.accept()
            return
        elif text == "s":
            cursor.deleteChar()
            self.setTextCursor(cursor)
            self.set_mode("INSERT")
            event.accept()
            return
        elif text == "C":
            cursor.movePosition(QTextCursor.EndOfLine, QTextCursor.KeepAnchor)
            cursor.removeSelectedText()
            self.set_mode("INSERT")
            event.accept()
            return
        elif text == "D":
            cursor.movePosition(QTextCursor.EndOfLine, QTextCursor.KeepAnchor)
            cursor.removeSelectedText()
            self.setTextCursor(cursor)
            event.accept()
            return
        elif text == "v":
            self.set_mode("VISUAL")
            self._visual_anchor = cursor.position()
            cursor.movePosition(QTextCursor.Right, QTextCursor.KeepAnchor)
            self.setTextCursor(cursor)
            event.accept()
            return
        elif text == "V":
            self.set_mode("VISUAL_LINE")
            cursor.movePosition(QTextCursor.StartOfLine)
            cursor.movePosition(QTextCursor.EndOfLine, QTextCursor.KeepAnchor)
            self.setTextCursor(cursor)
            event.accept()
            return

        # ── Single-key Motions ──────────────────────────────────────────────
        if text == "h" or key == Qt.Key_Left:
            if not cursor.atBlockStart():
                cursor.movePosition(QTextCursor.Left)
        elif text == "l" or key == Qt.Key_Right:
            if not cursor.atBlockEnd():
                cursor.movePosition(QTextCursor.Right)
        elif text == "j" or key == Qt.Key_Down:
            cursor.movePosition(QTextCursor.Down)
        elif text == "k" or key == Qt.Key_Up:
            cursor.movePosition(QTextCursor.Up)
        elif text == "w":
            cursor.movePosition(QTextCursor.NextWord)
        elif text == "b":
            cursor.movePosition(QTextCursor.PreviousWord)
        elif text == "e":
            cursor.movePosition(QTextCursor.EndOfWord)
        elif text == "0" or key == Qt.Key_Home:
            cursor.movePosition(QTextCursor.StartOfLine)
        elif text == "^":
            cursor.movePosition(QTextCursor.StartOfLine)
            while not cursor.atBlockEnd() and cursor.block().text()[cursor.positionInBlock()].isspace():
                cursor.movePosition(QTextCursor.Right)
        elif text == "$" or key == Qt.Key_End:
            cursor.movePosition(QTextCursor.EndOfLine)
        elif text == "G":
            cursor.movePosition(QTextCursor.End)
        elif text == "x" or key == Qt.Key_Delete:
            cursor.deleteChar()
        elif text == "u":
            self.undo()
            event.accept()
            return

        # Character searches / replaces
        elif text in ("f", "t", "F", "T", "r"):
            self._find_char_pending = (text.lower(), text in ("f", "t", "r"))
            event.accept()
            return

        # ── Paste (p / P) ───────────────────────────────────────────────────
        elif text == "p":
            if self._yank_buffer:
                if self._yank_is_line:
                    cursor.movePosition(QTextCursor.EndOfLine)
                    cursor.insertText("\n" + self._yank_buffer)
                else:
                    cursor.movePosition(QTextCursor.Right)
                    cursor.insertText(self._yank_buffer)
                self.setTextCursor(cursor)
            event.accept()
            return
        elif text == "P":
            if self._yank_buffer:
                if self._yank_is_line:
                    cursor.movePosition(QTextCursor.StartOfLine)
                    cursor.insertText(self._yank_buffer + "\n")
                    cursor.movePosition(QTextCursor.Up)
                else:
                    cursor.insertText(self._yank_buffer)
                self.setTextCursor(cursor)
            event.accept()
            return

        # ── Multi-key combo commands (dd, dw, yy, cc, cw, gg) ───────────────
        elif text in ("d", "c", "y", "g"):
            if self._cmd_buffer == "d" and text == "d":
                # dd: cut entire line
                cursor.movePosition(QTextCursor.StartOfLine)
                cursor.movePosition(QTextCursor.Down, QTextCursor.KeepAnchor)
                self._yank_buffer = cursor.selectedText().replace('\u2029', '\n').rstrip('\n')
                self._yank_is_line = True
                cursor.removeSelectedText()
                self._cmd_buffer = ""
            elif self._cmd_buffer == "y" and text == "y":
                # yy: yank entire line
                cursor.movePosition(QTextCursor.StartOfLine)
                cursor.movePosition(QTextCursor.EndOfLine, QTextCursor.KeepAnchor)
                self._yank_buffer = cursor.selectedText()
                self._yank_is_line = True
                cursor.clearSelection()
                self._cmd_buffer = ""
            elif self._cmd_buffer == "c" and text == "c":
                # cc: change entire line
                cursor.movePosition(QTextCursor.StartOfLine)
                cursor.movePosition(QTextCursor.EndOfLine, QTextCursor.KeepAnchor)
                cursor.removeSelectedText()
                self.set_mode("INSERT")
                self._cmd_buffer = ""
                event.accept()
                return
            elif self._cmd_buffer == "d" and text == "w":
                # dw: delete word
                cursor.movePosition(QTextCursor.NextWord, QTextCursor.KeepAnchor)
                cursor.removeSelectedText()
                self._cmd_buffer = ""
            elif self._cmd_buffer == "c" and text == "w":
                # cw: change word
                cursor.movePosition(QTextCursor.EndOfWord, QTextCursor.KeepAnchor)
                cursor.removeSelectedText()
                self.set_mode("INSERT")
                self._cmd_buffer = ""
                event.accept()
                return
            elif self._cmd_buffer == "g" and text == "g":
                # gg: jump to start
                cursor.movePosition(QTextCursor.Start)
                self._cmd_buffer = ""
            else:
                self._cmd_buffer = text
                event.accept()
                return
        else:
            self._cmd_buffer = ""
            event.accept()
            return

        self._cmd_buffer = ""
        self.setTextCursor(cursor)
        event.accept()


# ─────────────────────────────────────────────────────────────────────────────
# MAIN APPLICATION CONTROLLER
# ─────────────────────────────────────────────────────────────────────────────
class NoteApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Note")
        self.setWindowIcon(QIcon(str(Path.home() / ".local" / "share" / "icons" / "note.png")))
        self.setMinimumSize(960, 660)
        self.resize(1140, 750)
        self.entries = []
        self.active_id = None
        self.is_zen = False
        self.active_date_str = date.today().isoformat()
        self._entry_index = {}   # id → entry dict

        self.config = load_config()
        self.current_theme = self.config.get("theme", "Void (Dark)")
        if self.current_theme not in THEME_META:
            self.current_theme = "Void (Dark)"

        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)

        # Debounced autosave — writes to disk 800ms after last keystroke
        self._save_timer = QTimer(self)
        self._save_timer.setSingleShot(True)
        self._save_timer.setInterval(800)
        self._save_timer.timeout.connect(self.save_vault)

        self.init_main_workspace()   # index 0
        self.init_settings_page()    # index 1

        self.apply_theme(self.current_theme)
        self.load_entries()

    def apply_theme(self, theme_name):
        if theme_name in THEME_META:
            self.current_theme = theme_name
            self.config["theme"] = theme_name
            save_config(self.config)
            
            self.setStyleSheet(generate_stylesheet(theme_name))

            if hasattr(self, 'theme_cards'):
                for name, card in self.theme_cards.items():
                    card.apply_declarative_style(active=(name == theme_name))

            self.style_vim_card()


    def save_vault(self):
        try:
            DATA_PATH.parent.mkdir(parents=True, exist_ok=True)
            raw = encrypt_data(json.dumps(self.entries))
            DATA_PATH.write_bytes(raw)
        except Exception as e:
            print("Save error:", e)

