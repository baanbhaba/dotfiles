def generate_stylesheet(name: str) -> str:
    m = THEME_META.get(name, THEME_META["Charcoal Amber (Dark)"])
    return f"""
        QMainWindow {{ background-color: {m['bg']}; }}
        QWidget {{ background-color: {m['bg']}; color: {m['fg']}; font-family: 'JetBrainsMono Nerd Font', monospace; }}
        QWidget#Sidebar {{ background-color: {m['sidebar']}; border-right: 1px solid {m['border']}; }}
        QWidget#EditorArea {{ background-color: {m['bg']}; }}
        
        QLineEdit, QTextEdit {{
            background-color: {m['card']};
            color: {m['fg']};
            border: 1px solid {m['border']};
            border-radius: 8px;
            padding: 10px;
            selection-background-color: {m['acc']};
            selection-color: {m['bg']};
        }}
        QLineEdit:focus, QTextEdit:focus {{
            border: 1px solid {m['acc']};
            background-color: {m['card']};
        }}
        QTextEdit {{
            font-size: 14px;
            line-height: 1.5;
        }}
        
        QPushButton {{
            background-color: {m['card']};
            color: {m['acc']};
            border: 1px solid {m['border']};
            border-radius: 8px;
            padding: 8px 14px;
            font-weight: bold;
        }}
        QPushButton:hover {{
            background-color: {m['acc']};
            color: {m['bg']};
            border-color: {m['acc']};
        }}
        
        QListWidget {{
            background-color: {m['sidebar']};
            border: 1px solid {m['border']};
            border-radius: 8px;
            padding: 4px;
        }}
        QListWidget::item {{
            background-color: {m['card']};
            color: {m['fg']};
            margin-bottom: 6px;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid {m['border']};
        }}
        QListWidget::item:hover {{
            border: 1px solid {m['acc']};
            color: {m['acc']};
        }}
        QListWidget::item:selected {{
            background-color: {m['acc']};
            color: {m['bg']};
            font-weight: bold;
        }}
        
        QCalendarWidget QWidget#qt_calendar_navigationbar {{ background-color: {m['card']}; }}
        QCalendarWidget QToolButton {{ color: {m['acc']}; background: transparent; border: none; font-weight: bold; }}
        QCalendarWidget QTableView {{
            background-color: {m['sidebar']};
            color: {m['fg']};
            selection-background-color: {m['acc']};
            selection-color: {m['bg']};
            font-weight: bold;
            gridline-color: {m['border']};
        }}
        QCalendarWidget QHeaderView::section {{
            background-color: {m['card']};
            color: {m['acc']};
            font-weight: bold;
        }}
        
        QSplitter::handle {{ background-color: {m['border']}; width: 4px; }}
        QSplitter::handle:hover {{ background-color: {m['acc']}; }}
        QScrollArea {{ border: none; background: transparent; }}
    """

class NoteApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Note")
        self.setMinimumSize(950, 650)
        self.resize(1120, 740)
        self.pin = ""
        self.entries = []
        self.active_id = None
        self.is_zen = False
        self.active_date_str = date.today().isoformat()
        
        self.config = load_config()
        self.current_theme = self.config.get("theme", "Charcoal Amber (Dark)")
        if self.current_theme not in THEME_META:
            self.current_theme = "Charcoal Amber (Dark)"

        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)

        self.init_lock_screen()
        self.init_main_workspace()
        self.init_settings_page()

        self.apply_theme(self.current_theme)
        self.stack.setCurrentIndex(0)

    def apply_theme(self, theme_name):
        if theme_name in THEME_META:
            self.current_theme = theme_name
            self.config["theme"] = theme_name
            save_config(self.config)
            
            # Apply dynamic harmonic stylesheet
            self.setStyleSheet(generate_stylesheet(theme_name))
            self.sync_lock_screen_theme(theme_name)
            
            if hasattr(self, 'theme_cards'):
                for name, card in self.theme_cards.items():
                    is_active = (name == theme_name)
                    card.setProperty("active", is_active)
                    card.style().unpolish(card)
                    card.style().polish(card)

    def sync_lock_screen_theme(self, theme_name):
        meta = THEME_META.get(theme_name, THEME_META["Charcoal Amber (Dark)"])
        self.lock_widget.setStyleSheet(f"background-color: {meta['bg']};")
        self.time_lbl.setStyleSheet(f"color: {meta['fg']}; border: none; background: transparent; letter-spacing: -2px;")
        self.date_lbl.setStyleSheet(f"color: {meta['sub']}; border: none; background: transparent; margin-top: -18px;")
        
        r, g, b, a = meta["glow"]
        self.lock_shadow.setColor(QColor(r, g, b, a))
        
        self.pin_input.setStyleSheet(f"""
            QLineEdit {{
                background-color: {meta['input_bg']};
                color: {meta['input_fg']};
                border: 2px solid {meta['border']};
                border-radius: {meta['pill_radius']};
                padding: 8px 16px;
                letter-spacing: 8px;
            }}
            QLineEdit:focus {{
                border: 2px solid {meta['acc']};
            }}
        """)
        self.auth_msg.setStyleSheet(f"color: {meta['sub']}; border: none; background: transparent;")

    def init_lock_screen(self):
        self.lock_widget = QWidget()
        layout = QVBoxLayout(self.lock_widget)
        layout.setAlignment(Qt.AlignCenter)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(24)

        # 1. Giant Hyprlock Digital Time
        self.time_lbl = QLabel("")
        self.time_lbl.setFont(QFont("JetBrainsMono Nerd Font", 68, QFont.Bold))
        self.time_lbl.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.time_lbl)

        # Date Label
        self.date_lbl = QLabel("")
        self.date_lbl.setFont(QFont("JetBrainsMono Nerd Font", 13))
        self.date_lbl.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.date_lbl)

        # Live Clock Timer
        self.clock_timer = QTimer(self)
        self.clock_timer.timeout.connect(self.update_lock_clock)
        self.clock_timer.start(1000)
        self.update_lock_clock()

        # 2. Hyprlock Input Pill with Glow Effect
        is_setup = not VAULT_PATH.exists()
        self.pin_input = QLineEdit()
        self.pin_input.setEchoMode(QLineEdit.Password)
        self.pin_input.setPlaceholderText("Create Passcode" if is_setup else "******")
        self.pin_input.setAlignment(Qt.AlignCenter)
        self.pin_input.setFixedSize(320, 56)
        self.pin_input.setFont(QFont("JetBrainsMono Nerd Font", 16, QFont.Bold))
        
        self.lock_shadow = QGraphicsDropShadowEffect(self)
        self.lock_shadow.setBlurRadius(35)
        self.lock_shadow.setOffset(0, 0)
        self.pin_input.setGraphicsEffect(self.lock_shadow)
        
        self.pin_input.returnPressed.connect(self.handle_auth)
        layout.addWidget(self.pin_input, alignment=Qt.AlignCenter)

        self.auth_msg = QLabel("Press Enter to Unlock" if not is_setup else "Press Enter to Initialize Vault")
        self.auth_msg.setFont(QFont("JetBrainsMono Nerd Font", 9))
        self.auth_msg.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.auth_msg, alignment=Qt.AlignCenter)

        self.stack.addWidget(self.lock_widget)

    def update_lock_clock(self):
        now = datetime.now()
        self.time_lbl.setText(now.strftime("%I:%M"))
        self.date_lbl.setText(now.strftime("%A, %B %d").upper())

    def animate_view_transition(self, target_index):
        # Smooth Opacity Fade Animation
        opacity_effect = QGraphicsOpacityEffect(self.stack)
        self.stack.setGraphicsEffect(opacity_effect)
        self.anim = QPropertyAnimation(opacity_effect, b"opacity")
        self.anim.setDuration(180)
        self.anim.setStartValue(0.2)
        self.anim.setEndValue(1.0)
        self.anim.setEasingCurve(QEasingCurve.OutCubic)
        self.stack.setCurrentIndex(target_index)
        self.anim.start()

    def handle_auth(self):
        pin = self.pin_input.text().strip()
        if len(pin) < 4:
            self.auth_msg.setText("PIN must be at least 4 characters.")
            return

        if not VAULT_PATH.exists():
            self.pin = pin
            initial_entry = {
                "id": str(datetime.now().timestamp()),
                "date": date.today().isoformat(),
                "time": datetime.now().strftime("%I:%M %p"),
                "title": "Welcome to Note",
                "content": "# Welcome to Note\n\nYour thoughts are encrypted locally on your machine with AES-256. Zero plain-text on disk, zero distraction.\n\n- Access Settings from the sidebar to browse all visual theme cards.\n- Smooth fade animations and glowing harmonic palettes are enabled.\n- Toggle Zen Focus for pure distraction-free flow.",
                "tags": "welcome, journal",
                "mood": "zen"
            }
            self.entries = [initial_entry]
            self.save_vault()
            self.load_workspace()
        else:
            try:
                with open(VAULT_PATH, "r") as f:
                    payload = json.load(f)
                decrypted_json = decrypt_string(payload, pin)
                self.entries = json.loads(decrypted_json)
                self.pin = pin
                self.load_workspace()
            except Exception:
                self.auth_msg.setText("Incorrect passcode.")

    def save_vault(self):
        if self.pin:
            try:
                VAULT_PATH.parent.mkdir(parents=True, exist_ok=True)
                payload = encrypt_string(json.dumps(self.entries), self.pin)
                with open(VAULT_PATH, "w") as f:
                    json.dump(payload, f)
            except Exception as e:
                print("Save error:", e)

    def init_main_workspace(self):
        self.main_widget = QWidget()
        main_layout = QHBoxLayout(self.main_widget)
        main_layout.setContentsMargins(12, 12, 12, 12)
        main_layout.setSpacing(12)

        self.splitter = QSplitter(Qt.Horizontal)
        self.splitter.setChildrenCollapsible(False)

        # Left Sidebar
        self.sidebar = QWidget()
        self.sidebar.setObjectName("Sidebar")
        self.sidebar.setMinimumWidth(320)
        sidebar_layout = QVBoxLayout(self.sidebar)
        sidebar_layout.setContentsMargins(10, 10, 10, 10)
        sidebar_layout.setSpacing(10)

        # Header
        sb_header = QHBoxLayout()
        sb_title = QLabel("󰠮 NOTE")
        sb_title.setFont(QFont("JetBrainsMono Nerd Font", 12, QFont.Bold))
        sb_header.addWidget(sb_title)
        sb_header.addStretch()

        settings_btn = QPushButton("󰒓 Settings")
        settings_btn.setCursor(QCursor(Qt.PointingHandCursor))
        settings_btn.clicked.connect(self.go_to_settings)
        sb_header.addWidget(settings_btn)

        lock_btn = QPushButton("󰌾")
        lock_btn.setCursor(QCursor(Qt.PointingHandCursor))
        lock_btn.clicked.connect(self.lock_vault)
        sb_header.addWidget(lock_btn)
        sidebar_layout.addLayout(sb_header)

        # Native QCalendarWidget
        self.calendar = QCalendarWidget()
        self.calendar.setGridVisible(True)
        self.calendar.setVerticalHeaderFormat(QCalendarWidget.NoVerticalHeader)
        self.calendar.clicked.connect(self.on_date_selected)
        sidebar_layout.addWidget(self.calendar)

        # Entry List Controls
        list_ctrl = QHBoxLayout()
        self.list_lbl = QLabel("󰈙 Journal Feed")
        self.list_lbl.setFont(QFont("JetBrainsMono Nerd Font", 10, QFont.Bold))
        list_ctrl.addWidget(self.list_lbl)
        list_ctrl.addStretch()

        new_btn = QPushButton("󰐕 New Entry")
        new_btn.setCursor(QCursor(Qt.PointingHandCursor))
        new_btn.clicked.connect(self.create_entry)
        list_ctrl.addWidget(new_btn)
        sidebar_layout.addLayout(list_ctrl)

        # Entry List
        self.entry_list = QListWidget()
        self.entry_list.itemClicked.connect(self.on_entry_selected)
        sidebar_layout.addWidget(self.entry_list, 1)

        self.splitter.addWidget(self.sidebar)

        # Right Editor Area
        self.editor_area = QWidget()
        self.editor_area.setObjectName("EditorArea")
        self.editor_area.setMinimumWidth(450)
        editor_layout = QVBoxLayout(self.editor_area)
        editor_layout.setContentsMargins(6, 0, 0, 0)
        editor_layout.setSpacing(10)

        # Editor Top Bar
        ed_bar = QHBoxLayout()
        self.meta_lbl = QLabel("")
        self.meta_lbl.setFont(QFont("JetBrainsMono Nerd Font", 10))
        ed_bar.addWidget(self.meta_lbl)
        ed_bar.addStretch()

        self.word_lbl = QLabel("0 words")
        self.word_lbl.setFont(QFont("JetBrainsMono Nerd Font", 9))
        ed_bar.addWidget(self.word_lbl)

        self.zen_btn = QPushButton("󰈈 Zen Focus")
        self.zen_btn.setCursor(QCursor(Qt.PointingHandCursor))
        self.zen_btn.clicked.connect(self.toggle_zen)
        ed_bar.addWidget(self.zen_btn)

        del_btn = QPushButton("󰆴")
        del_btn.setCursor(QCursor(Qt.PointingHandCursor))
        del_btn.clicked.connect(self.delete_entry)
        ed_bar.addWidget(del_btn)
        editor_layout.addLayout(ed_bar)

        # Title Field
        self.title_edit = QLineEdit()
        self.title_edit.setPlaceholderText("Entry Title...")
        self.title_edit.setFont(QFont("JetBrainsMono Nerd Font", 15, QFont.Bold))
        self.title_edit.textChanged.connect(self.on_content_modified)
        editor_layout.addWidget(self.title_edit)

        # Tags Row
        self.tags_edit = QLineEdit()
        self.tags_edit.setPlaceholderText("󰓹 Tags: e.g. college, coding, deep-work")
        self.tags_edit.setFont(QFont("JetBrainsMono Nerd Font", 10))
        self.tags_edit.textChanged.connect(self.on_content_modified)
        editor_layout.addWidget(self.tags_edit)

        # Textarea
        self.content_edit = QTextEdit()
        self.content_edit.setPlaceholderText("Write what's on your mind... (Markdown supported · Encrypted in real-time)")
        self.content_edit.setFont(QFont("JetBrainsMono Nerd Font", 11))
        self.content_edit.textChanged.connect(self.on_content_modified)
        editor_layout.addWidget(self.content_edit, 1)

        self.splitter.addWidget(self.editor_area)
        self.splitter.setSizes([340, 760])

        main_layout.addWidget(self.splitter)
        self.stack.addWidget(self.main_widget)

    def init_settings_page(self):
        self.settings_widget = QWidget()
        settings_layout = QVBoxLayout(self.settings_widget)
        settings_layout.setContentsMargins(24, 24, 24, 24)
        settings_layout.setSpacing(18)

        # Header Bar
        header = QHBoxLayout()
        back_btn = QPushButton("󰁍 Back to Workspace")
        back_btn.setCursor(QCursor(Qt.PointingHandCursor))
        back_btn.clicked.connect(self.go_to_workspace)
        header.addWidget(back_btn)
        header.addStretch()

        title = QLabel("󰒓 SETTINGS & THEMES GALLERY")
        title.setFont(QFont("JetBrainsMono Nerd Font", 14, QFont.Bold))
        header.addWidget(title)
        header.addStretch()
        settings_layout.addLayout(header)

        # Master PIN Card
        pin_frame = QFrame()
        pin_frame.setStyleSheet("QFrame { background-color: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 16px; }")
        pf_layout = QVBoxLayout(pin_frame)
        pf_layout.setSpacing(10)

        pf_title = QLabel("󰌆 Security & Vault Passcode")
        pf_title.setFont(QFont("JetBrainsMono Nerd Font", 11, QFont.Bold))
        pf_layout.addWidget(pf_title)

        pin_row = QHBoxLayout()
        self.old_pin_input = QLineEdit()
        self.old_pin_input.setEchoMode(QLineEdit.Password)
        self.old_pin_input.setPlaceholderText("Current PIN")
        pin_row.addWidget(self.old_pin_input)

        self.new_pin_input = QLineEdit()
        self.new_pin_input.setEchoMode(QLineEdit.Password)
        self.new_pin_input.setPlaceholderText("New PIN (Min 4 chars)")
        pin_row.addWidget(self.new_pin_input)

        self.confirm_pin_input = QLineEdit()
        self.confirm_pin_input.setEchoMode(QLineEdit.Password)
        self.confirm_pin_input.setPlaceholderText("Confirm PIN")
        pin_row.addWidget(self.confirm_pin_input)

        update_pin_btn = QPushButton("󰑓 Update PIN")
        update_pin_btn.clicked.connect(self.handle_settings_pin_change)
        pin_row.addWidget(update_pin_btn)
        pf_layout.addLayout(pin_row)

        self.pin_status_lbl = QLabel("")
        self.pin_status_lbl.setFont(QFont("JetBrainsMono Nerd Font", 9))
        pf_layout.addWidget(self.pin_status_lbl)
        settings_layout.addWidget(pin_frame)

        # Themes Gallery Title
        th_header = QLabel("🎨 Aesthetic Visual Themes Gallery (Click card to activate):")
        th_header.setFont(QFont("JetBrainsMono Nerd Font", 11, QFont.Bold))
        settings_layout.addWidget(th_header)

        # Scrollable Themes Gallery
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll_content = QWidget()
        grid = QGridLayout(scroll_content)
        grid.setSpacing(14)

        self.theme_cards = {}

        for idx, (t_name, meta) in enumerate(THEME_META.items()):
            card = QFrame()
            card.setCursor(QCursor(Qt.PointingHandCursor))
            card.setStyleSheet(f"""
                QFrame {{
                    background-color: {meta['card']};
                    border: 2px solid {meta['border']};
                    border-radius: 10px;
                    padding: 14px;
                }}
                QFrame:hover {{
                    border: 2px solid {meta['acc']};
                }}
                QFrame[active="true"] {{
                    border: 3px solid {meta['acc']};
                }}
            """)
            card_layout = QVBoxLayout(card)
            card_layout.setSpacing(6)

            card_title = QLabel(f"● {t_name}")
            card_title.setFont(QFont("JetBrainsMono Nerd Font", 10, QFont.Bold))
            card_title.setStyleSheet(f"color: {meta['acc']}; border: none; background: transparent;")
            card_layout.addWidget(card_title)

            card_desc = QLabel(meta["desc"])
            card_desc.setWordWrap(True)
            card_desc.setFont(QFont("JetBrainsMono Nerd Font", 8))
            card_desc.setStyleSheet(f"color: {meta['sub']}; border: none; background: transparent;")
            card_layout.addWidget(card_desc)

            # Click event
            card.mousePressEvent = lambda _, tn=t_name: self.apply_theme(tn)

            self.theme_cards[t_name] = card
            row = idx // 3
            col = idx % 3
            grid.addWidget(card, row, col)

        scroll.setWidget(scroll_content)
        settings_layout.addWidget(scroll, 1)

        self.stack.addWidget(self.settings_widget)

    def handle_settings_pin_change(self):
        old_pin = self.old_pin_input.text().strip()
        new_pin = self.new_pin_input.text().strip()
        confirm_pin = self.confirm_pin_input.text().strip()

        if old_pin != self.pin:
            self.pin_status_lbl.setStyleSheet("color: #ff5c00; border: none;")
            self.pin_status_lbl.setText("Current PIN is incorrect.")
            return
        if len(new_pin) < 4:
            self.pin_status_lbl.setStyleSheet("color: #ff5c00; border: none;")
            self.pin_status_lbl.setText("New PIN must be at least 4 characters.")
            return
        if new_pin != confirm_pin:
            self.pin_status_lbl.setStyleSheet("color: #ff5c00; border: none;")
            self.pin_status_lbl.setText("New PINs do not match.")
            return

        self.pin = new_pin
        self.save_vault()
        self.pin_status_lbl.setStyleSheet("color: #10b981; border: none;")
        self.pin_status_lbl.setText("Master PIN successfully updated!")
        self.old_pin_input.clear()
        self.new_pin_input.clear()
        self.confirm_pin_input.clear()

    def go_to_settings(self):
        self.animate_view_transition(2)

    def go_to_workspace(self):
        self.animate_view_transition(1)

    def load_workspace(self):
        self.animate_view_transition(1)
        self.refresh_entries_list()
        today = date.today().isoformat()
        today_entry = next((e for e in self.entries if e["date"] == today), None)
        if today_entry:
            self.load_entry(today_entry["id"])
        elif self.entries:
            self.load_entry(self.entries[0]["id"])
        self.update_calendar_highlights()

    def update_calendar_highlights(self):
        meta = THEME_META.get(self.current_theme, THEME_META["Charcoal Amber (Dark)"])
        format_highlight = QTextCharFormat()
        format_highlight.setBackground(QColor(meta["acc"]))
        format_highlight.setForeground(QColor(meta["bg"]))
        format_highlight.setFontWeight(QFont.Bold)

        dates_with_entries = {e["date"] for e in self.entries}
        for d_str in dates_with_entries:
            try:
                qd = QDate.fromString(d_str, Qt.ISODate)
                self.calendar.setDateTextFormat(qd, format_highlight)
            except Exception:
                pass

    def on_date_selected(self, qdate):
        d_str = qdate.toString(Qt.ISODate)
        self.active_date_str = d_str
        self.refresh_entries_list(filter_date=d_str)
        matched = [e for e in self.entries if e["date"] == d_str]
        if matched:
            self.load_entry(matched[0]["id"])

    def on_entry_selected(self, item):
        entry_id = item.data(Qt.UserRole)
        if entry_id:
            self.load_entry(entry_id)

    def refresh_entries_list(self, filter_date=None):
        self.entry_list.clear()
        target_list = [e for e in self.entries if not filter_date or e["date"] == filter_date]
        for e in target_list:
            preview_title = e.get('title') or 'Untitled Thought'
            item = QListWidgetItem(f"󱞪 {preview_title}\n󰃭 {e.get('date')} · 󱑂 {e.get('time')}")
            item.setData(Qt.UserRole, e["id"])
            self.entry_list.addItem(item)

    def create_entry(self):
        d_str = self.calendar.selectedDate().toString(Qt.ISODate)
        new_e = {
            "id": str(datetime.now().timestamp()),
            "date": d_str,
            "time": datetime.now().strftime("%I:%M %p"),
            "title": "",
            "content": "",
            "tags": "",
            "mood": "focused"
        }
        self.entries.insert(0, new_e)
        self.save_vault()
        self.refresh_entries_list(filter_date=d_str)
        self.load_entry(new_e["id"])
        self.update_calendar_highlights()
        self.title_edit.setFocus()

    def load_entry(self, entry_id):
        self.active_id = entry_id
        entry = next((e for e in self.entries if e["id"] == entry_id), None)
        if entry:
            self.title_edit.blockSignals(True)
            self.tags_edit.blockSignals(True)
            self.content_edit.blockSignals(True)

            self.title_edit.setText(entry.get("title", ""))
            self.tags_edit.setText(entry.get("tags", ""))
            self.content_edit.setText(entry.get("content", ""))
            self.meta_lbl.setText(f"󰃭 {entry.get('date')} · 󱑂 {entry.get('time')}")
            self.update_word_count(entry.get("content", ""))

            self.title_edit.blockSignals(False)
            self.tags_edit.blockSignals(False)
            self.content_edit.blockSignals(False)

    def on_content_modified(self):
        if not self.active_id:
            return
        entry = next((e for e in self.entries if e["id"] == self.active_id), None)
        if entry:
            entry["title"] = self.title_edit.text()
            entry["tags"] = self.tags_edit.text()
            entry["content"] = self.content_edit.toPlainText()
            self.update_word_count(entry["content"])
            self.save_vault()

    def update_word_count(self, text):
        words = len(text.strip().split()) if text.strip() else 0
        self.word_lbl.setText(f"{words} words")

    def delete_entry(self):
        if not self.active_id:
            return
        self.entries = [e for e in self.entries if e["id"] != self.active_id]
        self.save_vault()
        self.refresh_entries_list()
        self.update_calendar_highlights()
        if self.entries:
            self.load_entry(self.entries[0]["id"])
        else:
            self.title_edit.clear()
            self.tags_edit.clear()
            self.content_edit.clear()
            self.active_id = None

    def toggle_zen(self):
        self.is_zen = not self.is_zen
        self.sidebar.setVisible(not self.is_zen)
        self.zen_btn.setText("󰈊 Full View" if self.is_zen else "󰈈 Zen Focus")

    def lock_vault(self):
        self.pin = ""
        self.pin_input.clear()
        self.auth_msg.setText("Press Enter to Unlock")
        self.sync_lock_screen_theme(self.current_theme)
        self.animate_view_transition(0)
        self.pin_input.setFocus()

def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Note")
    window = NoteApp()
    window.show()
    sys.exit(app.exec_())

if __name__ == "__main__":
    main()
