    # ── NAV ────────────────────────────────────────────────────────────────
    def _go_settings(self):
        tw = sum(len(e.get("content","").split()) for e in self.entries)
        self.settings_stats.setText(f"{len(self.entries)} entries  ·  {tw} words")
        self._fade_to(2)

    def _go_workspace(self):
        self._fade_to(1)

    def _lock(self):
        self.pin = ""
        self.pin_input.clear()
        self.auth_hint.setText("AES-256 zero-knowledge vault  ·  press Enter")
        self._sync_lock_theme(self.current_theme)
        self._fade_to(0)
        self.pin_input.setFocus()

    # ── VAULT ──────────────────────────────────────────────────────────────
    def _save_vault(self):
        if self.pin:
            try:
                VAULT_PATH.parent.mkdir(parents=True, exist_ok=True)
                json.dump(encrypt_string(json.dumps(self.entries), self.pin), open(VAULT_PATH,"w"))
            except Exception as e: print("vault err:", e)

    def _load_workspace(self):
        self._fade_to(1)
        self._refresh_list()
        today = date.today().isoformat()
        hit = next((e for e in self.entries if e["date"] == today), None)
        if hit: self._load_entry(hit["id"])
        elif self.entries: self._load_entry(self.entries[0]["id"])
        self._hl_calendar()

    # ── CALENDAR ───────────────────────────────────────────────────────────
    def _hl_calendar(self):
        t = THEMES.get(self.current_theme, THEMES["Void"])
        fmt = QTextCharFormat()
        fmt.setBackground(QColor(t["acc"]))
        fmt.setForeground(QColor(t["acc_fg"]))
        fmt.setFontWeight(QFont.Bold)
        for e in self.entries:
            try: self.calendar.setDateTextFormat(QDate.fromString(e["date"], Qt.ISODate), fmt)
            except: pass

    def _on_date_click(self, qdate):
        d = qdate.toString(Qt.ISODate)
        self.active_date_str = d
        self._refresh_list(filter_date=d)
        hit = next((e for e in self.entries if e["date"] == d), None)
        if hit: self._load_entry(hit["id"])

    # ── LIST ───────────────────────────────────────────────────────────────
    def _on_search(self, text):
        q = text.strip().lower()
        if not q:
            self._refresh_list(filter_date=self.active_date_str)
            return
        self.entry_list.clear()
        for e in self.entries:
            if q in e.get("title","").lower() or q in e.get("content","").lower() or q in e.get("tags","").lower():
                item = QListWidgetItem(f"{e.get('title') or 'Untitled'}  ·  {e.get('date')}")
                item.setData(Qt.UserRole, e["id"])
                self.entry_list.addItem(item)

    def _refresh_list(self, filter_date=None):
        self.entry_list.clear()
        for e in self.entries:
            if filter_date and e["date"] != filter_date: continue
            title = e.get("title") or "Untitled"
            item = QListWidgetItem(f"{title}\n{e.get('date')}  ·  {e.get('time','')}")
            item.setData(Qt.UserRole, e["id"])
            self.entry_list.addItem(item)

    def _on_entry_click(self, item):
        eid = item.data(Qt.UserRole)
        if eid: self._load_entry(eid)

    # ── ENTRY CRUD ─────────────────────────────────────────────────────────
    def _new_entry(self):
        d = self.calendar.selectedDate().toString(Qt.ISODate)
        e = {"id": str(datetime.now().timestamp()), "date": d, "time": datetime.now().strftime("%I:%M %p"),
             "title": "", "content": "", "tags": ""}
        self.entries.insert(0, e)
        self._save_vault()
        self._refresh_list(filter_date=d)
        self._load_entry(e["id"])
        self._hl_calendar()
        self.title_edit.setFocus()

    def _load_entry(self, eid):
        self.active_id = eid
        e = next((x for x in self.entries if x["id"] == eid), None)
        if not e: return
        for w in [self.title_edit, self.tags_edit, self.content_edit]: w.blockSignals(True)
        self.title_edit.setText(e.get("title",""))
        self.tags_edit.setText(e.get("tags",""))
        self.content_edit.setPlainText(e.get("content",""))
        self.meta_lbl.setText(f"{e.get('date','')}  ·  {e.get('time','')}")
        self._update_wc(e.get("content",""))
        for w in [self.title_edit, self.tags_edit, self.content_edit]: w.blockSignals(False)

    def _on_modified(self):
        if not self.active_id: return
        e = next((x for x in self.entries if x["id"] == self.active_id), None)
        if e:
            e["title"] = self.title_edit.text()
            e["tags"] = self.tags_edit.text()
            e["content"] = self.content_edit.toPlainText()
            self._update_wc(e["content"])
            self._save_vault()

    def _update_wc(self, text):
        words = len(text.strip().split()) if text.strip() else 0
        rt = max(1, round(words / 200)) if words else 0
        self.word_lbl.setText(f"{words} words  ·  {rt} min read" if words else "")

    def _delete_entry(self):
        if not self.active_id: return
        self.entries = [e for e in self.entries if e["id"] != self.active_id]
        self._save_vault()
        self._refresh_list()
        self._hl_calendar()
        if self.entries: self._load_entry(self.entries[0]["id"])
        else:
            self.title_edit.clear(); self.tags_edit.clear()
            self.content_edit.clear(); self.active_id = None

    def _export(self):
        if not self.active_id: return
        e = next((x for x in self.entries if x["id"] == self.active_id), None)
        if e:
            path, _ = QFileDialog.getSaveFileName(self, "Export", f"note_{e['date']}.md", "Markdown (*.md)")
            if path:
                open(path,"w").write(f"# {e.get('title','Untitled')}\n*{e.get('date')} · {e.get('tags','')}*\n\n{e.get('content','')}")

    def _toggle_zen(self):
        self.is_zen = not self.is_zen
        self.sidebar.setVisible(not self.is_zen)
        self.zen_btn.setText("Exit Zen" if self.is_zen else "Zen")

    def _change_pin(self):
        op, np, cp = self.old_pin.text(), self.new_pin.text(), self.confirm_pin.text()
        if op != self.pin:
            self.pin_msg.setStyleSheet("color: #f73e5a; background: transparent;")
            self.pin_msg.setText("Current passcode is incorrect.")
            self._shake(self.old_pin); return
        if len(np) < 4:
            self.pin_msg.setStyleSheet("color: #f73e5a; background: transparent;")
            self.pin_msg.setText("New passcode must be ≥ 4 characters.")
            self._shake(self.new_pin); return
        if np != cp:
            self.pin_msg.setStyleSheet("color: #f73e5a; background: transparent;")
            self.pin_msg.setText("Passcodes don't match.")
            self._shake(self.confirm_pin); return
        self.pin = np
        self._save_vault()
        self.pin_msg.setStyleSheet("color: #2dd4aa; background: transparent;")
        self.pin_msg.setText("Passcode updated successfully.")
        self.old_pin.clear(); self.new_pin.clear(); self.confirm_pin.clear()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Note")
    w = NoteApp()
    w.show()
    sys.exit(app.exec_())

if __name__ == "__main__":
    main()
