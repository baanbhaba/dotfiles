# ─────────────────────────────────────────────────────────────────────────────
# STYLESHEET GENERATOR
# ─────────────────────────────────────────────────────────────────────────────
def generate_stylesheet(name: str) -> str:
    t = THEMES.get(name, THEMES["Void"])
    r = t["radius"]
    return f"""
        /* Base */
        QMainWindow, QDialog {{ background: {t['bg']}; }}
        QWidget {{ background: {t['bg']}; color: {t['fg']};
                  font-family: '{FONT_UI}', 'Inter', system-ui, sans-serif; font-size: 13px; }}

        /* Sidebar panel */
        QWidget#Sidebar {{
            background: {t['sidebar']};
            border-right: 1px solid {t['border']};
        }}

        /* Inputs */
        QLineEdit {{
            background: {t['input_bg']};
            color: {t['fg']};
            border: 1px solid {t['border']};
            border-radius: {r};
            padding: 9px 13px;
            selection-background-color: {t['acc']};
            selection-color: {t['acc_fg']};
            font-size: 13px;
        }}
        QLineEdit:focus {{
            border: 1px solid {t['border_strong']};
            background: {t['card']};
        }}
        QLineEdit:hover {{
            border: 1px solid {t['fg_muted']};
        }}

        /* Text editor */
        QTextEdit {{
            background: {t['bg']};
            color: {t['fg']};
            border: none;
            padding: 4px 8px;
            font-family: '{FONT_MONO}', 'JetBrains Mono', monospace;
            font-size: 14px;
            line-height: 1.7;
            selection-background-color: {t['acc']};
            selection-color: {t['acc_fg']};
        }}

        /* Buttons */
        QPushButton {{
            background: {t['card']};
            color: {t['fg']};
            border: 1px solid {t['border']};
            border-radius: {r};
            padding: 7px 14px;
            font-weight: 500;
            font-size: 12px;
        }}
        QPushButton:hover {{
            background: {t['card_hover']};
            border: 1px solid {t['fg_muted']};
            color: {t['fg']};
        }}
        QPushButton:pressed {{
            background: {t['acc']};
            color: {t['acc_fg']};
            border-color: {t['acc']};
        }}
        QPushButton#AccentButton {{
            background: {t['acc']};
            color: {t['acc_fg']};
            border: none;
            font-weight: 600;
        }}
        QPushButton#AccentButton:hover {{
            opacity: 0.9;
        }}

        /* Entry list */
        QListWidget {{
            background: transparent;
            border: none;
            padding: 2px 4px;
        }}
        QListWidget::item {{
            background: {t['card']};
            color: {t['fg']};
            margin-bottom: 4px;
            padding: 11px 14px;
            border-radius: 8px;
            border: 1px solid {t['border']};
        }}
        QListWidget::item:hover {{
            background: {t['card_hover']};
            border: 1px solid {t['fg_muted']};
        }}
        QListWidget::item:selected {{
            background: {t['acc']};
            color: {t['acc_fg']};
            border: 1px solid {t['acc']};
            font-weight: 600;
        }}

        /* Calendar */
        QCalendarWidget QWidget#qt_calendar_navigationbar {{
            background: {t['sidebar']};
            border-bottom: 1px solid {t['border']};
            padding: 4px;
        }}
        QCalendarWidget QToolButton {{
            color: {t['acc']};
            background: transparent;
            border: none;
            font-weight: 700;
