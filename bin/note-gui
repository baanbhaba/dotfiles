    # ── SETTINGS PAGE ──────────────────────────────────────────────────────
    def _init_settings(self):
        self.settings_widget = QWidget()
        sl = QVBoxLayout(self.settings_widget)
        sl.setContentsMargins(0, 0, 0, 0)
        sl.setSpacing(0)

        # Header
        hdr = QWidget()
        hdr.setStyleSheet("background: transparent; border-bottom: 1px solid rgba(128,128,128,0.14);")
        hdrl = QHBoxLayout(hdr)
        hdrl.setContentsMargins(28, 16, 28, 16)
        hdrl.setSpacing(12)

        back_btn = QPushButton("← Back")
        back_btn.setFont(QFont(FONT_UI, 11))
        back_btn.setCursor(QCursor(Qt.PointingHandCursor))
        back_btn.clicked.connect(self._go_workspace)
        hdrl.addWidget(back_btn)
        hdrl.addStretch()

        title = QLabel("Settings")
        title.setFont(QFont(FONT_UI, 16, QFont.Bold))
        title.setStyleSheet("background: transparent;")
        hdrl.addWidget(title)
        hdrl.addStretch()

        self.settings_stats = QLabel("")
        self.settings_stats.setFont(QFont(FONT_UI, 10))
        self.settings_stats.setStyleSheet("background: transparent; opacity: 0.5;")
        hdrl.addWidget(self.settings_stats)
        sl.addWidget(hdr)

        # Scrollable body
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
