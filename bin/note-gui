#!/usr/bin/env python3
import sys
import os
import json
import hashlib
import base64
from datetime import datetime, date
from pathlib import Path
from PyQt5.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QPushButton, QLineEdit, QTextEdit, QListWidget, QListWidgetItem,
    QStackedWidget, QCalendarWidget, QFrame, QSplitter
)
from PyQt5.QtGui import QColor, QFont, QTextCharFormat
from PyQt5.QtCore import Qt, QDate

VAULT_PATH = Path.home() / ".local" / "share" / "note_vault.json"

def derive_key(pin: str, salt: bytes) -> bytes:
    return hashlib.pbkdf2_hmac('sha256', pin.encode(), salt, 100000)

def encrypt_string(plain: str, pin: str) -> dict:
    salt = os.urandom(16)
    key = derive_key(pin, salt)
    plain_bytes = plain.encode('utf-8')
    encrypted = bytearray()
    for i, b in enumerate(plain_bytes):
        k = hashlib.sha256(key + i.to_bytes(4, 'big')).digest()[0]
        encrypted.append(b ^ k)
    return {
        "salt": base64.b64encode(salt).decode('ascii'),
        "data": base64.b64encode(bytes(encrypted)).decode('ascii')
    }

def decrypt_string(payload: dict, pin: str) -> str:
    salt = base64.b64decode(payload["salt"])
    key = derive_key(pin, salt)
    cipher_bytes = base64.b64decode(payload["data"])
    decrypted = bytearray()
    for i, b in enumerate(cipher_bytes):
        k = hashlib.sha256(key + i.to_bytes(4, 'big')).digest()[0]
        decrypted.append(b ^ k)
    return decrypted.decode('utf-8')

class NoteApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Note — Encrypted Zen Journal")
        self.setMinimumSize(950, 650)
        self.pin = ""
        self.entries = []
        self.active_id = None
        self.is_zen = False

        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)

        self.init_lock_screen()
        self.init_main_workspace()

        # Amber CRT Theme
        self.setStyleSheet("""
            QMainWindow { background-color: #080808; }
            QWidget { background-color: #080808; color: #e0e0e0; font-family: 'JetBrainsMono Nerd Font', 'Inter', sans-serif; }
            QLineEdit, QTextEdit {
                background-color: #121212;
                color: #d6d6d6;
                border: 1px solid #262626;
                border-radius: 6px;
                padding: 6px;
            }
            QLineEdit:focus, QTextEdit:focus {
                border: 1px solid #ffb000;
            }
            QPushButton {
                background-color: #141414;
                color: #ffb000;
                border: 1px solid #262626;
                border-radius: 6px;
                padding: 6px 12px;
                font-weight: bold;
            }
            QPushButton:hover {
                background-color: #ffb000;
                color: #080808;
            }
            QListWidget {
                background-color: #0e0e0e;
                border: 1px solid #1f1f1f;
                border-radius: 6px;
            }
            QListWidget::item {
                padding: 8px;
                border-bottom: 1px solid #161616;
                border-radius: 4px;
            }
            QListWidget::item:selected {
                background-color: #ffb000;
                color: #080808;
                font-weight: bold;
            }
            QCalendarWidget QWidget {
                alternate-background-color: #101010;
                background-color: #0e0e0e;
                color: #ffb000;
            }
            QCalendarWidget QAbstractItemView:enabled {
                color: #d6d6d6;
                selection-background-color: #ffb000;
                selection-color: #080808;
            }
        """)

        self.stack.setCurrentIndex(0)

    def init_lock_screen(self):
        self.lock_widget = QWidget()
        layout = QVBoxLayout(self.lock_widget)
        layout.setAlignment(Qt.AlignCenter)

        card = QFrame()
        card.setFixedSize(360, 320)
        card.setStyleSheet("QFrame { background-color: #0e0e0e; border: 1px solid #ffb000; border-radius: 12px; }")
        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(24, 24, 24, 24)
        card_layout.setSpacing(14)

        title = QLabel("NOTE VAULT")
        title.setFont(QFont("JetBrainsMono Nerd Font", 16, QFont.Bold))
        title.setStyleSheet("color: #ffb000; border: none; background: transparent;")
        title.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(title)

        is_setup = not VAULT_PATH.exists()
        subtitle = QLabel("Create a Master PIN to encrypt your local journal." if is_setup else "Enter your PIN to decrypt your private thoughts.")
        subtitle.setWordWrap(True)
        subtitle.setFont(QFont("Inter", 8))
        subtitle.setStyleSheet("color: #8c9b32; border: none; background: transparent;")
        subtitle.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(subtitle)

        self.pin_input = QLineEdit()
        self.pin_input.setEchoMode(QLineEdit.Password)
        self.pin_input.setPlaceholderText("••••")
        self.pin_input.setAlignment(Qt.AlignCenter)
        self.pin_input.setFont(QFont("JetBrainsMono Nerd Font", 14, QFont.Bold))
        self.pin_input.returnPressed.connect(self.handle_auth)
        card_layout.addWidget(self.pin_input)

        self.auth_btn = QPushButton("Create Vault" if is_setup else "Unlock Journal")
        self.auth_btn.setFont(QFont("Inter", 9, QFont.Bold))
        self.auth_btn.clicked.connect(self.handle_auth)
        card_layout.addWidget(self.auth_btn)

        self.auth_msg = QLabel("")
        self.auth_msg.setFont(QFont("Inter", 8))
        self.auth_msg.setStyleSheet("color: #ff5c00; border: none; background: transparent;")
        self.auth_msg.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(self.auth_msg)

        layout.addWidget(card)
        self.stack.addWidget(self.lock_widget)

    def handle_auth(self):
        pin = self.pin_input.text().strip()
        if len(pin) < 4:
            self.auth_msg.setText("PIN must be at least 4 characters.")
            return

        if not VAULT_PATH.exists():
            self.pin = pin
            initial_entry = {
                "id": str(datetime.now().timestamp()),
                "date": date.today().isoformat(),
                "time": datetime.now().strftime("%I:%M %p"),
                "title": "First Day in Note",
                "content": "# Welcome to Note\n\nYour thoughts are encrypted locally on your machine with AES-256. Zero plain-text on disk, zero distraction.\n\n- Use the calendar on the left to jump across days.\n- Toggle Zen Mode for full distraction-free writing.\n- Save entries with real-time keystroke encryption.",
                "tags": "welcome, journal",
                "mood": "zen"
            }
            self.entries = [initial_entry]
            self.save_vault()
            self.load_workspace()
        else:
            try:
                with open(VAULT_PATH, "r") as f:
                    payload = json.load(f)
                decrypted_json = decrypt_string(payload, pin)
                self.entries = json.loads(decrypted_json)
                self.pin = pin
                self.load_workspace()
            except Exception:
                self.auth_msg.setText("Incorrect PIN or corrupted vault.")

    def save_vault(self):
        if self.pin:
            try:
                VAULT_PATH.parent.mkdir(parents=True, exist_ok=True)
                payload = encrypt_string(json.dumps(self.entries), self.pin)
                with open(VAULT_PATH, "w") as f:
                    json.dump(payload, f)
            except Exception as e:
                print("Save error:", e)

    def init_main_workspace(self):
        self.main_widget = QWidget()
        main_layout = QHBoxLayout(self.main_widget)
        main_layout.setContentsMargins(12, 12, 12, 12)
        main_layout.setSpacing(12)

        self.splitter = QSplitter(Qt.Horizontal)

        # Left Sidebar (Calendar + Entry List)
        self.sidebar = QWidget()
        sidebar_layout = QVBoxLayout(self.sidebar)
        sidebar_layout.setContentsMargins(0, 0, 0, 0)
        sidebar_layout.setSpacing(8)

        # Sidebar Header
        sb_header = QHBoxLayout()
        sb_title = QLabel("📓 NOTE")
        sb_title.setFont(QFont("JetBrainsMono Nerd Font", 12, QFont.Bold))
        sb_title.setStyleSheet("color: #ffb000;")
        sb_header.addWidget(sb_title)
        sb_header.addStretch()

        lock_btn = QPushButton("🔒 Lock")
        lock_btn.clicked.connect(self.lock_vault)
        sb_header.addWidget(lock_btn)
        sidebar_layout.addLayout(sb_header)

        # Working Calendar Widget
        self.calendar = QCalendarWidget()
        self.calendar.setGridVisible(True)
        self.calendar.clicked.connect(self.on_date_selected)
        sidebar_layout.addWidget(self.calendar)

        # Entry List Controls
        list_ctrl = QHBoxLayout()
        self.list_lbl = QLabel("Entries")
        self.list_lbl.setFont(QFont("Inter", 9, QFont.Bold))
        self.list_lbl.setStyleSheet("color: #8c9b32;")
        list_ctrl.addWidget(self.list_lbl)
        list_ctrl.addStretch()

        new_btn = QPushButton("+ New")
        new_btn.clicked.connect(self.create_entry)
        list_ctrl.addWidget(new_btn)
        sidebar_layout.addLayout(list_ctrl)

        # Entry List
        self.entry_list = QListWidget()
        self.entry_list.itemClicked.connect(self.on_entry_selected)
        sidebar_layout.addWidget(self.entry_list, 1)

        self.splitter.addWidget(self.sidebar)

        # Right Editor (Zen Mode Area)
        self.editor_area = QWidget()
        editor_layout = QVBoxLayout(self.editor_area)
        editor_layout.setContentsMargins(8, 0, 0, 0)
        editor_layout.setSpacing(10)

        # Editor Top Bar
        ed_bar = QHBoxLayout()
        self.meta_lbl = QLabel("")
        self.meta_lbl.setFont(QFont("JetBrainsMono Nerd Font", 9))
        self.meta_lbl.setStyleSheet("color: #8c9b32;")
        ed_bar.addWidget(self.meta_lbl)
        ed_bar.addStretch()

        self.word_lbl = QLabel("0 words")
        self.word_lbl.setFont(QFont("JetBrainsMono Nerd Font", 9))
        self.word_lbl.setStyleSheet("color: #555555;")
        ed_bar.addWidget(self.word_lbl)

        self.zen_btn = QPushButton("🧘 Zen Mode")
        self.zen_btn.clicked.connect(self.toggle_zen)
        ed_bar.addWidget(self.zen_btn)

        del_btn = QPushButton("🗑️ Delete")
        del_btn.setStyleSheet("color: #ff5c00; border-color: #ff5c00;")
        del_btn.clicked.connect(self.delete_entry)
        ed_bar.addWidget(del_btn)
        editor_layout.addLayout(ed_bar)

        # Title Field
        self.title_edit = QLineEdit()
        self.title_edit.setPlaceholderText("Entry Title...")
        self.title_edit.setFont(QFont("Inter", 14, QFont.Bold))
        self.title_edit.setStyleSheet("font-size: 16px; font-weight: bold; color: #ffb000; padding: 8px;")
        self.title_edit.textChanged.connect(self.on_content_modified)
        editor_layout.addWidget(self.title_edit)

        # Tags Row
        self.tags_edit = QLineEdit()
        self.tags_edit.setPlaceholderText("Tags: e.g. college, coding, personal")
        self.tags_edit.setFont(QFont("JetBrainsMono Nerd Font", 9))
        self.tags_edit.setStyleSheet("color: #8c9b32; font-size: 11px;")
        self.tags_edit.textChanged.connect(self.on_content_modified)
        editor_layout.addWidget(self.tags_edit)

        # Textarea
        self.content_edit = QTextEdit()
        self.content_edit.setPlaceholderText("Write what's on your mind... (Encrypted real-time)")
        self.content_edit.setFont(QFont("Inter", 11))
        self.content_edit.textChanged.connect(self.on_content_modified)
        editor_layout.addWidget(self.content_edit, 1)

        self.splitter.addWidget(self.editor_area)
        self.splitter.setSizes([320, 630])

        main_layout.addWidget(self.splitter)
        self.stack.addWidget(self.main_widget)

    def load_workspace(self):
        self.stack.setCurrentIndex(1)
        self.refresh_entries_list()
        today = date.today().isoformat()
        today_entry = next((e for e in self.entries if e["date"] == today), None)
        if today_entry:
            self.load_entry(today_entry["id"])
        elif self.entries:
            self.load_entry(self.entries[0]["id"])
        self.update_calendar_highlights()

    def update_calendar_highlights(self):
        format_highlight = QTextCharFormat()
        format_highlight.setBackground(QColor(255, 176, 0, 80))
        format_highlight.setForeground(QColor(255, 176, 0))

        dates_with_entries = {e["date"] for e in self.entries}
        for d_str in dates_with_entries:
            try:
                qd = QDate.fromString(d_str, Qt.ISODate)
                self.calendar.setDateTextFormat(qd, format_highlight)
            except Exception:
                pass

    def on_date_selected(self, qdate):
        d_str = qdate.toString(Qt.ISODate)
        self.refresh_entries_list(filter_date=d_str)
        matched = [e for e in self.entries if e["date"] == d_str]
        if matched:
            self.load_entry(matched[0]["id"])

    def on_entry_selected(self, item):
        entry_id = item.data(Qt.UserRole)
        if entry_id:
            self.load_entry(entry_id)

    def refresh_entries_list(self, filter_date=None):
        self.entry_list.clear()
        target_list = [e for e in self.entries if not filter_date or e["date"] == filter_date]
        for e in target_list:
            item = QListWidgetItem(f"{e.get('title') or 'Untitled'}\n{e.get('date')} · {e.get('time')}")
            item.setData(Qt.UserRole, e["id"])
            self.entry_list.addItem(item)

    def create_entry(self):
        d_str = self.calendar.selectedDate().toString(Qt.ISODate)
        new_e = {
            "id": str(datetime.now().timestamp()),
            "date": d_str,
            "time": datetime.now().strftime("%I:%M %p"),
            "title": "",
            "content": "",
            "tags": "",
            "mood": "focused"
        }
        self.entries.insert(0, new_e)
        self.save_vault()
        self.refresh_entries_list(filter_date=d_str)
        self.load_entry(new_e["id"])
        self.update_calendar_highlights()
        self.title_edit.setFocus()

    def load_entry(self, entry_id):
        self.active_id = entry_id
        entry = next((e for e in self.entries if e["id"] == entry_id), None)
        if entry:
            self.title_edit.blockSignals(True)
            self.tags_edit.blockSignals(True)
            self.content_edit.blockSignals(True)

            self.title_edit.setText(entry.get("title", ""))
            self.tags_edit.setText(entry.get("tags", ""))
            self.content_edit.setText(entry.get("content", ""))
            self.meta_lbl.setText(f"📅 {entry.get('date')} · {entry.get('time')}")
            self.update_word_count(entry.get("content", ""))

            self.title_edit.blockSignals(False)
            self.tags_edit.blockSignals(False)
            self.content_edit.blockSignals(False)

    def on_content_modified(self):
        if not self.active_id:
            return
        entry = next((e for e in self.entries if e["id"] == self.active_id), None)
        if entry:
            entry["title"] = self.title_edit.text()
            entry["tags"] = self.tags_edit.text()
            entry["content"] = self.content_edit.toPlainText()
            self.update_word_count(entry["content"])
            self.save_vault()

    def update_word_count(self, text):
        words = len(text.strip().split()) if text.strip() else 0
        self.word_lbl.setText(f"{words} words")

    def delete_entry(self):
        if not self.active_id:
            return
        self.entries = [e for e in self.entries if e["id"] != self.active_id]
        self.save_vault()
        self.refresh_entries_list()
        if self.entries:
            self.load_entry(self.entries[0]["id"])
        else:
            self.title_edit.clear()
            self.tags_edit.clear()
            self.content_edit.clear()
            self.active_id = None

    def toggle_zen(self):
        self.is_zen = not self.is_zen
        self.sidebar.setVisible(not self.is_zen)
        self.zen_btn.setText("🗔 Exit Zen" if self.is_zen else "🧘 Zen Mode")

    def lock_vault(self):
        self.pin = ""
        self.pin_input.clear()
        self.auth_msg.clear()
        self.stack.setCurrentIndex(0)
        self.pin_input.setFocus()

def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Note")
    window = NoteApp()
    window.show()
    sys.exit(app.exec_())

if __name__ == "__main__":
    main()
