class AestheticCalendarWidget(QFrame):
    def __init__(self, on_date_selected_callback):
        super().__init__()
        self.on_date_selected = on_date_selected_callback
        self.current_year = date.today().year
        self.current_month = date.today().month
        self.selected_date_str = date.today().isoformat()
        self.entry_dates = set()

        self.setMinimumSize(320, 270)
        self.setObjectName("CalendarFrame")

        layout = QVBoxLayout(self)
        layout.setContentsMargins(12, 12, 12, 12)
        layout.setSpacing(8)

        # Header with Month/Year & Nav
        header = QHBoxLayout()
        header.setContentsMargins(0, 0, 0, 4)
        self.month_lbl = QLabel("")
        self.month_lbl.setFont(QFont("JetBrainsMono Nerd Font", 11, QFont.Bold))
        self.month_lbl.setStyleSheet("border: none; background: transparent;")
        header.addWidget(self.month_lbl)
        header.addStretch()

        prev_btn = QPushButton("󰁍")
        prev_btn.setFixedSize(30, 28)
        prev_btn.setCursor(QCursor(Qt.PointingHandCursor))
        prev_btn.clicked.connect(self.prev_month)
        header.addWidget(prev_btn)

        next_btn = QPushButton("󰁔")
        next_btn.setFixedSize(30, 28)
        next_btn.setCursor(QCursor(Qt.PointingHandCursor))
        next_btn.clicked.connect(self.next_month)
        header.addWidget(next_btn)

        layout.addLayout(header)

        # Days Header
        days_header = QHBoxLayout()
        days_header.setSpacing(2)
        days_header.setContentsMargins(0, 0, 0, 4)
        for day_name in ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"]:
            lbl = QLabel(day_name)
            lbl.setFont(QFont("JetBrainsMono Nerd Font", 9, QFont.Bold))
            lbl.setStyleSheet("color: #777777; border: none; background: transparent;")
            lbl.setAlignment(Qt.AlignCenter)
            days_header.addWidget(lbl)
        layout.addLayout(days_header)

        # Grid Widget Container
        self.grid_container = QWidget()
        self.grid_container.setStyleSheet("background: transparent; border: none;")
        self.grid = QGridLayout(self.grid_container)
        self.grid.setSpacing(4)
        self.grid.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(self.grid_container)

        self.render_grid()

    def set_entry_dates(self, dates_set):
        self.entry_dates = dates_set
        self.render_grid()

    def prev_month(self):
        if self.current_month == 1:
            self.current_month = 12
            self.current_year -= 1
        else:
            self.current_month -= 1
        self.render_grid()

    def next_month(self):
        if self.current_month == 12:
            self.current_month = 1
            self.current_year += 1
        else:
            self.current_month += 1
        self.render_grid()

    def render_grid(self):
        while self.grid.count():
            item = self.grid.takeAt(0)
            widget = item.widget()
            if widget:
                widget.deleteLater()

        month_name = calendar.month_name[self.current_month]
        self.month_lbl.setText(f"󰃭 {month_name[:3].upper()} {self.current_year}")

        cal = calendar.Calendar(firstweekday=6)
        month_days = cal.monthdayscalendar(self.current_year, self.current_month)

        today_str = date.today().isoformat()

        for row_idx, week in enumerate(month_days):
            for col_idx, day_num in enumerate(week):
                if day_num == 0:
                    empty = QLabel("")
                    empty.setFixedSize(36, 30)
                    empty.setStyleSheet("border: none; background: transparent;")
                    self.grid.addWidget(empty, row_idx, col_idx)
                else:
                    d_str = f"{self.current_year:04d}-{self.current_month:02d}-{day_num:02d}"
                    btn = QPushButton(str(day_num))
                    btn.setFixedSize(36, 30)
                    btn.setCursor(QCursor(Qt.PointingHandCursor))
                    btn.setFont(QFont("JetBrainsMono Nerd Font", 10, QFont.Bold))

                    is_selected = d_str == self.selected_date_str
                    is_today = d_str == today_str
                    has_entry = d_str in self.entry_dates

                    if is_selected:
                        btn.setStyleSheet("QPushButton { font-weight: 900; border: 2px solid #ffffff; }")
                    elif is_today:
                        btn.setStyleSheet("QPushButton { font-weight: bold; border: 1px solid #ffb000; }")
                    elif has_entry:
                        btn.setStyleSheet("QPushButton { font-weight: bold; }")
                    else:
                        btn.setStyleSheet("QPushButton { font-weight: normal; }")

                    btn.clicked.connect(lambda _, ds=d_str: self.select_date(ds))
                    self.grid.addWidget(btn, row_idx, col_idx)

    def select_date(self, date_str):
        self.selected_date_str = date_str
        self.render_grid()
        self.on_date_selected(date_str)

# SETTINGS MODAL DIALOG
class SettingsDialog(QDialog):
    def __init__(self, parent, current_pin, on_change_pin_cb, current_theme, on_theme_change_cb):
        super().__init__(parent)
        self.setWindowTitle("Note Settings")
        self.setFixedSize(460, 420)
        self.current_pin = current_pin
        self.on_change_pin = on_change_pin_cb
        self.on_theme_change = on_theme_change_cb

        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 24, 24, 24)
        layout.setSpacing(16)

        title = QLabel("󰒓 SETTINGS & VAULT SECURITY")
        title.setFont(QFont("JetBrainsMono Nerd Font", 13, QFont.Bold))
        title.setStyleSheet("color: #ffb000; border: none;")
        layout.addWidget(title)

        # Theme Section
        theme_box = QFrame()
        theme_box.setStyleSheet("QFrame { background-color: #121212; border: 1px solid #262626; border-radius: 8px; padding: 12px; }")
        tb_layout = QVBoxLayout(theme_box)
        tb_layout.setSpacing(8)
        tb_layout.addWidget(QLabel("🎨 Active Aesthetic Theme & Colorway:"))
        
        self.theme_combo = QComboBox()
        self.theme_combo.addItems(list(THEMES.keys()))
        self.theme_combo.setCurrentText(current_theme)
        self.theme_combo.currentTextChanged.connect(self.on_theme_change)
        tb_layout.addWidget(self.theme_combo)
        layout.addWidget(theme_box)

        # PIN Change Section
        pin_box = QFrame()
        pin_box.setStyleSheet("QFrame { background-color: #121212; border: 1px solid #262626; border-radius: 8px; padding: 12px; }")
        pb_layout = QVBoxLayout(pin_box)
        pb_layout.setSpacing(8)
        pb_layout.addWidget(QLabel("󰌆 Change Vault Master PIN:"))

        self.old_pin_input = QLineEdit()
        self.old_pin_input.setEchoMode(QLineEdit.Password)
        self.old_pin_input.setPlaceholderText("Current Master PIN")
        pb_layout.addWidget(self.old_pin_input)

        self.new_pin_input = QLineEdit()
        self.new_pin_input.setEchoMode(QLineEdit.Password)
        self.new_pin_input.setPlaceholderText("New Master PIN (Min 4 chars)")
        pb_layout.addWidget(self.new_pin_input)

        self.confirm_pin_input = QLineEdit()
        self.confirm_pin_input.setEchoMode(QLineEdit.Password)
        self.confirm_pin_input.setPlaceholderText("Confirm New Master PIN")
        pb_layout.addWidget(self.confirm_pin_input)

        self.pin_msg = QLabel("")
        self.pin_msg.setFont(QFont("JetBrainsMono Nerd Font", 8))
        self.pin_msg.setStyleSheet("color: #ff5c00; border: none;")
        pb_layout.addWidget(self.pin_msg)

        update_pin_btn = QPushButton("󰑓 Update Master PIN")
        update_pin_btn.clicked.connect(self.handle_pin_change)
        pb_layout.addWidget(update_pin_btn)
        layout.addWidget(pin_box)

        close_btn = QPushButton("Done")
        close_btn.clicked.connect(self.accept)
        layout.addWidget(close_btn)

    def handle_pin_change(self):
        old_pin = self.old_pin_input.text().strip()
        new_pin = self.new_pin_input.text().strip()
        confirm_pin = self.confirm_pin_input.text().strip()

        if old_pin != self.current_pin:
            self.pin_msg.setText("Current PIN is incorrect.")
            return
        if len(new_pin) < 4:
            self.pin_msg.setText("New PIN must be at least 4 characters.")
            return
        if new_pin != confirm_pin:
            self.pin_msg.setText("New PINs do not match.")
            return

        self.on_change_pin(new_pin)
        self.pin_msg.setStyleSheet("color: #10b981; border: none;")
        self.pin_msg.setText("Master PIN successfully updated!")
        self.old_pin_input.clear()
        self.new_pin_input.clear()
        self.confirm_pin_input.clear()

class NoteApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Note")
        self.setMinimumSize(950, 650)
        self.resize(1120, 740)
        self.pin = ""
        self.entries = []
        self.active_id = None
        self.is_zen = False
        self.active_date_str = date.today().isoformat()
        self.current_theme = "Charcoal Amber (Dark)"

        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)

        self.init_lock_screen()
        self.init_main_workspace()

        self.apply_theme(self.current_theme)
        self.stack.setCurrentIndex(0)

    def apply_theme(self, theme_name):
        if theme_name in THEMES:
            self.current_theme = theme_name
            self.setStyleSheet(THEMES[theme_name])

    def init_lock_screen(self):
        self.lock_widget = QWidget()
        layout = QVBoxLayout(self.lock_widget)
        layout.setAlignment(Qt.AlignCenter)

        card = QFrame()
        card.setFixedSize(380, 360)
        card.setStyleSheet("QFrame { background-color: #0d0d0d; border: 1px solid #262626; border-radius: 16px; }")
        
        shadow = QGraphicsDropShadowEffect(self)
        shadow.setBlurRadius(40)
        shadow.setColor(QColor(255, 176, 0, 45))
        shadow.setOffset(0, 0)
        card.setGraphicsEffect(shadow)

        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(32, 32, 32, 32)
        card_layout.setSpacing(16)

        logo = QLabel("")
        logo.setFont(QFont("JetBrainsMono Nerd Font", 26))
        logo.setStyleSheet("color: #ffb000; border: none; background: transparent;")
        logo.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(logo)

        title = QLabel("NOTE VAULT")
        title.setFont(QFont("JetBrainsMono Nerd Font", 16, QFont.Bold))
        title.setStyleSheet("color: #ffb000; border: none; background: transparent; letter-spacing: 2px;")
        title.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(title)

        is_setup = not VAULT_PATH.exists()
        subtitle = QLabel("Create a Master PIN to encrypt your local journal." if is_setup else "Enter Master PIN to decrypt your private thoughts.")
        subtitle.setWordWrap(True)
        subtitle.setFont(QFont("JetBrainsMono Nerd Font", 9))
        subtitle.setStyleSheet("color: #8c9b32; border: none; background: transparent; line-height: 1.4;")
        subtitle.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(subtitle)

        self.pin_input = QLineEdit()
        self.pin_input.setEchoMode(QLineEdit.Password)
        self.pin_input.setPlaceholderText("••••")
        self.pin_input.setAlignment(Qt.AlignCenter)
        self.pin_input.setFont(QFont("JetBrainsMono Nerd Font", 16, QFont.Bold))
        self.pin_input.setStyleSheet("padding: 10px; font-size: 18px; letter-spacing: 6px;")
        self.pin_input.returnPressed.connect(self.handle_auth)
        card_layout.addWidget(self.pin_input)

        self.auth_btn = QPushButton("󰌆 Initialize Vault" if is_setup else "󰌆 Unlock Journal")
        self.auth_btn.setCursor(QCursor(Qt.PointingHandCursor))
        self.auth_btn.setFont(QFont("JetBrainsMono Nerd Font", 10, QFont.Bold))
        self.auth_btn.clicked.connect(self.handle_auth)
        card_layout.addWidget(self.auth_btn)

        self.auth_msg = QLabel("")
        self.auth_msg.setFont(QFont("JetBrainsMono Nerd Font", 8))
        self.auth_msg.setStyleSheet("color: #ff5c00; border: none; background: transparent;")
        self.auth_msg.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(self.auth_msg)

        layout.addWidget(card)
        self.stack.addWidget(self.lock_widget)

    def handle_auth(self):
        pin = self.pin_input.text().strip()
        if len(pin) < 4:
            self.auth_msg.setText("PIN must be at least 4 characters.")
            return

        if not VAULT_PATH.exists():
            self.pin = pin
            initial_entry = {
                "id": str(datetime.now().timestamp()),
                "date": date.today().isoformat(),
                "time": datetime.now().strftime("%I:%M %p"),
                "title": "Welcome to Note",
                "content": "# Welcome to Note\n\nYour thoughts are encrypted locally on your machine with AES-256. Zero plain-text on disk, zero distraction.\n\n- Access Settings from top-right to change themes or PIN.\n- Use the calendar on the left to travel across dates.\n- Toggle Zen Focus for pure distraction-free flow.",
                "tags": "welcome, journal",
                "mood": "zen"
            }
            self.entries = [initial_entry]
            self.save_vault()
            self.load_workspace()
        else:
            try:
                with open(VAULT_PATH, "r") as f:
                    payload = json.load(f)
                decrypted_json = decrypt_string(payload, pin)
                self.entries = json.loads(decrypted_json)
                self.pin = pin
                self.load_workspace()
            except Exception:
                self.auth_msg.setText("Incorrect PIN or corrupted vault.")

    def save_vault(self):
        if self.pin:
            try:
                VAULT_PATH.parent.mkdir(parents=True, exist_ok=True)
                payload = encrypt_string(json.dumps(self.entries), self.pin)
                with open(VAULT_PATH, "w") as f:
                    json.dump(payload, f)
            except Exception as e:
                print("Save error:", e)

    def init_main_workspace(self):
        self.main_widget = QWidget()
        main_layout = QHBoxLayout(self.main_widget)
        main_layout.setContentsMargins(12, 12, 12, 12)
        main_layout.setSpacing(12)

        self.splitter = QSplitter(Qt.Horizontal)
        self.splitter.setChildrenCollapsible(False)

        # Left Sidebar
        self.sidebar = QWidget()
        self.sidebar.setMinimumWidth(320)
        sidebar_layout = QVBoxLayout(self.sidebar)
        sidebar_layout.setContentsMargins(0, 0, 4, 0)
        sidebar_layout.setSpacing(10)

        # Header
        sb_header = QHBoxLayout()
        sb_title = QLabel("󰠮 NOTE")
        sb_title.setFont(QFont("JetBrainsMono Nerd Font", 12, QFont.Bold))
        sb_header.addWidget(sb_title)
        sb_header.addStretch()

        settings_btn = QPushButton("󰒓 Settings")
        settings_btn.setCursor(QCursor(Qt.PointingHandCursor))
        settings_btn.clicked.connect(self.open_settings)
        sb_header.addWidget(settings_btn)

        lock_btn = QPushButton("󰌾")
        lock_btn.setCursor(QCursor(Qt.PointingHandCursor))
        lock_btn.clicked.connect(self.lock_vault)
        sb_header.addWidget(lock_btn)
        sidebar_layout.addLayout(sb_header)

        # Calendar Widget
        self.calendar = AestheticCalendarWidget(self.on_date_selected)
        sidebar_layout.addWidget(self.calendar)

        # Entry List Controls
        list_ctrl = QHBoxLayout()
        self.list_lbl = QLabel("󰈙 Journal Feed")
        self.list_lbl.setFont(QFont("JetBrainsMono Nerd Font", 10, QFont.Bold))
        list_ctrl.addWidget(self.list_lbl)
        list_ctrl.addStretch()

        new_btn = QPushButton("󰐕 New Entry")
        new_btn.setCursor(QCursor(Qt.PointingHandCursor))
        new_btn.clicked.connect(self.create_entry)
        list_ctrl.addWidget(new_btn)
        sidebar_layout.addLayout(list_ctrl)

        # Entry List
        self.entry_list = QListWidget()
        self.entry_list.itemClicked.connect(self.on_entry_selected)
        sidebar_layout.addWidget(self.entry_list, 1)

        self.splitter.addWidget(self.sidebar)

        # Right Editor Area
        self.editor_area = QWidget()
        self.editor_area.setMinimumWidth(450)
        editor_layout = QVBoxLayout(self.editor_area)
        editor_layout.setContentsMargins(4, 0, 0, 0)
        editor_layout.setSpacing(10)

        # Editor Top Bar
        ed_bar = QHBoxLayout()
        self.meta_lbl = QLabel("")
        self.meta_lbl.setFont(QFont("JetBrainsMono Nerd Font", 10))
        ed_bar.addWidget(self.meta_lbl)
        ed_bar.addStretch()

        self.word_lbl = QLabel("0 words")
        self.word_lbl.setFont(QFont("JetBrainsMono Nerd Font", 9))
        ed_bar.addWidget(self.word_lbl)

        self.zen_btn = QPushButton("󰈈 Zen Focus")
        self.zen_btn.setCursor(QCursor(Qt.PointingHandCursor))
        self.zen_btn.clicked.connect(self.toggle_zen)
        ed_bar.addWidget(self.zen_btn)

        del_btn = QPushButton("󰆴")
        del_btn.setCursor(QCursor(Qt.PointingHandCursor))
        del_btn.clicked.connect(self.delete_entry)
        ed_bar.addWidget(del_btn)
        editor_layout.addLayout(ed_bar)

        # Title Field
        self.title_edit = QLineEdit()
        self.title_edit.setPlaceholderText("Entry Title...")
        self.title_edit.setFont(QFont("JetBrainsMono Nerd Font", 15, QFont.Bold))
        self.title_edit.textChanged.connect(self.on_content_modified)
        editor_layout.addWidget(self.title_edit)

        # Tags Row
        self.tags_edit = QLineEdit()
        self.tags_edit.setPlaceholderText("󰓹 Tags: e.g. college, coding, deep-work")
        self.tags_edit.setFont(QFont("JetBrainsMono Nerd Font", 10))
        self.tags_edit.textChanged.connect(self.on_content_modified)
        editor_layout.addWidget(self.tags_edit)

        # Textarea
        self.content_edit = QTextEdit()
        self.content_edit.setPlaceholderText("Write what's on your mind... (Markdown supported · Encrypted in real-time)")
        self.content_edit.setFont(QFont("JetBrainsMono Nerd Font", 11))
        self.content_edit.textChanged.connect(self.on_content_modified)
        editor_layout.addWidget(self.content_edit, 1)

        self.splitter.addWidget(self.editor_area)
        self.splitter.setSizes([340, 760])

        main_layout.addWidget(self.splitter)
        self.stack.addWidget(self.main_widget)

    def open_settings(self):
        dlg = SettingsDialog(self, self.pin, self.change_master_pin, self.current_theme, self.apply_theme)
        dlg.exec_()

    def change_master_pin(self, new_pin):
        self.pin = new_pin
        self.save_vault()

    def load_workspace(self):
        self.stack.setCurrentIndex(1)
        self.refresh_entries_list()
        today = date.today().isoformat()
        today_entry = next((e for e in self.entries if e["date"] == today), None)
        if today_entry:
            self.load_entry(today_entry["id"])
        elif self.entries:
            self.load_entry(self.entries[0]["id"])
        self.update_calendar_highlights()

    def update_calendar_highlights(self):
        dates_with_entries = {e["date"] for e in self.entries}
        self.calendar.set_entry_dates(dates_with_entries)

    def on_date_selected(self, d_str):
        self.active_date_str = d_str
        self.refresh_entries_list(filter_date=d_str)
        matched = [e for e in self.entries if e["date"] == d_str]
        if matched:
            self.load_entry(matched[0]["id"])

    def on_entry_selected(self, item):
        entry_id = item.data(Qt.UserRole)
        if entry_id:
            self.load_entry(entry_id)

    def refresh_entries_list(self, filter_date=None):
        self.entry_list.clear()
        target_list = [e for e in self.entries if not filter_date or e["date"] == filter_date]
        for e in target_list:
            preview_title = e.get('title') or 'Untitled Thought'
            item = QListWidgetItem(f"󱞪 {preview_title}\n󰃭 {e.get('date')} · 󱑂 {e.get('time')}")
            item.setData(Qt.UserRole, e["id"])
            self.entry_list.addItem(item)

    def create_entry(self):
        d_str = self.active_date_str
        new_e = {
            "id": str(datetime.now().timestamp()),
            "date": d_str,
            "time": datetime.now().strftime("%I:%M %p"),
            "title": "",
            "content": "",
            "tags": "",
            "mood": "focused"
        }
        self.entries.insert(0, new_e)
        self.save_vault()
        self.refresh_entries_list(filter_date=d_str)
        self.load_entry(new_e["id"])
        self.update_calendar_highlights()
        self.title_edit.setFocus()

    def load_entry(self, entry_id):
        self.active_id = entry_id
        entry = next((e for e in self.entries if e["id"] == entry_id), None)
        if entry:
            self.title_edit.blockSignals(True)
            self.tags_edit.blockSignals(True)
            self.content_edit.blockSignals(True)

            self.title_edit.setText(entry.get("title", ""))
            self.tags_edit.setText(entry.get("tags", ""))
            self.content_edit.setText(entry.get("content", ""))
            self.meta_lbl.setText(f"󰃭 {entry.get('date')} · 󱑂 {entry.get('time')}")
            self.update_word_count(entry.get("content", ""))

            self.title_edit.blockSignals(False)
            self.tags_edit.blockSignals(False)
            self.content_edit.blockSignals(False)

    def on_content_modified(self):
        if not self.active_id:
            return
        entry = next((e for e in self.entries if e["id"] == self.active_id), None)
        if entry:
            entry["title"] = self.title_edit.text()
            entry["tags"] = self.tags_edit.text()
            entry["content"] = self.content_edit.toPlainText()
            self.update_word_count(entry["content"])
            self.save_vault()

    def update_word_count(self, text):
        words = len(text.strip().split()) if text.strip() else 0
        self.word_lbl.setText(f"{words} words")

    def delete_entry(self):
        if not self.active_id:
            return
        self.entries = [e for e in self.entries if e["id"] != self.active_id]
        self.save_vault()
        self.refresh_entries_list()
        self.update_calendar_highlights()
        if self.entries:
            self.load_entry(self.entries[0]["id"])
        else:
            self.title_edit.clear()
            self.tags_edit.clear()
            self.content_edit.clear()
            self.active_id = None

    def toggle_zen(self):
        self.is_zen = not self.is_zen
        self.sidebar.setVisible(not self.is_zen)
        self.zen_btn.setText("󰈊 Full View" if self.is_zen else "󰈈 Zen Focus")

    def lock_vault(self):
        self.pin = ""
        self.pin_input.clear()
        self.auth_msg.clear()
        self.stack.setCurrentIndex(0)
        self.pin_input.setFocus()

def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Note")
    window = NoteApp()
    window.show()
    sys.exit(app.exec_())

if __name__ == "__main__":
    main()
