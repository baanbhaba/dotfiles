# ─────────────────────────────────────────────────────────────────────────────
# DYNAMIC STYLESHEET GENERATOR
# ─────────────────────────────────────────────────────────────────────────────
def generate_stylesheet(name: str) -> str:
    m = THEME_META.get(name, THEME_META["Void (Dark)"])
    return f"""
        QMainWindow {{ background-color: {m['bg']}; }}
        QWidget {{ background-color: {m['bg']}; color: {m['fg']}; font-family: 'JetBrainsMono Nerd Font', 'Inter', monospace; }}
        QWidget#Sidebar {{ background-color: {m['sidebar']}; border-right: 1px solid {m['border']}; }}
        QWidget#EditorArea {{ background-color: {m['bg']}; }}
        
        QLineEdit, QTextEdit {{
            background-color: {m['card']};
            color: {m['fg']};
            border: 1px solid {m['border']};
            border-radius: 8px;
            padding: 10px 14px;
            selection-background-color: {m['acc']};
            selection-color: {m['bg']};
        }}
        QLineEdit:focus, QTextEdit:focus {{
            border: 1px solid {m['acc']};
            background-color: {m['card_hover']};
        }}
        QTextEdit {{
            font-size: 14px;
            line-height: 1.6;
        }}
        
        QPushButton {{
            background-color: {m['card']};
            color: {m['acc']};
            border: 1px solid {m['btn_border']};
            border-radius: 8px;
            padding: 7px 14px;
            font-weight: bold;
        }}
        QPushButton:hover {{
            background-color: {m['acc']};
            color: {m['bg']};
            border-color: {m['acc']};
        }}
        QPushButton:pressed {{
            background-color: {m['sub']};
            color: {m['fg']};
        }}
        
        QListWidget {{
            background-color: {m['sidebar']};
            border: 1px solid {m['border']};
            border-radius: 8px;
            padding: 4px;
        }}
        QListWidget::item {{
            background-color: {m['card']};
            color: {m['fg']};
            margin-bottom: 6px;
            padding: 10px 12px;
            border-radius: 6px;
            border: 1px solid {m['border']};
        }}
        QListWidget::item:hover {{
            border: 1px solid {m['acc']};
            background-color: {m['card_hover']};
            color: {m['acc']};
        }}
        QListWidget::item:selected {{
            background-color: {m['acc']};
            color: {m['bg']};
            font-weight: bold;
        }}
        
        QCalendarWidget QWidget#qt_calendar_navigationbar {{ background-color: {m['card']}; }}
        QCalendarWidget QToolButton {{ color: {m['acc']}; background: transparent; border: none; font-weight: bold; }}
        QCalendarWidget QTableView {{
            background-color: {m['sidebar']};
            color: {m['fg']};
            selection-background-color: {m['acc']};
            selection-color: {m['bg']};
            font-weight: bold;
            gridline-color: {m['border']};
        }}
        QCalendarWidget QHeaderView::section {{
            background-color: {m['card']};
            color: {m['acc']};
            font-weight: bold;
        }}
        
        QSplitter::handle {{ background-color: {m['border']}; width: 3px; }}
        QSplitter::handle:hover {{ background-color: {m['acc']}; }}
        QScrollArea {{ border: none; background: transparent; }}
    """

# ─────────────────────────────────────────────────────────────────────────────
# KOKONUT / BKLIT UI THEME CARD COMPONENT WITH MINI VISUAL MOCKUP
# ─────────────────────────────────────────────────────────────────────────────
class MotionThemeCard(QFrame):
    def __init__(self, theme_name, meta, on_click_callback):
        super().__init__()
        self.theme_name = theme_name
        self.meta = meta
        self.on_click = on_click_callback
        self.setCursor(QCursor(Qt.PointingHandCursor))
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
        self.setObjectName("ThemePreviewCard")

        layout = QVBoxLayout(self)
        layout.setContentsMargins(14, 14, 14, 14)
        layout.setSpacing(10)

        # 1. Top Header Row: Name + Category Pill + Active Badge
        top_row = QHBoxLayout()
        self.title_lbl = QLabel(theme_name)
        self.title_lbl.setFont(QFont("JetBrainsMono Nerd Font", 10, QFont.Bold))
        self.title_lbl.setStyleSheet(f"color: {meta['fg']}; border: none; background: transparent;")
        top_row.addWidget(self.title_lbl)
        top_row.addStretch()

        self.badge_lbl = QLabel(meta["category"])
        self.badge_lbl.setFont(QFont("JetBrainsMono Nerd Font", 8, QFont.Bold))
        self.badge_lbl.setStyleSheet(f"""
            color: {meta['acc']};
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid {meta['btn_border']};
            border-radius: 6px;
            padding: 2px 6px;
        """)
        top_row.addWidget(self.badge_lbl)
        layout.addLayout(top_row)

        # 2. Visual Mini-Mockup (Canvas + Sidebar + Swatch Dots)
        mockup = QFrame()
        mockup.setFixedHeight(64)
        mockup.setStyleSheet(f"""
            QFrame {{
                background-color: {meta['bg']};
                border: 1px solid {meta['border']};
                border-radius: 8px;
            }}
        """)
        mock_layout = QHBoxLayout(mockup)
        mock_layout.setContentsMargins(6, 6, 6, 6)
        mock_layout.setSpacing(6)

        # Mini Sidebar
        mini_sb = QFrame()
        mini_sb.setFixedWidth(42)
        mini_sb.setStyleSheet(f"background-color: {meta['sidebar']}; border: 1px solid {meta['border']}; border-radius: 4px;")
        mock_layout.addWidget(mini_sb)

        # Mini Editor Area with 2 mock content lines + swatches
        mini_ed = QWidget()
        mini_ed_l = QVBoxLayout(mini_ed)
        mini_ed_l.setContentsMargins(4, 2, 4, 2)
        mini_ed_l.setSpacing(4)

        line1 = QFrame()
        line1.setFixedHeight(4)
        line1.setStyleSheet(f"background-color: {meta['acc']}; border-radius: 2px;")
        mini_ed_l.addWidget(line1)

        line2 = QFrame()
        line2.setFixedHeight(3)
        line2.setStyleSheet(f"background-color: {meta['card']}; border-radius: 1px;")
        mini_ed_l.addWidget(line2)

        # 4 Swatch Circles Row
        swatch_row = QHBoxLayout()
        swatch_row.setSpacing(4)
        for hex_col in meta.get("swatches", []):
            dot = QFrame()
            dot.setFixedSize(10, 10)
            dot.setStyleSheet(f"background-color: {hex_col}; border: 1px solid rgba(255,255,255,0.2); border-radius: 5px;")
            swatch_row.addWidget(dot)
        swatch_row.addStretch()
        mini_ed_l.addLayout(swatch_row)

        mock_layout.addWidget(mini_ed, 1)
        layout.addWidget(mockup)

        # 3. Descriptive Copy
        self.desc_lbl = QLabel(meta["desc"])
        self.desc_lbl.setWordWrap(True)
        self.desc_lbl.setFont(QFont("JetBrainsMono Nerd Font", 8))
        self.desc_lbl.setStyleSheet(f"color: {meta['sub']}; border: none; background: transparent; line-height: 1.3;")
        layout.addWidget(self.desc_lbl)

        self.apply_declarative_style(active=False)

    def mousePressEvent(self, event):
        self.on_click(self.theme_name)
        super().mousePressEvent(event)

    def apply_declarative_style(self, active=False):
        m = self.meta
        border_col = m["acc"] if active else m["border"]
        border_w = "2px" if active else "1px"
        bg_normal = m["card_hover"] if active else m["card"]
        
        if active:
            self.badge_lbl.setText("✓ ACTIVE")
            self.badge_lbl.setStyleSheet(f"color: {m['bg']}; background-color: {m['acc']}; border-radius: 6px; padding: 2px 6px; font-weight: 900;")
        else:
            self.badge_lbl.setText(m["category"])
            self.badge_lbl.setStyleSheet(f"color: {m['acc']}; background-color: rgba(255, 255, 255, 0.05); border: 1px solid {m['btn_border']}; border-radius: 6px; padding: 2px 6px;")

        self.setStyleSheet(f"""
            QFrame#ThemePreviewCard {{
                background-color: {bg_normal};
                border: {border_w} solid {border_col};
                border-radius: 12px;
            }}
            QFrame#ThemePreviewCard:hover {{
                background-color: {m['card_hover']};
                border: 2px solid {m['acc']};
            }}
        """)

# ─────────────────────────────────────────────────────────────────────────────
# MAIN APPLICATION CONTROLLER
# ─────────────────────────────────────────────────────────────────────────────
class NoteApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Note — Zero-Knowledge Journal")
        self.setMinimumSize(960, 660)
        self.resize(1140, 750)
        self.pin = ""
        self.entries = []
        self.active_id = None
        self.is_zen = False
        self.active_date_str = date.today().isoformat()
        
        self.config = load_config()
        self.current_theme = self.config.get("theme", "Void (Dark)")
        if self.current_theme not in THEME_META:
            self.current_theme = "Void (Dark)"

        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)

        self.init_lock_screen()
        self.init_main_workspace()
        self.init_settings_page()

        self.apply_theme(self.current_theme)
        self.stack.setCurrentIndex(0)

    def apply_theme(self, theme_name):
        if theme_name in THEME_META:
            self.current_theme = theme_name
            self.config["theme"] = theme_name
            save_config(self.config)
            
            self.setStyleSheet(generate_stylesheet(theme_name))
            self.sync_lock_screen_theme(theme_name)
            
            if hasattr(self, 'theme_cards'):
                for name, card in self.theme_cards.items():
                    card.apply_declarative_style(active=(name == theme_name))

    def sync_lock_screen_theme(self, theme_name):
        meta = THEME_META.get(theme_name, THEME_META["Void (Dark)"])
        self.lock_widget.setStyleSheet(f"background-color: {meta['bg']};")
        self.time_lbl.setStyleSheet(f"color: {meta['fg']}; border: none; background: transparent; letter-spacing: -2px;")
        self.date_lbl.setStyleSheet(f"color: {meta['sub']}; border: none; background: transparent; margin-top: -18px;")
        
        r, g, b, a = meta["glow"]
        self.lock_shadow.setColor(QColor(r, g, b, a))
        
        self.pin_input.setStyleSheet(f"""
            QLineEdit {{
                background-color: {meta['input_bg']};
                color: {meta['input_fg']};
                border: 2px solid {meta['border']};
                border-radius: {meta['pill_radius']};
                padding: 8px 16px;
                letter-spacing: 8px;
            }}
            QLineEdit:focus {{
                border: 2px solid {meta['acc']};
            }}
        """)
        self.auth_msg.setStyleSheet(f"color: {meta['sub']}; border: none; background: transparent;")

    # 1. HYPRLOCK MINIMALIST AUTH SCREEN
    def init_lock_screen(self):
        self.lock_widget = QWidget()
        layout = QVBoxLayout(self.lock_widget)
        layout.setAlignment(Qt.AlignCenter)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(24)

        # Digital Clock
        self.time_lbl = QLabel("")
        self.time_lbl.setFont(QFont("JetBrainsMono Nerd Font", 74, QFont.Bold))
        self.time_lbl.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.time_lbl)

        # Date Label
        self.date_lbl = QLabel("")
        self.date_lbl.setFont(QFont("JetBrainsMono Nerd Font", 13))
        self.date_lbl.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.date_lbl)

        # Live Clock Timer
        self.clock_timer = QTimer(self)
        self.clock_timer.timeout.connect(self.update_lock_clock)
        self.clock_timer.start(1000)
        self.update_lock_clock()

        # Input Pill
        is_setup = not VAULT_PATH.exists()
        self.pin_input = QLineEdit()
        self.pin_input.setEchoMode(QLineEdit.Password)
        self.pin_input.setPlaceholderText("Create Passcode" if is_setup else "******")
        self.pin_input.setAlignment(Qt.AlignCenter)
        self.pin_input.setFixedSize(320, 56)
        self.pin_input.setFont(QFont("JetBrainsMono Nerd Font", 16, QFont.Bold))
        
        self.lock_shadow = QGraphicsDropShadowEffect(self)
        self.lock_shadow.setBlurRadius(40)
        self.lock_shadow.setOffset(0, 0)
        self.pin_input.setGraphicsEffect(self.lock_shadow)
        
        self.pin_input.returnPressed.connect(self.handle_auth)
        layout.addWidget(self.pin_input, alignment=Qt.AlignCenter)

        self.auth_msg = QLabel("Press Enter to Decrypt · AES-256 Vault" if not is_setup else "Press Enter to Initialize Vault")
        self.auth_msg.setFont(QFont("JetBrainsMono Nerd Font", 9))
        self.auth_msg.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.auth_msg, alignment=Qt.AlignCenter)

        self.stack.addWidget(self.lock_widget)

    def update_lock_clock(self):
        now = datetime.now()
        self.time_lbl.setText(now.strftime("%I:%M"))
        self.date_lbl.setText(now.strftime("%A, %B %d").upper())

    # Physics Error Shake Animation
    def trigger_shake_animation(self, widget):
        anim = QPropertyAnimation(widget, b"pos")
        anim.setDuration(300)
        orig_pos = widget.pos()
        anim.setKeyValueAt(0.0, orig_pos)
        anim.setKeyValueAt(0.1, orig_pos + QPoint(-12, 0))
        anim.setKeyValueAt(0.3, orig_pos + QPoint(12, 0))
        anim.setKeyValueAt(0.5, orig_pos + QPoint(-8, 0))
        anim.setKeyValueAt(0.7, orig_pos + QPoint(8, 0))
        anim.setKeyValueAt(0.9, orig_pos + QPoint(-4, 0))
        anim.setKeyValueAt(1.0, orig_pos)
        anim.setEasingCurve(QEasingCurve.OutQuad)
        anim.start()
        self._shake_anim = anim

    # Fluid Cross-Fade Transition
    def animate_view_transition(self, target_index):
        opacity_effect = QGraphicsOpacityEffect(self.stack)
        self.stack.setGraphicsEffect(opacity_effect)
        self.anim = QPropertyAnimation(opacity_effect, b"opacity")
        self.anim.setDuration(180)
        self.anim.setStartValue(0.2)
        self.anim.setEndValue(1.0)
        self.anim.setEasingCurve(QEasingCurve.OutCubic)
        self.stack.setCurrentIndex(target_index)
        self.anim.start()

    def handle_auth(self):
        pin = self.pin_input.text().strip()
        if len(pin) < 4:
            self.auth_msg.setText("PIN must be at least 4 characters.")
            self.trigger_shake_animation(self.pin_input)
            return

        if not VAULT_PATH.exists():
            self.pin = pin
            initial_entry = {
                "id": str(datetime.now().timestamp()),
                "date": date.today().isoformat(),
                "time": datetime.now().strftime("%I:%M %p"),
                "title": "Welcome to Note",
                "content": "# Welcome to Note\n\nYour thoughts are encrypted locally on your machine with AES-256. Zero plain-text on disk, zero distraction.\n\n- Access Settings from the sidebar to browse all visual theme cards.\n- Real-time search, instant tag filtering, and markdown exports are enabled.\n- Toggle Zen Focus for pure uninterrupted flow.",
                "tags": "welcome, journal",
                "mood": "zen"
            }
            self.entries = [initial_entry]
            self.save_vault()
            self.load_workspace()
        else:
            try:
                with open(VAULT_PATH, "r") as f:
                    payload = json.load(f)
                decrypted_json = decrypt_string(payload, pin)
                self.entries = json.loads(decrypted_json)
                self.pin = pin
                self.load_workspace()
            except Exception:
                self.auth_msg.setText("Incorrect passcode.")
                self.trigger_shake_animation(self.pin_input)

    def save_vault(self):
        if self.pin:
            try:
                VAULT_PATH.parent.mkdir(parents=True, exist_ok=True)
                payload = encrypt_string(json.dumps(self.entries), self.pin)
                with open(VAULT_PATH, "w") as f:
                    json.dump(payload, f)
            except Exception as e:
                print("Save error:", e)

    # 2. MAIN JOURNAL WORKSPACE
