class AestheticCalendarWidget(QFrame):
    def __init__(self, on_date_selected_callback):
        super().__init__()
        self.on_date_selected = on_date_selected_callback
        self.current_year = date.today().year
        self.current_month = date.today().month
        self.selected_date_str = date.today().isoformat()
        self.entry_dates = set()

        self.setMinimumSize(280, 240)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
        self.setObjectName("CalendarFrame")

        layout = QVBoxLayout(self)
        layout.setContentsMargins(10, 10, 10, 10)
        layout.setSpacing(6)

        # Header
        header = QHBoxLayout()
        header.setContentsMargins(0, 0, 0, 2)
        self.month_lbl = QLabel("")
        self.month_lbl.setFont(QFont("JetBrainsMono Nerd Font", 10, QFont.Bold))
        self.month_lbl.setStyleSheet("border: none; background: transparent;")
        header.addWidget(self.month_lbl)
        header.addStretch()

        prev_btn = QPushButton("󰁍")
        prev_btn.setFixedSize(26, 26)
        prev_btn.setCursor(QCursor(Qt.PointingHandCursor))
        prev_btn.clicked.connect(self.prev_month)
        header.addWidget(prev_btn)

        next_btn = QPushButton("󰁔")
        next_btn.setFixedSize(26, 26)
        next_btn.setCursor(QCursor(Qt.PointingHandCursor))
        next_btn.clicked.connect(self.next_month)
        header.addWidget(next_btn)

        layout.addLayout(header)

        # Days Header
        days_header = QHBoxLayout()
        days_header.setSpacing(2)
        for day_name in ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"]:
            lbl = QLabel(day_name)
            lbl.setFont(QFont("JetBrainsMono Nerd Font", 8, QFont.Bold))
            lbl.setStyleSheet("color: #777777; border: none; background: transparent;")
            lbl.setAlignment(Qt.AlignCenter)
            days_header.addWidget(lbl)
        layout.addLayout(days_header)

        # Grid Widget Container
        self.grid_container = QWidget()
        self.grid_container.setStyleSheet("background: transparent; border: none;")
        self.grid = QGridLayout(self.grid_container)
        self.grid.setSpacing(3)
        self.grid.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(self.grid_container)

        self.render_grid()

    def set_entry_dates(self, dates_set):
        self.entry_dates = dates_set
        self.render_grid()

    def prev_month(self):
        if self.current_month == 1:
            self.current_month = 12
            self.current_year -= 1
        else:
            self.current_month -= 1
        self.render_grid()

    def next_month(self):
        if self.current_month == 12:
            self.current_month = 1
            self.current_year += 1
        else:
            self.current_month += 1
        self.render_grid()

    def render_grid(self):
        while self.grid.count():
            item = self.grid.takeAt(0)
            widget = item.widget()
            if widget:
                widget.deleteLater()

        month_name = calendar.month_name[self.current_month]
        self.month_lbl.setText(f"󰃭 {month_name[:3].upper()} {self.current_year}")

        cal = calendar.Calendar(firstweekday=6)
        month_days = cal.monthdayscalendar(self.current_year, self.current_month)

        today_str = date.today().isoformat()

        for row_idx, week in enumerate(month_days):
            for col_idx, day_num in enumerate(week):
                if day_num == 0:
                    empty = QLabel("")
                    empty.setFixedSize(28, 24)
                    empty.setStyleSheet("border: none; background: transparent;")
                    self.grid.addWidget(empty, row_idx, col_idx)
                else:
                    d_str = f"{self.current_year:04d}-{self.current_month:02d}-{day_num:02d}"
                    btn = QPushButton(str(day_num))
                    btn.setFixedSize(28, 24)
                    btn.setCursor(QCursor(Qt.PointingHandCursor))
                    btn.setFont(QFont("JetBrainsMono Nerd Font", 8, QFont.Bold))
                    btn.clicked.connect(lambda _, ds=d_str: self.select_date(ds))
                    self.grid.addWidget(btn, row_idx, col_idx)

    def select_date(self, date_str):
        self.selected_date_str = date_str
        self.render_grid()
        self.on_date_selected(date_str)

class NoteApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Note")
        self.setMinimumSize(900, 600)
        self.resize(1100, 720)
        self.pin = ""
        self.entries = []
        self.active_id = None
        self.is_zen = False
        self.active_date_str = date.today().isoformat()
        self.current_theme = "Charcoal Amber (Dark)"

        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)

        self.init_lock_screen()
        self.init_main_workspace()

        self.apply_theme(self.current_theme)
        self.stack.setCurrentIndex(0)

    def apply_theme(self, theme_name):
        if theme_name in THEMES:
            self.current_theme = theme_name
            self.setStyleSheet(THEMES[theme_name])

    def init_lock_screen(self):
        self.lock_widget = QWidget()
        layout = QVBoxLayout(self.lock_widget)
        layout.setAlignment(Qt.AlignCenter)

        card = QFrame()
        card.setFixedSize(380, 360)
        card.setStyleSheet("QFrame { background-color: #0d0d0d; border: 1px solid #262626; border-radius: 16px; }")
        
        shadow = QGraphicsDropShadowEffect(self)
        shadow.setBlurRadius(40)
        shadow.setColor(QColor(255, 176, 0, 45))
        shadow.setOffset(0, 0)
        card.setGraphicsEffect(shadow)

        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(32, 32, 32, 32)
        card_layout.setSpacing(16)

        logo = QLabel("")
        logo.setFont(QFont("JetBrainsMono Nerd Font", 26))
        logo.setStyleSheet("color: #ffb000; border: none; background: transparent;")
        logo.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(logo)

        title = QLabel("NOTE VAULT")
        title.setFont(QFont("JetBrainsMono Nerd Font", 16, QFont.Bold))
        title.setStyleSheet("color: #ffb000; border: none; background: transparent; letter-spacing: 2px;")
        title.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(title)

        is_setup = not VAULT_PATH.exists()
        subtitle = QLabel("Create a Master PIN to encrypt your local journal." if is_setup else "Enter Master PIN to decrypt your private thoughts.")
        subtitle.setWordWrap(True)
        subtitle.setFont(QFont("JetBrainsMono Nerd Font", 9))
        subtitle.setStyleSheet("color: #8c9b32; border: none; background: transparent; line-height: 1.4;")
        subtitle.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(subtitle)

        self.pin_input = QLineEdit()
        self.pin_input.setEchoMode(QLineEdit.Password)
        self.pin_input.setPlaceholderText("••••")
        self.pin_input.setAlignment(Qt.AlignCenter)
        self.pin_input.setFont(QFont("JetBrainsMono Nerd Font", 16, QFont.Bold))
        self.pin_input.setStyleSheet("padding: 10px; font-size: 18px; letter-spacing: 6px;")
        self.pin_input.returnPressed.connect(self.handle_auth)
        card_layout.addWidget(self.pin_input)

        self.auth_btn = QPushButton("󰌆 Initialize Vault" if is_setup else "󰌆 Unlock Journal")
        self.auth_btn.setCursor(QCursor(Qt.PointingHandCursor))
        self.auth_btn.setFont(QFont("JetBrainsMono Nerd Font", 10, QFont.Bold))
        self.auth_btn.clicked.connect(self.handle_auth)
        card_layout.addWidget(self.auth_btn)

        self.auth_msg = QLabel("")
        self.auth_msg.setFont(QFont("JetBrainsMono Nerd Font", 8))
        self.auth_msg.setStyleSheet("color: #ff5c00; border: none; background: transparent;")
        self.auth_msg.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(self.auth_msg)

        layout.addWidget(card)
        self.stack.addWidget(self.lock_widget)

    def handle_auth(self):
        pin = self.pin_input.text().strip()
        if len(pin) < 4:
            self.auth_msg.setText("PIN must be at least 4 characters.")
            return

        if not VAULT_PATH.exists():
            self.pin = pin
            initial_entry = {
                "id": str(datetime.now().timestamp()),
                "date": date.today().isoformat(),
                "time": datetime.now().strftime("%I:%M %p"),
                "title": "Welcome to Note",
                "content": "# Welcome to Note\n\nYour thoughts are encrypted locally on your machine with AES-256. Zero plain-text on disk, zero distraction.\n\n- Switch between all 17 Colorways (Dark, Light, Amber, Midnight Purple, Emerald, Crimson, etc.).\n- Use the interactive Calendar to travel across dates.\n- Toggle Zen Focus for pure distraction-free flow.",
                "tags": "welcome, journal",
                "mood": "zen"
            }
            self.entries = [initial_entry]
            self.save_vault()
            self.load_workspace()
        else:
            try:
                with open(VAULT_PATH, "r") as f:
                    payload = json.load(f)
                decrypted_json = decrypt_string(payload, pin)
                self.entries = json.loads(decrypted_json)
                self.pin = pin
                self.load_workspace()
            except Exception:
                self.auth_msg.setText("Incorrect PIN or corrupted vault.")

    def save_vault(self):
        if self.pin:
            try:
                VAULT_PATH.parent.mkdir(parents=True, exist_ok=True)
                payload = encrypt_string(json.dumps(self.entries), self.pin)
                with open(VAULT_PATH, "w") as f:
                    json.dump(payload, f)
            except Exception as e:
                print("Save error:", e)

    def init_main_workspace(self):
        self.main_widget = QWidget()
        main_layout = QHBoxLayout(self.main_widget)
        main_layout.setContentsMargins(12, 12, 12, 12)
        main_layout.setSpacing(12)

        self.splitter = QSplitter(Qt.Horizontal)
        self.splitter.setChildrenCollapsible(False)

        # Left Sidebar
        self.sidebar = QWidget()
        self.sidebar.setMinimumWidth(260)
        sidebar_layout = QVBoxLayout(self.sidebar)
        sidebar_layout.setContentsMargins(0, 0, 4, 0)
        sidebar_layout.setSpacing(10)

        # Header
        sb_header = QHBoxLayout()
        sb_title = QLabel("󰠮 NOTE")
        sb_title.setFont(QFont("JetBrainsMono Nerd Font", 12, QFont.Bold))
        sb_header.addWidget(sb_title)
        sb_header.addStretch()

        lock_btn = QPushButton("󰌾 Lock")
        lock_btn.setCursor(QCursor(Qt.PointingHandCursor))
        lock_btn.clicked.connect(self.lock_vault)
        sb_header.addWidget(lock_btn)
        sidebar_layout.addLayout(sb_header)

        # Calendar Widget
        self.calendar = AestheticCalendarWidget(self.on_date_selected)
        sidebar_layout.addWidget(self.calendar)

        # Entry List Controls
