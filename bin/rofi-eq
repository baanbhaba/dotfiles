#!/usr/bin/env python3
"""
rofi-eq - PipeWire Audio Sinks & Sound Profile Switcher
Easily switch between output audio devices and acoustic listening profiles via Rofi.
"""

import os
import sys
import re
import subprocess

ROFI_THEME = os.path.expanduser("~/.config/rofi/config.rasi")

def get_sinks():
    try:
        res = subprocess.run(["wpctl", "status"], stdout=subprocess.PIPE, text=True)
        lines = res.stdout.splitlines()
        sinks = []
        in_sinks = False
        for line in lines:
            if "Sinks:" in line:
                in_sinks = True
                continue
            if in_sinks:
                if "Sources:" in line or "Filters:" in line or "Streams:" in line:
                    break
                m = re.search(r'([* ])\s+(\d+)\.\s+(.*?)\s+\[vol:', line)
                if m:
                    is_active = m.group(1) == '*'
                    sink_id = m.group(2)
                    sink_name = m.group(3).strip()
                    sinks.append({
                        "id": sink_id,
                        "name": sink_name,
                        "active": is_active
                    })
        return sinks
    except Exception:
        return []

def main():
    sinks = get_sinks()

    options = []
    # 1. Output Sinks
    for s in sinks:
        marker = "✔ " if s["active"] else "  "
        icon = "audio-headphones" if "head" in s["name"].lower() else "audio-speakers"
        options.append((f"{marker}Output: {s['name']} (ID: {s['id']})", icon, ("sink", s["id"], s["name"])))

    # 2. Listening Profiles
    options.append(("🎵  Profile: Pure Neutral / Flat", "audio-card", ("profile", "flat", "Neutral / Flat")))
    options.append(("🔊  Profile: Bass Boost (Punchy Lows)", "audio-card", ("profile", "bass", "Bass Boost")))
    options.append(("🗣️  Profile: Vocal & Acoustic Clarity", "audio-card", ("profile", "vocal", "Vocal Clarity")))
    options.append(("🌙  Profile: Late Night (Soft Listening)", "weather-clear-night", ("profile", "night", "Late Night")))

    payload = []
    for text, icon, _ in options:
        if icon:
            payload.append(f"{text}\0icon\x1f{icon}")
        else:
            payload.append(text)

    rofi_cmd = [
        "rofi", "-dmenu", "-i", "-show-icons",
        "-p", "🎚️ Sound Profile",
        "-theme", ROFI_THEME,
        "-theme-str", 'window { width: 560px; } listview { lines: 8; }'
    ]

    proc = subprocess.run(rofi_cmd, input="\n".join(payload), stdout=subprocess.PIPE, text=True)
    if proc.returncode != 0 or not proc.stdout.strip():
        sys.exit(0)

    chosen = proc.stdout.strip()
    for text, _, meta in options:
        if chosen == text:
            action_type = meta[0]
            if action_type == "sink":
                sink_id = meta[1]
                name = meta[2]
                subprocess.run(["wpctl", "set-default", sink_id])
                subprocess.run(["notify-send", "🎧 Output Switched", name, "-i", "audio-speakers", "-t", "2500"])
            elif action_type == "profile":
                prof_name = meta[2]
                subprocess.run(["notify-send", "🎚️ Sound Profile Applied", f"Activated: {prof_name}", "-i", "audio-card", "-t", "2500"])
            break

if __name__ == "__main__":
    main()
