def get_theme_colors():
    theme = "colorblock"
    if os.path.exists(THEME_FILE):
        try:
            with open(THEME_FILE, "r") as f:
                theme = f.read().strip()
        except Exception:
            pass
    return PALETTES.get(theme, PALETTES["darkbrutalism"]), theme

