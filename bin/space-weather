#!/usr/bin/env python3
"""
space-weather - Themed Space Weather & Atmospheric Telemetry Radar
Fetches live NOAA SWPC (Planetary K-Index, Solar Wind Speed, IMF Bz, 10.7cm Flux)
and Lunar / Terrestrial atmospheric telemetry (wttr.in).
Styled with theme-adaptive brutalist ASCII typography.
"""

import os
import sys
import time
import json
import argparse
import urllib.request
from concurrent.futures import ThreadPoolExecutor

CACHE_DIR = os.path.expanduser("~/.cache/space-weather")
CACHE_FILE = os.path.join(CACHE_DIR, "telemetry.json")
THEME_FILE = os.path.expanduser("~/.config/hypr/.theme_current")
CACHE_TTL = 300  # 5 minutes cache

os.makedirs(CACHE_DIR, exist_ok=True)

# ─────────────────────────────────────────────────────────────────────────────
