#!/usr/bin/env bash
SHADER_PATH="$HOME/.config/hypr/shaders/nightlight.frag"

# Check if screen_shader is currently set
CURRENT=$(hyprctl getoption decoration:screen_shader -j | grep '"str":' | awk -F '"' '{print $4}')

if [ -n "$CURRENT" ] && [ "$CURRENT" != "[[EMPTY]]" ] && [ "$CURRENT" != "none" ]; then
    hyprctl keyword decoration:screen_shader "[[EMPTY]]"
    notify-send -t 1500 -a "Night Light" "🌙 Night Light Off" "Screen restored to standard colors."
else
    hyprctl keyword decoration:screen_shader "$SHADER_PATH"
    notify-send -t 1500 -a "Night Light" "🌙 Night Light On" "Warm amber blue-light filter activated."
fi
