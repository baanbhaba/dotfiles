{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": { "1": "yellow", "2": "magenta" },
        "padding": { "right": 2 }
    },
    "display": { "separator": "  › " },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "os", "keyColor": "yellow" },
        { "type": "kernel", "key": "kernel", "keyColor": "magenta" },
        { "type": "wm", "key": "wm", "keyColor": "blue" },
        { "type": "shell", "key": "shell", "keyColor": "green" },
        { "type": "terminal", "key": "term", "keyColor": "magenta" },
        "separator",
        { "type": "cpu", "key": "cpu", "keyColor": "yellow" },
        { "type": "memory", "key": "ram", "keyColor": "green" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
