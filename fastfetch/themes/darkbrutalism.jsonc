{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data",
        "source": "           ▄▄▄▄▄▄▄▄\n        ▄██▀▀    ▀▀██▄\n      ▄██▀  ▄████▄  ▀██▄\n     ▄██   ▄██▀  ▀   ▄███\n     ███   ███      ▄██▀██\n▄▄▄▄ ███   ███     ▄██▀ ███\n▄██▀▀████   ███    ▄██▀  ███\n███   ███   ███   ▄██▀   ███\n▀██▄▄██▀    ▀██▄▄▄██▀    ███\n ▀▀▀▀        ▀▀▀▀▀      ███",
        "color": { "1": "yellow", "2": "cyan" },
        "padding": { "right": 3 }
    },
    "display": {
        "separator": " █ ",
        "percent": { "type": 3 },
        "bar": {
            "char": { "elapsed": "█", "total": "░" },
            "border": { "left": "[ ", "right": " ]" },
            "width": 10
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#33}⚡ {#1}{user-name}{#}{#35}@{host-name}{#}"
        },
        {
            "type": "separator",
            "string": "━",
            "outputColor": "33"
        },
        { "type": "os", "key": "⚡ OS    ", "keyColor": "yellow" },
        { "type": "kernel", "key": "📦 KERNEL", "keyColor": "magenta" },
        { "type": "wm", "key": "🪟 WM    ", "keyColor": "cyan" },
        { "type": "shell", "key": "🐚 SHELL ", "keyColor": "green" },
        { "type": "terminal", "key": "💻 TERM  ", "keyColor": "magenta" },
        { "type": "uptime", "key": "⏰ UPTIME", "keyColor": "yellow" },
        {
            "type": "separator",
            "string": "━",
            "outputColor": "33"
        },
        { "type": "cpu", "key": "🔥 CPU   ", "keyColor": "red" },
        { "type": "memory", "key": "🧠 RAM   ", "keyColor": "magenta" },
        { "type": "battery", "key": "🔋 BAT   ", "keyColor": "cyan" },
        "break",
        { "type": "colors", "symbol": "block" }
    ]
}
