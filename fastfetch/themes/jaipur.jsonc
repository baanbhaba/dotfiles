{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data",
        "source": "           ▄▄▄▄▄▄▄▄\n        ▄██▀▀    ▀▀██▄\n      ▄██▀  ▄████▄  ▀██▄\n     ▄██   ▄██▀  ▀   ▄███\n     ███   ███      ▄██▀██\n▄▄▄▄ ███   ███     ▄██▀ ███\n▄██▀▀████   ███    ▄██▀  ███\n███   ███   ███   ▄██▀   ███\n▀██▄▄██▀    ▀██▄▄▄██▀    ███\n ▀▀▀▀        ▀▀▀▀▀      ███",
        "color": { "1": "red", "2": "yellow" },
        "padding": { "right": 3 }
    },
    "display": {
        "separator": " ❯ ",
        "percent": { "type": 3 },
        "bar": {
            "char": { "elapsed": "◆", "total": "─" },
            "border": { "left": "[ ", "right": " ]" },
            "width": 10
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#31}🏛️  {#1}{user-name}{#}{#33}@{host-name}{#}"
        },
        {
            "type": "separator",
            "string": "─",
            "outputColor": "31"
        },
        { "type": "os", "key": "🏛️  OS    ", "keyColor": "yellow" },
        { "type": "kernel", "key": "📜 KERNEL", "keyColor": "yellow" },
        { "type": "wm", "key": "🕌 WM    ", "keyColor": "yellow" },
        { "type": "shell", "key": "⚜️  SHELL ", "keyColor": "yellow" },
        { "type": "terminal", "key": "💠 TERM  ", "keyColor": "yellow" },
        { "type": "uptime", "key": "🏮 UPTIME", "keyColor": "yellow" },
        {
            "type": "separator",
            "string": "─",
            "outputColor": "31"
        },
        { "type": "cpu", "key": "👑 CPU   ", "keyColor": "yellow" },
        { "type": "memory", "key": "🏺 RAM   ", "keyColor": "yellow" },
        { "type": "battery", "key": "🪔 BAT   ", "keyColor": "yellow" },
        "break",
        { "type": "colors", "symbol": "diamond" }
    ]
}
