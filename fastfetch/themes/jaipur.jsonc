{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": { "1": "red", "2": "yellow" },
        "padding": { "right": 2 }
    },
    "display": { "separator": " · " },
    "modules": [
        { "type": "title", "color": { "user": "red", "at": "white", "host": "yellow" } },
        "separator",
        { "type": "os", "key": "🏛️ OS", "keyColor": "red" },
        { "type": "kernel", "key": "📜 Kernel", "keyColor": "yellow" },
        { "type": "wm", "key": "🕌 WM", "keyColor": "red" },
        { "type": "shell", "key": "⚜️ Shell", "keyColor": "yellow" },
        { "type": "terminal", "key": "💠 Term", "keyColor": "white" },
        "separator",
        { "type": "cpu", "key": "👑 CPU", "keyColor": "yellow" },
        { "type": "memory", "key": "🏺 RAM", "keyColor": "red" },
        "break",
        { "type": "colors", "symbol": "diamond" }
    ]
}
