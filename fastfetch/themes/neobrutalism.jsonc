{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": { "1": "magenta", "2": "yellow" },
        "padding": { "right": 3 }
    },
    "display": {
        "separator": " █ ",
        "color": { "separator": "black" }
    },
    "modules": [
        { "type": "title", "color": { "user": "magenta", "at": "black", "host": "yellow" } },
        "separator",
        { "type": "os", "key": "⚡ OS", "keyColor": "magenta" },
        { "type": "kernel", "key": "📦 Kernel", "keyColor": "yellow" },
        { "type": "wm", "key": "🪟 WM", "keyColor": "cyan" },
        { "type": "shell", "key": "🐚 Shell", "keyColor": "magenta" },
        { "type": "terminal", "key": "💻 Term", "keyColor": "blue" },
        "separator",
        { "type": "cpu", "key": "🔥 CPU", "keyColor": "yellow" },
        { "type": "memory", "key": "🧠 RAM", "keyColor": "cyan" },
        { "type": "battery", "key": "🔋 Bat", "keyColor": "green" },
        "break",
        { "type": "colors", "symbol": "block" }
    ]
}
