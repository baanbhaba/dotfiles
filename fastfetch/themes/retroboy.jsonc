{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data",
        "source": " ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄ \n█ ▄▄▄▄▄▄▄▄▄▄▄▄▄ █\n█ █ ░░░░░░░░░ █ █\n█ █ ░RETROBOY░ █ █\n█ █ ░░░░░░░░░ █ █\n█ ▀▀▀▀▀▀▀▀▀▀▀▀▀ █\n█               █\n█    ▄     ▄▄   █\n█  ▄███▄   ██ ▄▄█\n█    ▀        ███\n ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀ ",
        "color": { "1": "green", "2": "yellow" },
        "padding": { "right": 3 }
    },
    "display": {
        "separator": " █ ",
        "percent": { "type": 3 },
        "bar": {
            "char": { "elapsed": "█", "total": "░" },
            "border": { "left": "[ ", "right": " ]" },
            "width": 10
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#32}👾 {#1}{user-name}{#}{#32}@{host-name}{#}"
        },
        {
            "type": "separator",
            "string": "━",
            "outputColor": "32"
        },
        { "type": "os", "key": "👾 SYSTEM ", "keyColor": "green" },
        { "type": "kernel", "key": "📦 KERNEL ", "keyColor": "green" },
        { "type": "wm", "key": "🪟 WINDOW ", "keyColor": "green" },
        { "type": "shell", "key": "🐚 SHELL  ", "keyColor": "green" },
        { "type": "terminal", "key": "💻 CONSOLE", "keyColor": "green" },
        { "type": "uptime", "key": "⏰ RUNTIME", "keyColor": "green" },
        {
            "type": "separator",
            "string": "━",
            "outputColor": "32"
        },
        { "type": "cpu", "key": "⚡ CPU    ", "keyColor": "green" },
        { "type": "memory", "key": "💾 RAM    ", "keyColor": "green" },
        { "type": "battery", "key": "🔋 POWER  ", "keyColor": "green" },
        {
            "type": "colors",
            "padding": { "left": 1 }
        }
    ]
}
