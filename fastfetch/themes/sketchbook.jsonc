{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data",
        "source": "           ▄▄▄▄▄▄▄▄\n        ▄██▀▀    ▀▀██▄\n      ▄██▀  ▄████▄  ▀██▄\n     ▄██   ▄██▀  ▀   ▄███\n     ███   ███      ▄██▀██\n▄▄▄▄ ███   ███     ▄██▀ ███\n▄██▀▀████   ███    ▄██▀  ███\n███   ███   ███   ▄██▀   ███\n▀██▄▄██▀    ▀██▄▄▄██▀    ███\n ▀▀▀▀        ▀▀▀▀▀      ███",
        "color": { "1": "white", "2": "bright_black" },
        "padding": { "right": 3 }
    },
    "display": {
        "separator": " · ",
        "percent": { "type": 3 },
        "bar": {
            "char": { "elapsed": "▪", "total": "┄" },
            "border": { "left": "[ ", "right": " ]" },
            "width": 10
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#37}✎ {#1}{user-name}{#}{#90}@{host-name}{#}"
        },
        {
            "type": "separator",
            "string": "┄",
            "outputColor": "90"
        },
        { "type": "os", "key": "📐 OS    ", "keyColor": "white" },
        { "type": "kernel", "key": "📏 KERNEL", "keyColor": "white" },
        { "type": "wm", "key": "✏️  WM    ", "keyColor": "white" },
        { "type": "shell", "key": "🖋️  SHELL ", "keyColor": "white" },
        { "type": "terminal", "key": "📄 TERM  ", "keyColor": "white" },
        { "type": "uptime", "key": "⏳ UPTIME", "keyColor": "white" },
        {
            "type": "separator",
            "string": "┄",
            "outputColor": "90"
        },
        { "type": "cpu", "key": "⚙️  CPU   ", "keyColor": "white" },
        { "type": "memory", "key": "📊 RAM   ", "keyColor": "white" },
        { "type": "battery", "key": "🔋 BAT   ", "keyColor": "white" },
        "break",
        { "type": "colors", "symbol": "diamond" }
    ]
}
