# --- GLOBAL SETTINGS ---
max-history=100
sort=-time
font=JetBrainsMono Nerd Font 14
width=350
height=200
margin=15
padding=10
default-timeout=4000
icons=1
max-icon-size=48

# --- DEFAULT STYLE (Amber CRT/Charcoal) ---
background-color=#080808f2
text-color=#ffb000
border-color=#ffb000
border-size=1
border-radius=3
progress-color=source #ffb000

# --- AMBER ALERT (Critical/Low Battery) ---
[urgency=critical]
border-color=#ff5c00
text-color=#ffb000
default-timeout=0
ignore-timeout=1

# --- LOW URGENCY ---
[urgency=low]
border-color=#3a3a3a
text-color=#8c9b32
default-timeout=2000

# --- CATEGORY OVERRIDES ---
[category=mpd]
default-timeout=2000
group-by=category
