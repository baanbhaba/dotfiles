# ─────────────────────────────────────────────────────
# COLORBLOCK MAKO NOTIFICATION THEME
# ─────────────────────────────────────────────────────

max-history=100
sort=-time
font=JetBrainsMono Nerd Font 13
width=380
height=220
margin=14
padding=14
default-timeout=4500
icons=1
max-icon-size=48

background-color=#f2ede4ee
text-color=#1e2022
border-color=#e5a93c
border-size=3
border-radius=14
progress-color=source #e5a93c

[urgency=critical]
border-color=#d96b52
default-timeout=0
ignore-timeout=1
background-color=#f2ede4ee

[urgency=low]
border-color=#8e7ca8
default-timeout=2500
text-color=#5a5e63

[category=mpd]
default-timeout=2500
group-by=category
border-color=#4d7c8a
