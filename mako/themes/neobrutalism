# -----------------------------------------------------
# MAKO THEME - NEO-BRUTALISM (LIGHT MODE)
# Thick Black Outlines & High Contrast Cards
# -----------------------------------------------------

# --- GLOBAL SETTINGS ---
max-history=100
sort=-time
font=JetBrainsMono Nerd Font 13
width=360
height=220
margin=16
padding=14
default-timeout=5000
icons=1
max-icon-size=48

# --- DEFAULT STYLE (Off-White Card with Thick 3px Black Border) ---
background-color=#fffdf0ff
text-color=#000000
border-color=#000000
border-size=3
border-radius=4
progress-color=source #ff006e

# --- CRITICAL ALERT (Hot Pink Card) ---
[urgency=critical]
background-color=#ff006eff
text-color=#ffffff
border-color=#000000
border-size=3
default-timeout=0
ignore-timeout=1

# --- LOW URGENCY (Cyber Cyan Card) ---
[urgency=low]
background-color=#00f5d4ff
text-color=#000000
border-color=#000000
border-size=3
default-timeout=2500
