# -----------------------------------------------------
# MAKO THEME - RETROBOY (GAMEBOY DMG PIXEL CARD)
# -----------------------------------------------------

# --- GLOBAL SETTINGS ---
max-history=100
sort=-time
font=Silkscreen 12
width=360
height=200
margin=14
padding=14
default-timeout=5000
icons=1
max-icon-size=44

# --- DEFAULT STYLE (GameBoy Dot-Matrix LCD Screen) ---
background-color=#9bbc0fff
text-color=#0f380f
border-color=#0f380f
border-size=4
border-radius=0
progress-color=source #306230

# --- CRITICAL ALERT ---
[urgency=critical]
background-color=#8bac0fff
text-color=#0f380f
border-color=#0f380f
border-size=4
border-radius=0
default-timeout=0
ignore-timeout=1

# --- LOW URGENCY ---
[urgency=low]
background-color=#9bbc0fff
text-color=#306230
border-color=#0f380f
border-size=4
border-radius=0
default-timeout=2500
