# --- GLOBAL SETTINGS ---
max-history=100
sort=-time
font=JetBrainsMono Nerd Font 13
width=350
height=180
margin=15
padding=14
default-timeout=4000
icons=1
max-icon-size=48

# --- DEFAULT STYLE (Sketchbook Paper Card) ---
background-color=#ffffffee
text-color=#18181b
border-color=#d4d4d8
border-size=1
border-radius=10
progress-color=source #18181b

# --- CRITICAL ALERT ---
[urgency=critical]
border-color=#e11d48
text-color=#e11d48
default-timeout=0
ignore-timeout=1

# --- LOW URGENCY ---
[urgency=low]
border-color=#e4e4e7
text-color=#71717a
default-timeout=2000

# --- CATEGORY OVERRIDES ---
[category=mpd]
default-timeout=2000
group-by=category
