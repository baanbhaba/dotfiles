configuration {
    modi: "drun,run";
    show-icons: false;
    display-drun: " ";
    display-run: " ";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 10";
}

* {
    bg: #080808;              /* CRT Black */
    fg: #8c9b32;              /* Muted Amber Green */
    highlight: #ffb000;       /* Amber Selection Box */
    text-selected: #080808;   /* Dark text on selection */
    text-active: #ffffff;     /* Bright White Typing Text */
}

window {
    width: 700px;
    background-color: @bg;
    border: 1px;
    border-color: #ffb000;
    padding: 25px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: transparent;
    margin: 0 0 15px 0;
    children: [ prompt, entry ];
    border-bottom: 1px;
    border-color: #ffb000;
    padding-bottom: 8px;
}

prompt {
    background-color: transparent;
    text-color: #ffb000;
    margin: 0 8px 0 0;
}

entry {
    background-color: transparent;
    text-color: #ffffff;      /* High-contrast crisp white typing text */
    placeholder: "Search...";
    placeholder-color: #555555;
    cursor-color: #ffb000;
}

listview {
    background-color: transparent;
    lines: 7;
    spacing: 5;
    scrollbar: false;
}

element {
    padding: 12px;
    border-radius: 2px;
    background-color: transparent;
    text-color: @fg;
}

element selected {
    background-color: @highlight;
    text-color: @text-selected;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
