/* -----------------------------------------------------
   CHARCOAL THEME - Rofi
   Floating CRT Terminal Card & Amber Gold Typography
   ----------------------------------------------------- */

configuration {
    modi: "drun,run";
    show-icons: false;
    display-drun: "󰘧 ";
    display-run: " ";
    drun-display-format: "{name}";
    font: "Hack 11";
}

* {
    bg: #080808;
    fg: #8c9b32;
    highlight: rgba(255, 176, 0, 0.10);
    text-selected: #ffb000;
    text-active: #ffb000;
}

window {
    width: 680px;
    background-color: @bg;
    border: 1px;
    border-color: #222222;
    border-radius: 10px;
    padding: 24px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: transparent;
    children: [ prompt, entry ];
    border-bottom: 1px;
    border-color: #222222;
    padding-bottom: 10px;
}

prompt {
    background-color: transparent;
    text-color: @text-active;
}

entry {
    background-color: transparent;
    text-color: #ffffff;
    placeholder: "Execute command...";
    placeholder-color: #636b28;
}

listview {
    background-color: transparent;
    lines: 7;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 10px 14px;
    border-radius: 6px;
    background-color: transparent;
    text-color: @fg;
}

element selected {
    background-color: @highlight;
    text-color: @text-selected;
    border-radius: 6px;
    border: 1px;
    border-color: #ffb000;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font-weight: bold;
}
