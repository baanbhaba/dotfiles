/* -----------------------------------------------------
   COLORBLOCK THEME - Rofi
   Floating Warm Linen Card & Pastel Ochre Highlights
   ----------------------------------------------------- */

configuration {
    modi: "drun,run";
    show-icons: false;
    display-drun: "󰄯 ";
    display-run: " ";
    drun-display-format: "{name}";
    font: "Space Grotesk 11";
}

* {
    bg: #f2ede4;
    fg: #7a7065;
    highlight: #ffffff;
    text-selected: #1e2022;
    text-active: #1e2022;
    border-subtle: #ded3c0;
    accent-ochre: #e5a93c;
}

window {
    width: 680px;
    background-color: @bg;
    border: 1px;
    border-color: @border-subtle;
    border-radius: 12px;
    padding: 24px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: transparent;
    children: [ prompt, entry ];
    border-bottom: 1px;
    border-color: @border-subtle;
    padding-bottom: 10px;
}

prompt {
    background-color: transparent;
    text-color: @accent-ochre;
}

entry {
    background-color: transparent;
    text-color: @text-active;
    placeholder: "Search applications & commands...";
    placeholder-color: #a39788;
}

listview {
    background-color: transparent;
    lines: 7;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 10px 14px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @fg;
}

element selected {
    background-color: @highlight;
    text-color: @text-selected;
    border-radius: 8px;
    border: 1px;
    border-color: @accent-ochre;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font-weight: bold;
}
