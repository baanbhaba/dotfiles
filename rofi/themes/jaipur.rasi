/* -----------------------------------------------------
   JAIPUR THEME - Rofi
   Floating Terracotta Palace Card & Royal Gold Typography
   ----------------------------------------------------- */

configuration {
    modi: "drun,run";
    show-icons: false;
    display-drun: "👑 ";
    display-run: " ";
    drun-display-format: "{name}";
    font: "Cinzel 11";
}

* {
    bg: #1a0404;
    fg: #a0845c;
    highlight: rgba(212, 168, 71, 0.12);
    text-selected: #d4a847;
    text-active: #f5ede3;
    border-subtle: #4a1515;
}

window {
    width: 680px;
    background-color: @bg;
    border: 1px;
    border-color: @border-subtle;
    border-radius: 10px;
    padding: 24px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: transparent;
    children: [ prompt, entry ];
    border-bottom: 1px;
    border-color: @border-subtle;
    padding-bottom: 10px;
}

prompt {
    background-color: transparent;
    text-color: #d4a847;
}

entry {
    background-color: transparent;
    text-color: @text-active;
    placeholder: "Search royal archives...";
    placeholder-color: #7a5c3a;
}

listview {
    background-color: transparent;
    lines: 7;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 10px 14px;
    border-radius: 6px;
    background-color: transparent;
    text-color: @fg;
}

element selected {
    background-color: @highlight;
    text-color: @text-selected;
    border-radius: 6px;
    border: 1px;
    border-color: #d4a847;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font-weight: bold;
}
