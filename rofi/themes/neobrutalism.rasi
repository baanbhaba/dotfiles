/* -----------------------------------------------------
   NEO-BRUTALISM THEME - Rofi
   Floating Cream Paper Card & Bold Graphic Black Frame
   ----------------------------------------------------- */

configuration {
    modi: "drun,run";
    show-icons: false;
    display-drun: "🚀 ";
    display-run: " ";
    drun-display-format: "{name}";
    font: "Nunito 12";
}

* {
    bg: #fffdf0;
    fg: #555555;
    highlight: #ffbe0b;
    text-selected: #000000;
    text-active: #000000;
    border-color: #000000;
}

window {
    width: 680px;
    background-color: @bg;
    border: 2px;
    border-color: @border-color;
    border-radius: 10px;
    padding: 24px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: transparent;
    children: [ prompt, entry ];
    border-bottom: 2px;
    border-color: @border-color;
    padding-bottom: 10px;
}

prompt {
    background-color: transparent;
    text-color: @text-active;
}

entry {
    background-color: transparent;
    text-color: @text-active;
    placeholder: "Launch application...";
    placeholder-color: #888888;
}

listview {
    background-color: transparent;
    lines: 7;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 10px 14px;
    border-radius: 6px;
    background-color: transparent;
    text-color: @fg;
}

element selected {
    background-color: @highlight;
    text-color: @text-selected;
    border-radius: 6px;
    border: 2px;
    border-color: @border-color;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font-weight: bold;
}
