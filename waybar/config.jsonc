{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 4,

    "modules-left": [
        "custom/ws1",
        "custom/ws2",
        "custom/ws3",
        "custom/ws4",
        "custom/ws5",
        "custom/ws6",
        "custom/ws7",
        "custom/ws8",
        "custom/ws9"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "cpu",
        "memory",
        "battery",
        "tray"
    ],

    "custom/ws1": {
        "format": "1",
        "on-click": "sh -c 'hyprctl dispatch workspace 1'"
    },

    "custom/ws2": {
        "format": "2",
        "on-click": "sh -c 'hyprctl dispatch workspace 2'"
    },

    "custom/ws3": {
        "format": "3",
        "on-click": "sh -c 'hyprctl dispatch workspace 3'"
    },

    "custom/ws4": {
        "format": "4",
        "on-click": "sh -c 'hyprctl dispatch workspace 4'"
    },

    "custom/ws5": {
        "format": "5",
        "on-click": "sh -c 'hyprctl dispatch workspace 5'"
    },

    "custom/ws6": {
        "format": "6",
        "on-click": "sh -c 'hyprctl dispatch workspace 6'"
    },

    "custom/ws7": {
        "format": "7",
        "on-click": "sh -c 'hyprctl dispatch workspace 7'"
    },

    "custom/ws8": {
        "format": "8",
        "on-click": "sh -c 'hyprctl dispatch workspace 8'"
    },

    "custom/ws9": {
        "format": "9",
        "on-click": "sh -c 'hyprctl dispatch workspace 9'"
    },

    "clock": {
        "format": "{:%H:%M  %a %d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "  {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": "  {}%"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },

    "tray": {
        "spacing": 10
    }
}
