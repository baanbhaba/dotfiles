        "on-click": "~/.config/waybar/themes/charcoal/ws_button.sh 6 switch",
        "tooltip": false
    },

    "custom/ws7": {
        "exec": "~/.config/waybar/themes/charcoal/ws_button.sh 7",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/themes/charcoal/ws_button.sh 7 switch",
        "tooltip": false
    },

    "custom/ws8": {
        "exec": "~/.config/waybar/themes/charcoal/ws_button.sh 8",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/themes/charcoal/ws_button.sh 8 switch",
        "tooltip": false
    },

    "custom/ws9": {
        "exec": "~/.config/waybar/themes/charcoal/ws_button.sh 9",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/themes/charcoal/ws_button.sh 9 switch",
        "tooltip": false
    },

    "clock": {
        "format": "{:%I:%M %p | %a %d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><big>{calendar}</big></tt>"
    },

    "custom/clipboard": {
        "format": "clipboard",
        "on-click": "~/.local/bin/clipboard-menu",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "volume {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "battery {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
