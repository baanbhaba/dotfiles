{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 4,

    "modules-left": [
        "custom/music",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock",
        "network"
    ],

    "modules-right": [
        "custom/clipboard",
        "pulseaudio",
        "battery",
        "tray"
    ],

    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "format": "{id}",
        "on-click": "hyprctl dispatch workspace {id}"
    },

    "clock": {
        "interval": 60,
        "format": "󱑂 {:%I:%M %p | %a, %d %b}",
        "format-alt": "󰃭 {:%A, %B %d, %Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#ffb000'><b>{}</b></span>",
                "days":       "<span color='#e0e0e0'><b>{}</b></span>",
                "weeks":      "<span color='#8c9b32'><b>W{}</b></span>",
                "weekdays":   "<span color='#ffd166'><b>{}</b></span>",
                "today":      "<span background='#ffb000' color='#080808'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/music": {
        "format": "{}",
        "return-type": "json",
        "exec": "/home/baanbhaba/.local/bin/waybar-music",
        "interval": 2,
        "on-click": "/home/baanbhaba/.local/bin/music-click --toggle",
        "on-click-right": "/home/baanbhaba/.local/bin/music-click --library",
        "on-click-middle": "playerctl -p com.github.neithern.g4music play-pause",
        "on-scroll-up": "/home/baanbhaba/.local/bin/flac-queue next",
        "on-scroll-down": "/home/baanbhaba/.local/bin/flac-queue prev",
        "tooltip": true
    },

    "custom/weather": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.local/bin/waybar-weather",
        "on-click": "~/.local/bin/toggle-space-weather",
        "interval": 900,
        "tooltip": true
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 eth",
        "format-disconnected": "󰤭 off",
        "max-length": 18,
        "interval": 5,
        "on-click": "~/.local/bin/rofi-wifi",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr} | ⇡ {bandwidthUpBytes} ⇣ {bandwidthDownBytes}"
    },

    "custom/clipboard": {
        "format": "clip",
        "on-click": "~/.local/bin/clipboard-menu",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "Volume: {volume}%\nDevice: {desc}\n🖱️ Click: Audio Mixer\n🖱️ Right-Click: Mute Toggle\n📜 Scroll: Adjust Volume"
    },

    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "battery {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
