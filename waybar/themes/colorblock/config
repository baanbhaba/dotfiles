{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 4,
    "passthrough": false,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/clipboard",
        "pulseaudio",
        "battery",
        "tray"
    ],

    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "format": "{id}",
        "on-click": "hyprctl dispatch workspace {id}"
    },

    "clock": {
        "format": "{:%I:%M %p | %a %d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><big>{calendar}</big></tt>"
    },

    "custom/clipboard": {
        "format": "clipboard",
        "on-click": "~/.local/bin/clipboard-menu",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "volume {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "battery {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
