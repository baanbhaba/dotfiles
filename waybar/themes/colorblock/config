{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 10,
    "margin-left": 18,
    "margin-right": 18,
    "spacing": 8,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/clipboard",
        "pulseaudio",
        "battery",
        "tray"
    ],

    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "hyprctl dispatch workspace {id}"
    },

    "clock": {
        "interval": 60,
        "format": "☕ {:%I:%M %p  ·  %a %d}",
        "format-alt": "🗓️ {:%A, %B %d, %Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>"
    },

    "custom/clipboard": {
        "format": "󰅌",
        "on-click": "~/.local/bin/clipboard-menu",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟",
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": { "warning": 20, "critical": 10 },
        "format": "󰁹 {capacity}%",
        "format-charging": "󰂄 {capacity}%"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
