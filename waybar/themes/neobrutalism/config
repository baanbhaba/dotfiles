    "clock": {
        "interval": 60,
        "format": "󱑂 {:%I:%M %p | %a, %d %b}",
        "format-alt": "󰃭 {:%A, %B %d, %Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#000000'><b>{}</b></span>",
                "days":       "<span color='#222222'><b>{}</b></span>",
                "weeks":      "<span color='#ff006e'><b>W{}</b></span>",
                "weekdays":   "<span color='#8338ec'><b>{}</b></span>",
                "today":      "<span background='#ffbe0b' color='#000000'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/clipboard": {
        "format": "📋 CLIPBOARD",
        "on-click": "~/.local/bin/clipboard-menu",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTED",
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "BAT {capacity}%",
        "format-charging": "CHG {capacity}%"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
