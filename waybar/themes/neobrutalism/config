{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,

    "modules-left": [
        "custom/ws1",
        "custom/ws2",
        "custom/ws3",
        "custom/ws4",
        "custom/ws5",
        "custom/ws6",
        "custom/ws7",
        "custom/ws8",
        "custom/ws9"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/clipboard",
        "pulseaudio",
        "battery",
        "tray"
    ],

    "custom/ws1": {
        "exec": "~/.config/waybar/themes/neobrutalism/ws_button.sh 1",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/themes/neobrutalism/ws_button.sh 1 switch",
        "tooltip": false
    },

