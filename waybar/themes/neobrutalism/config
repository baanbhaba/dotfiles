        "interval": 1,
        "on-click": "~/.config/waybar/themes/neobrutalism/ws_button.sh 6 switch",
        "tooltip": false
    },
    "custom/ws7": {
        "exec": "~/.config/waybar/themes/neobrutalism/ws_button.sh 7",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/themes/neobrutalism/ws_button.sh 7 switch",
        "tooltip": false
    },
    "custom/ws8": {
        "exec": "~/.config/waybar/themes/neobrutalism/ws_button.sh 8",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/themes/neobrutalism/ws_button.sh 8 switch",
