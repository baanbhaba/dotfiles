        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/themes/neobrutalism/ws_button.sh 9 switch",
        "tooltip": false
    },

    "clock": {
        "interval": 60,
        "format": "⏰ {:%I:%M %p | %a, %d %b}",
        "format-alt": "📅 {:%A, %B %d, %Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#000000'><b>{}</b></span>",
                "days":       "<span color='#000000'><b>{}</b></span>",
                "weeks":      "<span color='#ff006e'><b>W{}</b></span>",
                "weekdays":   "<span color='#8338ec'><b>{}</b></span>",
                "today":      "<span background='#ffbe0b' color='#000000'><b>{}</b></span>"
            }
        }
    },

    "custom/clipboard": {
        "format": "📋 CLIPS",
        "on-click": "~/.local/bin/clipboard-menu",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "🔊 {volume}%",
        "format-muted": "🔇 MUTED",
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": { "warning": 20, "critical": 10 },
        "format": "🔋 {capacity}%",
        "format-charging": "⚡ {capacity}%"
    },

    "custom/power": {
        "format": "💥 OFF",
        "on-click": "~/.config/rofi/powermenu.sh",
        "tooltip": false
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    }
}
