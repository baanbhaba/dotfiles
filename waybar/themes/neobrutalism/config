{
    "layer": "top",
    "position": "bottom",
    "height": 42,
    "margin-bottom": 12,
    "margin-left": 16,
    "margin-right": 16,
    "spacing": 10,

    "modules-left": [
        "custom/launcher",
        "custom/ws1",
        "custom/ws2",
        "custom/ws3",
        "custom/ws4",
        "custom/ws5",
        "custom/ws6",
        "custom/ws7",
        "custom/ws8",
        "custom/ws9"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/clipboard",
        "pulseaudio",
        "battery",
        "tray",
        "custom/power"
    ],

    "custom/launcher": {
        "format": "⚡ START",
        "on-click": "rofi -show drun",
        "tooltip": false
    },

    "custom/ws1": {
        "exec": "~/.config/waybar/themes/neobrutalism/ws_button.sh 1",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/themes/neobrutalism/ws_button.sh 1 switch",
        "tooltip": false
    },
    "custom/ws2": {
        "exec": "~/.config/waybar/themes/neobrutalism/ws_button.sh 2",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/themes/neobrutalism/ws_button.sh 2 switch",
        "tooltip": false
    },
    "custom/ws3": {
        "exec": "~/.config/waybar/themes/neobrutalism/ws_button.sh 3",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/themes/neobrutalism/ws_button.sh 3 switch",
        "tooltip": false
    },
    "custom/ws4": {
        "exec": "~/.config/waybar/themes/neobrutalism/ws_button.sh 4",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/themes/neobrutalism/ws_button.sh 4 switch",
        "tooltip": false
    },
    "custom/ws5": {
        "exec": "~/.config/waybar/themes/neobrutalism/ws_button.sh 5",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/themes/neobrutalism/ws_button.sh 5 switch",
        "tooltip": false
    },
    "custom/ws6": {
        "exec": "~/.config/waybar/themes/neobrutalism/ws_button.sh 6",
